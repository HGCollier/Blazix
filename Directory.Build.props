<Project>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Compiler/analyzer warnings, and MSBuild-level ones (MSB*, NETSDK*, <Warning> in targets), which the first doesn't cover. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>

    <!--
      One version for everything we ship. The CLI copies styled components that were written
      against this exact Blazix.Primitives version, and adds that version to the consumer's project.
    -->
    <Version>0.2.3</Version>

    <Authors>Blazix</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://blazix-ui.com</PackageProjectUrl>
    <!-- The docs favicon (docs/Blazix.Docs/wwwroot/favicon.svg) rendered at 128x128: NuGet takes PNG or JPEG, not SVG. -->
    <PackageIcon>icon.png</PackageIcon>
    <RepositoryUrl>https://github.com/HGCollier/Blazix</RepositoryUrl>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts/packages</PackageOutputPath>

    <!-- Projects opt in to packing. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)src/icon.png" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <!-- Static analysis for every project. -->
  <ItemGroup>
    <PackageReference Include="SonarAnalyzer.CSharp" PrivateAssets="all"
                      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

</Project>
