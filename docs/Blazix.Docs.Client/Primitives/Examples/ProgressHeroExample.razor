@implements IDisposable

<ProgressRoot class="grid max-w-full w-60 grid-cols-2 gap-y-2" Value="_value">
    <ProgressLabel class="text-sm font-normal text-neutral-950 dark:text-white">
        Export data
    </ProgressLabel>
    <ProgressValue class="text-right text-sm text-neutral-950 dark:text-white" />
    <ProgressTrack class="col-span-2 h-1 overflow-hidden bg-neutral-200 dark:bg-neutral-800">
        <ProgressIndicator class="bg-neutral-950 transition-[width] duration-500 dark:bg-white" />
    </ProgressTrack>
</ProgressRoot>

@code {
    private Timer? _timer;
    private double _value = 20;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _timer = new Timer(_ => InvokeAsync(Advance), null, 1000, 1000);
        }
    }

    private void Advance()
    {
        _value = Math.Min(100, Math.Round(_value + Random.Shared.NextDouble() * 25));
        StateHasChanged();
    }

    public void Dispose() => _timer?.Dispose();
}
