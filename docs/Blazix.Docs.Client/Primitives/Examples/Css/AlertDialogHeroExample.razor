<AlertDialogRoot>
    <AlertDialogTrigger data-color="red" class="alert-dialog-button">Discard draft</AlertDialogTrigger>
    <AlertDialogPortal>
        <AlertDialogBackdrop class="alert-dialog-backdrop" />
        <AlertDialogPopup class="alert-dialog-popup">
            <div class="alert-dialog-intro">
                <AlertDialogTitle class="alert-dialog-title">Discard draft?</AlertDialogTitle>
                <AlertDialogDescription class="alert-dialog-description">You can’t undo this action.</AlertDialogDescription>
            </div>
            <div class="alert-dialog-actions">
                <AlertDialogClose class="alert-dialog-button">Cancel</AlertDialogClose>
                <AlertDialogClose data-color="red" class="alert-dialog-button">Discard</AlertDialogClose>
            </div>
        </AlertDialogPopup>
    </AlertDialogPortal>
</AlertDialogRoot>
