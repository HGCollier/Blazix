<AccordionRoot HiddenUntilFound="true" class="accordion">
    <AccordionItem class="accordion-item">
        <AccordionHeader class="accordion-header">
            <AccordionTrigger class="accordion-trigger">
                How long does shipping take?
                @PlusIcon
            </AccordionTrigger>
        </AccordionHeader>
        <AccordionPanel class="accordion-panel">
            <div class="accordion-content">
                Standard shipping takes 3–5 business days. Express delivery arrives in 1–2 business days.
            </div>
        </AccordionPanel>
    </AccordionItem>

    <AccordionItem class="accordion-item">
        <AccordionHeader class="accordion-header">
            <AccordionTrigger class="accordion-trigger">
                What is your return policy?
                @PlusIcon
            </AccordionTrigger>
        </AccordionHeader>
        <AccordionPanel class="accordion-panel">
            <div class="accordion-content">
                You can return any item within 30 days of delivery. Opened items may be subject to a 10% restocking fee.
            </div>
        </AccordionPanel>
    </AccordionItem>

    <AccordionItem class="accordion-item">
        <AccordionHeader class="accordion-header">
            <AccordionTrigger class="accordion-trigger">
                Do you ship internationally?
                @PlusIcon
            </AccordionTrigger>
        </AccordionHeader>
        <AccordionPanel class="accordion-panel">
            <div class="accordion-content">
                Yes, we ship to over 40 countries. International orders typically arrive within 7–14 business days.
            </div>
        </AccordionPanel>
    </AccordionItem>

    <AccordionItem class="accordion-item">
        <AccordionHeader class="accordion-header">
            <AccordionTrigger class="accordion-trigger">
                How can I track my order?
                @PlusIcon
            </AccordionTrigger>
        </AccordionHeader>
        <AccordionPanel class="accordion-panel">
            <div class="accordion-content">
                Once your order ships, you’ll receive a tracking link by email. Tracking updates can take up to 24 hours to appear.
            </div>
        </AccordionPanel>
    </AccordionItem>
</AccordionRoot>

@code {
    private static readonly RenderFragment PlusIcon =
        @<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-linecap="square" stroke-linejoin="round"
              class="accordion-icon" style="display: block">
            <path d="M1.5 8h13M8 14.5v-13" />
        </svg>;
}
