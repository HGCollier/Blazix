<div class="use-render-container">
    <UseRender DefaultTagName="p" class="use-render-text">Text component rendered as a paragraph tag</UseRender>
    <UseRender class="use-render-text use-render-strong">
        <Render Context="text">
            <strong @attributes="text.Attributes">Text component rendered as a strong tag</strong>
        </Render>
    </UseRender>
</div>
