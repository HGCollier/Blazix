<CheckboxGroupRoot aria-labelledby="@_id" Value="@(["fuji-apple"])" class="checkbox-group">
    <div class="checkbox-group-caption" id="@_id">
        Apples
    </div>

    <label class="checkbox-group-item">
        <CheckboxRoot Name="apple" Value="fuji-apple" class="checkbox-group-checkbox">
            <CheckboxIndicator class="checkbox-group-indicator">
                @CheckIcon
            </CheckboxIndicator>
        </CheckboxRoot>
        Fuji
    </label>

    <label class="checkbox-group-item">
        <CheckboxRoot Name="apple" Value="gala-apple" class="checkbox-group-checkbox">
            <CheckboxIndicator class="checkbox-group-indicator">
                @CheckIcon
            </CheckboxIndicator>
        </CheckboxRoot>
        Gala
    </label>

    <label class="checkbox-group-item">
        <CheckboxRoot Name="apple" Value="granny-smith-apple" class="checkbox-group-checkbox">
            <CheckboxIndicator class="checkbox-group-indicator">
                @CheckIcon
            </CheckboxIndicator>
        </CheckboxRoot>
        Granny Smith
    </label>
</CheckboxGroupRoot>

@code {
    private static readonly RenderFragment CheckIcon =
        @<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" style="display: block">
            <path d="m2.5 8.5 4 4 7-9" />
        </svg>;

    private readonly string _id = $"apples-{Guid.NewGuid():N}";
}
