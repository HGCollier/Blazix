<FieldRoot class="field">
    <FieldLabel class="field-label">Name</FieldLabel>
    <FieldControl required placeholder="Required" class="field-input" />
    <FieldError class="field-error" Match="ValidityKey.ValueMissing">
        Please enter your name
    </FieldError>

    <FieldDescription class="field-description">
        Visible on your profile
    </FieldDescription>
</FieldRoot>
