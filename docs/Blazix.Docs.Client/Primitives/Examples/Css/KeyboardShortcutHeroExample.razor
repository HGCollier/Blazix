<KeyboardShortcut Key="m" OnPressed="() => _count++" />
<p class="keyboard-shortcut-text">
    Press <kbd class="keyboard-shortcut-key">Ctrl</kbd>+<kbd class="keyboard-shortcut-key">M</kbd> (<kbd class="keyboard-shortcut-key">⌘</kbd><kbd class="keyboard-shortcut-key">M</kbd> on macOS).
    Pressed <strong>@_count</strong> times.
</p>

@code {
    private int _count;
}
