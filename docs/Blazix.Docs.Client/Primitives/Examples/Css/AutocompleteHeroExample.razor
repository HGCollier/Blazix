<AutocompleteRoot Items="Tags">
    <label class="autocomplete-label">
        Search tags
        <AutocompleteInput Placeholder="e.g. feature" class="autocomplete-input" />
    </label>

    <AutocompletePortal>
        <AutocompletePositioner class="autocomplete-positioner" SideOffset="4">
            <AutocompletePopup class="autocomplete-popup">
                <AutocompleteEmpty>
                    <div class="autocomplete-empty">
                        No tags found.
                    </div>
                </AutocompleteEmpty>
                <AutocompleteList class="autocomplete-list">
                    <Template Context="tag">
                        <AutocompleteItem Value="@tag" class="autocomplete-item">
                            @tag
                        </AutocompleteItem>
                    </Template>
                </AutocompleteList>
            </AutocompletePopup>
        </AutocompletePositioner>
    </AutocompletePortal>
</AutocompleteRoot>

