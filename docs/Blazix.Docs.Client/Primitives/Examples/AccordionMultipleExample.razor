<AccordionRoot Multiple="true" class="flex w-full max-w-80 flex-col border border-neutral-950 text-neutral-950 dark:border-white dark:text-white">
    <AccordionItem>
        <AccordionHeader>
            <AccordionTrigger class="group flex w-full items-center justify-between gap-4 bg-transparent px-3 py-2 text-left text-sm font-normal text-neutral-950 select-none hover:not-data-disabled:bg-neutral-100 focus-visible:relative focus-visible:z-1 focus-visible:outline-2 focus-visible:outline-neutral-950 dark:focus-visible:outline-white dark:text-white dark:hover:not-data-disabled:bg-neutral-800">
                What is Blazix.Primitives?
                @PlusIcon
            </AccordionTrigger>
        </AccordionHeader>
        <AccordionPanel class="h-[var(--accordion-panel-height)] overflow-hidden text-sm transition-[height] duration-150 ease-[ease-out] data-ending-style:h-0 data-starting-style:h-0">
            <div class="px-3 py-2">
                Blazix.Primitives is a library of high-quality unstyled Blazor components for design systems and web apps.
            </div>
        </AccordionPanel>
    </AccordionItem>

    <AccordionItem class="border-t border-neutral-950 dark:border-white">
        <AccordionHeader>
            <AccordionTrigger class="group flex w-full items-center justify-between gap-4 bg-transparent px-3 py-2 text-left text-sm font-normal text-neutral-950 select-none hover:not-data-disabled:bg-neutral-100 focus-visible:relative focus-visible:z-1 focus-visible:outline-2 focus-visible:outline-neutral-950 dark:focus-visible:outline-white dark:text-white dark:hover:not-data-disabled:bg-neutral-800">
                How do I get started?
                @PlusIcon
            </AccordionTrigger>
        </AccordionHeader>
        <AccordionPanel class="h-[var(--accordion-panel-height)] overflow-hidden text-sm transition-[height] duration-150 ease-[ease-out] data-ending-style:h-0 data-starting-style:h-0">
            <div class="px-3 py-2">
                Head to the “Primitives” page in the docs. If you’ve used unstyled libraries before, you’ll feel at home.
            </div>
        </AccordionPanel>
    </AccordionItem>

    <AccordionItem class="border-t border-neutral-950 dark:border-white">
        <AccordionHeader>
            <AccordionTrigger class="group flex w-full items-center justify-between gap-4 bg-transparent px-3 py-2 text-left text-sm font-normal text-neutral-950 select-none hover:not-data-disabled:bg-neutral-100 focus-visible:relative focus-visible:z-1 focus-visible:outline-2 focus-visible:outline-neutral-950 dark:focus-visible:outline-white dark:text-white dark:hover:not-data-disabled:bg-neutral-800">
                Can I use it for my project?
                @PlusIcon
            </AccordionTrigger>
        </AccordionHeader>
        <AccordionPanel class="h-[var(--accordion-panel-height)] overflow-hidden text-sm transition-[height] duration-150 ease-[ease-out] data-ending-style:h-0 data-starting-style:h-0">
            <div class="px-3 py-2">Of course! Blazix is free and open source.</div>
        </AccordionPanel>
    </AccordionItem>
</AccordionRoot>

@code {
    private static readonly RenderFragment PlusIcon =
        @<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-linecap="square" stroke-linejoin="round"
              class="block shrink-0 transition-transform duration-100 ease-[ease-out] group-data-panel-open:rotate-45">
            <path d="M1.5 8h13M8 14.5v-13" />
        </svg>;
}
