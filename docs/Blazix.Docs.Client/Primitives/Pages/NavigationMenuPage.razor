@page "/docs/primitives/navigation-menu"

<DocsPage Title="Navigation Menu" Description="A collection of links and menus for website navigation.">
    <ComponentPreview Name="primitives/navigation-menu-hero" />
    <DocsHeading Title="Anatomy" />
    <p>Import the primitives and assemble the parts:</p>
    <CodeFigure Code="@Anatomy" />
    <DocsHeading Title="API Reference" />
    <PartReference Type="typeof(NavigationMenuRoot)" />
    <PartReference Type="typeof(NavigationMenuTrigger)">
        <DataAttributes>
            <StyleHook Name="data-popup-open">Present when the corresponding navigation menu is open.</StyleHook>
            <StyleHook Name="data-pressed">Present when the trigger is pressed.</StyleHook>
            <StyleHook Name="data-disabled">Present when the trigger is disabled.</StyleHook>
        </DataAttributes>
    </PartReference>
    <PartReference Type="typeof(NavigationMenuIcon)">
        <DataAttributes>
            <StyleHook Name="data-popup-open">Present when the navigation menu is open and the item is active.</StyleHook>
        </DataAttributes>
    </PartReference>
    <PartReference Type="typeof(NavigationMenuList)" />
    <PartReference Type="typeof(NavigationMenuPortal)" />
    <PartReference Type="typeof(NavigationMenuBackdrop)">
        <DataAttributes>
            <StyleHook Name="data-open">Present when the popup is open.</StyleHook>
            <StyleHook Name="data-closed">Present when the popup is closed.</StyleHook>
            <StyleHook Name="data-starting-style">Present when the popup begins animating in.</StyleHook>
            <StyleHook Name="data-ending-style">Present when the popup is animating out.</StyleHook>
        </DataAttributes>
    </PartReference>
    <PartReference Type="typeof(NavigationMenuPositioner)">
        <DataAttributes>
            <StyleHook Name="data-open">Present when the popup is open.</StyleHook>
            <StyleHook Name="data-closed">Present when the popup is closed.</StyleHook>
            <StyleHook Name="data-anchor-hidden">Present when the anchor is hidden.</StyleHook>
            <StyleHook Name="data-align" Type="'start' | 'center' | 'end'">Indicates how the popup is aligned relative to the specified side.</StyleHook>
            <StyleHook Name="data-instant">Present if animations should be instant.</StyleHook>
            <StyleHook Name="data-side" Type="'top' | 'bottom' | 'left' | 'right' | 'inline-end' | 'inline-start'">Indicates which side the popup is positioned relative to the trigger.</StyleHook>
        </DataAttributes>
        <CssVariables>
            <StyleHook Name="--anchor-height" Type="number">The anchor's height.</StyleHook>
            <StyleHook Name="--anchor-width" Type="number">The anchor's width.</StyleHook>
            <StyleHook Name="--available-height" Type="number">The available height between the trigger and the edge of the viewport.</StyleHook>
            <StyleHook Name="--available-width" Type="number">The available width between the trigger and the edge of the viewport.</StyleHook>
            <StyleHook Name="--positioner-height" Type="number">The fixed height of the positioner element.</StyleHook>
            <StyleHook Name="--positioner-width" Type="number">The fixed width of the positioner element.</StyleHook>
            <StyleHook Name="--transform-origin" Type="string">The coordinates that this element is anchored to. Used for animations and transitions.</StyleHook>
        </CssVariables>
    </PartReference>
    <PartReference Type="typeof(NavigationMenuPopup)">
        <DataAttributes>
            <StyleHook Name="data-open">Present when the popup is open.</StyleHook>
            <StyleHook Name="data-closed">Present when the popup is closed.</StyleHook>
            <StyleHook Name="data-anchor-hidden">Present when the anchor is hidden.</StyleHook>
            <StyleHook Name="data-align" Type="'start' | 'center' | 'end'">Indicates how the popup is aligned relative to the specified side.</StyleHook>
            <StyleHook Name="data-side" Type="'top' | 'bottom' | 'left' | 'right' | 'inline-end' | 'inline-start'">Indicates which side the popup is positioned relative to the trigger.</StyleHook>
            <StyleHook Name="data-starting-style">Present when the popup begins animating in.</StyleHook>
            <StyleHook Name="data-ending-style">Present when the popup is animating out.</StyleHook>
        </DataAttributes>
        <CssVariables>
            <StyleHook Name="--popup-height" Type="number">The fixed height of the popup element.</StyleHook>
            <StyleHook Name="--popup-width" Type="number">The fixed width of the popup element.</StyleHook>
        </CssVariables>
    </PartReference>
    <PartReference Type="typeof(NavigationMenuArrow)">
        <DataAttributes>
            <StyleHook Name="data-open">Present when the popup is open.</StyleHook>
            <StyleHook Name="data-closed">Present when the popup is closed.</StyleHook>
            <StyleHook Name="data-uncentered">Present when the popup arrow is uncentered.</StyleHook>
            <StyleHook Name="data-align" Type="'start' | 'center' | 'end'">Indicates how the popup is aligned relative to specified side.</StyleHook>
            <StyleHook Name="data-side" Type="'top' | 'bottom' | 'left' | 'right' | 'inline-end' | 'inline-start'">Indicates which side the popup is positioned relative to the trigger.</StyleHook>
        </DataAttributes>
    </PartReference>
    <PartReference Type="typeof(NavigationMenuItem)" />
    <PartReference Type="typeof(NavigationMenuContent)">
        <DataAttributes>
            <StyleHook Name="data-open">Present when the popup is open.</StyleHook>
            <StyleHook Name="data-closed">Present when the popup is closed.</StyleHook>
            <StyleHook Name="data-activation-direction" Type="'left' | 'right' | 'up' | 'down'">Which direction another trigger was activated from.</StyleHook>
            <StyleHook Name="data-starting-style">Present when the content begins animating in.</StyleHook>
            <StyleHook Name="data-ending-style">Present when the content is animating out.</StyleHook>
        </DataAttributes>
    </PartReference>
    <PartReference Type="typeof(NavigationMenuViewport)" />
    <PartReference Type="typeof(NavigationMenuLink)">
        <DataAttributes>
            <StyleHook Name="data-active">Present when the link is the currently active page.</StyleHook>
        </DataAttributes>
    </PartReference>
</DocsPage>

@code {
    private const string Anatomy = """
        @using Blazix.Primitives

        <NavigationMenuRoot>
            <NavigationMenuList>
                <NavigationMenuItem>
                    <NavigationMenuTrigger>
                        <NavigationMenuIcon />
                    </NavigationMenuTrigger>
                    <NavigationMenuContent>
                        <NavigationMenuLink />
                    </NavigationMenuContent>
                </NavigationMenuItem>
            </NavigationMenuList>

            <NavigationMenuPortal>
                <NavigationMenuBackdrop />
                <NavigationMenuPositioner>
                    <NavigationMenuPopup>
                        <NavigationMenuArrow />
                        <NavigationMenuViewport />
                    </NavigationMenuPopup>
                </NavigationMenuPositioner>
            </NavigationMenuPortal>
        </NavigationMenuRoot>
        """;
}
