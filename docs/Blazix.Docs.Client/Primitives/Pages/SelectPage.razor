            <StyleHook Name="data-direction" Type="'down'">Indicates the direction of the scroll arrow.</StyleHook>
            <StyleHook Name="data-side" Type="'none' | 'top' | 'bottom' | 'left' | 'right' | 'inline-end' | 'inline-start'">Indicates which side the popup is positioned relative to the trigger.</StyleHook>
            <StyleHook Name="data-visible">Present when the scroll arrow is visible.</StyleHook>
