@page "/docs/primitives/scroll-area"

<DocsPage Title="Scroll Area" Description="A native scroll container with custom scrollbars.">
    <ComponentPreview Name="primitives/scroll-area-hero" />
    <DocsHeading Title="Anatomy" />
    <p>Import the primitives and assemble the parts:</p>
    <CodeFigure Code="@Anatomy" />
    <DocsHeading Title="API Reference" />
    <PartReference Type="typeof(ScrollAreaRoot)">
        <DataAttributes>
            <StyleHook Name="data-has-overflow-x">Present when the scroll area content is wider than the viewport.</StyleHook>
            <StyleHook Name="data-has-overflow-y">Present when the scroll area content is taller than the viewport.</StyleHook>
            <StyleHook Name="data-overflow-x-end">Present when there is overflow on the horizontal end side.</StyleHook>
            <StyleHook Name="data-overflow-x-start">Present when there is overflow on the horizontal start side.</StyleHook>
            <StyleHook Name="data-overflow-y-end">Present when there is overflow on the vertical end side.</StyleHook>
            <StyleHook Name="data-overflow-y-start">Present when there is overflow on the vertical start side.</StyleHook>
            <StyleHook Name="data-scrolling">Present when the user scrolls inside the scroll area.</StyleHook>
        </DataAttributes>
        <CssVariables>
            <StyleHook Name="--scroll-area-corner-height" Type="number">The scroll area's corner height.</StyleHook>
            <StyleHook Name="--scroll-area-corner-width" Type="number">The scroll area's corner width.</StyleHook>
        </CssVariables>
    </PartReference>
    <PartReference Type="typeof(ScrollAreaContent)">
        <DataAttributes>
            <StyleHook Name="data-has-overflow-x">Present when the scroll area content is wider than the viewport.</StyleHook>
            <StyleHook Name="data-has-overflow-y">Present when the scroll area content is taller than the viewport.</StyleHook>
            <StyleHook Name="data-overflow-x-end">Present when there is overflow on the horizontal end side.</StyleHook>
            <StyleHook Name="data-overflow-x-start">Present when there is overflow on the horizontal start side.</StyleHook>
            <StyleHook Name="data-overflow-y-end">Present when there is overflow on the vertical end side.</StyleHook>
            <StyleHook Name="data-overflow-y-start">Present when there is overflow on the vertical start side.</StyleHook>
            <StyleHook Name="data-scrolling">Present when the user scrolls inside the scroll area.</StyleHook>
        </DataAttributes>
    </PartReference>
    <PartReference Type="typeof(ScrollAreaViewport)">
        <DataAttributes>
            <StyleHook Name="data-has-overflow-x">Present when the scroll area content is wider than the viewport.</StyleHook>
            <StyleHook Name="data-has-overflow-y">Present when the scroll area content is taller than the viewport.</StyleHook>
            <StyleHook Name="data-overflow-x-end">Present when there is overflow on the horizontal end side.</StyleHook>
            <StyleHook Name="data-overflow-x-start">Present when there is overflow on the horizontal start side.</StyleHook>
            <StyleHook Name="data-overflow-y-end">Present when there is overflow on the vertical end side.</StyleHook>
            <StyleHook Name="data-overflow-y-start">Present when there is overflow on the vertical start side.</StyleHook>
            <StyleHook Name="data-scrolling">Present when the user scrolls inside the scroll area.</StyleHook>
        </DataAttributes>
        <CssVariables>
            <StyleHook Name="--scroll-area-overflow-x-end" Type="number">The distance from the horizontal end edge in pixels.</StyleHook>
            <StyleHook Name="--scroll-area-overflow-x-start" Type="number">The distance from the horizontal start edge in pixels.</StyleHook>
            <StyleHook Name="--scroll-area-overflow-y-end" Type="number">The distance from the vertical end edge in pixels.</StyleHook>
            <StyleHook Name="--scroll-area-overflow-y-start" Type="number">The distance from the vertical start edge in pixels.</StyleHook>
        </CssVariables>
    </PartReference>
    <PartReference Type="typeof(ScrollAreaThumb)">
        <DataAttributes>
            <StyleHook Name="data-orientation" Type="'horizontal' | 'vertical'">Indicates the orientation of the scrollbar.</StyleHook>
            <StyleHook Name="data-scrolling">Present when the user scrolls inside the scroll area.</StyleHook>
        </DataAttributes>
    </PartReference>
    <PartReference Type="typeof(ScrollAreaScrollbar)">
        <DataAttributes>
            <StyleHook Name="data-orientation" Type="'horizontal' | 'vertical'">Indicates the orientation of the scrollbar.</StyleHook>
            <StyleHook Name="data-has-overflow-x">Present when the scroll area content is wider than the viewport.</StyleHook>
            <StyleHook Name="data-has-overflow-y">Present when the scroll area content is taller than the viewport.</StyleHook>
            <StyleHook Name="data-hovering">Present when the pointer is over the scroll area.</StyleHook>
            <StyleHook Name="data-overflow-x-end">Present when there is overflow on the horizontal end side.</StyleHook>
            <StyleHook Name="data-overflow-x-start">Present when there is overflow on the horizontal start side.</StyleHook>
            <StyleHook Name="data-overflow-y-end">Present when there is overflow on the vertical end side.</StyleHook>
            <StyleHook Name="data-overflow-y-start">Present when there is overflow on the vertical start side.</StyleHook>
            <StyleHook Name="data-scrolling">Present when the user scrolls inside the scroll area.</StyleHook>
        </DataAttributes>
        <CssVariables>
            <StyleHook Name="--scroll-area-thumb-height" Type="number">The scroll area thumb's height.</StyleHook>
            <StyleHook Name="--scroll-area-thumb-width" Type="number">The scroll area thumb's width.</StyleHook>
        </CssVariables>
    </PartReference>
    <PartReference Type="typeof(ScrollAreaCorner)" />
</DocsPage>

@code {
    private const string Anatomy = """
        @using Blazix.Primitives

        <ScrollAreaRoot>
            <ScrollAreaViewport>
                <ScrollAreaContent />
            </ScrollAreaViewport>
            <ScrollAreaScrollbar>
                <ScrollAreaThumb />
            </ScrollAreaScrollbar>
            <ScrollAreaCorner />
        </ScrollAreaRoot>
        """;
}
