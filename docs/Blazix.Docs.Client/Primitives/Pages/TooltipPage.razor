@page "/docs/primitives/tooltip"

<DocsPage Title="Tooltip" Description="A popup that appears when an element is hovered or focused, showing a hint for sighted users.">
    <ComponentPreview Name="primitives/tooltip-hero" />
    <DocsHeading Title="Usage guidelines" />
    <ul>
        <li><strong>Prefer using tooltips as visual labels only:</strong> Tooltips are supplementary visual labels for sighted mouse and keyboard users. On their own they aren't accessible to touch or screen reader users.</li>
        <li><strong>Provide an accessible name for the trigger:</strong> A tooltip doesn't label its trigger. Give the trigger an <code>aria-label</code> that closely matches the tooltip's content, so screen reader users get the same information.</li>
    </ul>
    <DocsHeading Title="Anatomy" />
    <p>Import the primitives and assemble the parts:</p>
    <CodeFigure Code="@Anatomy" />
    <DocsHeading Title="API Reference" />
    <PartReference Type="typeof(TooltipRoot)" />
    <PartReference Type="typeof(TooltipProvider)" />
    <PartReference Type="typeof(TooltipTrigger)">
        <DataAttributes>
            <StyleHook Name="data-popup-open">Present when the corresponding tooltip is open.</StyleHook>
            <StyleHook Name="data-trigger-disabled">Present when the trigger is disabled, either by the <code>disabled</code> prop or by a parent <code>&lt;TooltipRoot&gt;</code> component.</StyleHook>
        </DataAttributes>
    </PartReference>
    <PartReference Type="typeof(TooltipPortal)" />
    <PartReference Type="typeof(TooltipPositioner)">
        <DataAttributes>
            <StyleHook Name="data-open">Present when the tooltip is open.</StyleHook>
            <StyleHook Name="data-closed">Present when the tooltip is closed.</StyleHook>
            <StyleHook Name="data-anchor-hidden">Present when the anchor is hidden.</StyleHook>
            <StyleHook Name="data-align" Type="'start' | 'center' | 'end'">Indicates how the popup is aligned relative to specified side.</StyleHook>
            <StyleHook Name="data-side" Type="'top' | 'bottom' | 'left' | 'right' | 'inline-end' | 'inline-start'">Indicates which side the popup is positioned relative to the trigger.</StyleHook>
        </DataAttributes>
        <CssVariables>
            <StyleHook Name="--anchor-height" Type="number">The anchor's height.</StyleHook>
            <StyleHook Name="--anchor-width" Type="number">The anchor's width.</StyleHook>
            <StyleHook Name="--available-height" Type="number">The available height between the trigger and the edge of the viewport.</StyleHook>
            <StyleHook Name="--available-width" Type="number">The available width between the trigger and the edge of the viewport.</StyleHook>
            <StyleHook Name="--positioner-height" Type="number">The height of the tooltip's positioner. It is important to set <code>height</code> to this value when using CSS to animate size changes.</StyleHook>
            <StyleHook Name="--positioner-width" Type="number">The width of the tooltip's positioner. It is important to set <code>width</code> to this value when using CSS to animate size changes.</StyleHook>
            <StyleHook Name="--transform-origin" Type="string">The coordinates that this element is anchored to. Used for animations and transitions.</StyleHook>
        </CssVariables>
    </PartReference>
    <PartReference Type="typeof(TooltipPopup)">
        <DataAttributes>
            <StyleHook Name="data-open">Present when the tooltip is open.</StyleHook>
            <StyleHook Name="data-closed">Present when the tooltip is closed.</StyleHook>
            <StyleHook Name="data-align" Type="'start' | 'center' | 'end'">Indicates how the popup is aligned relative to specified side.</StyleHook>
            <StyleHook Name="data-instant" Type="'delay' | 'dismiss' | 'focus'">Present if animations should be instant.</StyleHook>
            <StyleHook Name="data-side" Type="'top' | 'bottom' | 'left' | 'right' | 'inline-end' | 'inline-start'">Indicates which side the popup is positioned relative to the trigger.</StyleHook>
            <StyleHook Name="data-starting-style">Present when the tooltip begins animating in.</StyleHook>
            <StyleHook Name="data-ending-style">Present when the tooltip is animating out.</StyleHook>
        </DataAttributes>
    </PartReference>
    <PartReference Type="typeof(TooltipArrow)">
        <DataAttributes>
            <StyleHook Name="data-open">Present when the tooltip is open.</StyleHook>
            <StyleHook Name="data-closed">Present when the tooltip is closed.</StyleHook>
            <StyleHook Name="data-uncentered">Present when the tooltip arrow is uncentered.</StyleHook>
            <StyleHook Name="data-align" Type="'start' | 'center' | 'end'">Indicates how the popup is aligned relative to specified side.</StyleHook>
            <StyleHook Name="data-instant" Type="'delay' | 'dismiss' | 'focus'">Present if animations should be instant.</StyleHook>
            <StyleHook Name="data-side" Type="'top' | 'bottom' | 'left' | 'right' | 'inline-end' | 'inline-start'">Indicates which side the popup is positioned relative to the trigger.</StyleHook>
        </DataAttributes>
    </PartReference>
    <PartReference Type="typeof(TooltipViewport)">
        <DataAttributes>
            <StyleHook Name="data-activation-direction" Type="`${'left' | 'right' | ''} ${'down' | 'up' | ''}`">Indicates the direction from which the popup was activated. This can be used to create directional animations based on how the popup was triggered. Contains space-separated values for both horizontal and vertical axes.</StyleHook>
            <StyleHook Name="data-current">Applied to the direct child of the viewport when no transitions are present or the new content when it's entering.</StyleHook>
            <StyleHook Name="data-instant" Type="'delay' | 'dismiss' | 'focus'">Present if animations should be instant.</StyleHook>
            <StyleHook Name="data-previous">Applied to the direct child of the viewport that contains the exiting content when transitions are present.</StyleHook>
            <StyleHook Name="data-transitioning">Indicates that the viewport is currently transitioning between old and new content.</StyleHook>
        </DataAttributes>
        <CssVariables>
            <StyleHook Name="--popup-height" Type="\`\`">The height of the parent popup. This variable is placed on the 'previous' container and stores the height of the popup when the previous content was rendered. It can be used to freeze the dimensions of the popup when animating between different content.</StyleHook>
            <StyleHook Name="--popup-width" Type="\`\`">The width of the parent popup. This variable is placed on the 'previous' container and stores the width of the popup when the previous content was rendered. It can be used to freeze the dimensions of the popup when animating between different content.</StyleHook>
        </CssVariables>
    </PartReference>
    <PartReference Type="typeof(TooltipHandle)" />
</DocsPage>

@code {
    private const string Anatomy = """
        @using Blazix.Primitives

        <TooltipProvider>
            <TooltipRoot>
                <TooltipTrigger />
                <TooltipPortal>
                    <TooltipPositioner>
                        <TooltipPopup>
                            <TooltipArrow />
                            <TooltipViewport />
                        </TooltipPopup>
                    </TooltipPositioner>
                </TooltipPortal>
            </TooltipRoot>
        </TooltipProvider>
        """;
}
