@page "/docs/primitives/toast"

<DocsPage Title="Toast" Description="Generates toast notifications.">
    <ComponentPreview Name="primitives/toast-hero" />
    <DocsHeading Title="Anatomy" />
    <p>Import the primitives and assemble the parts. The viewport holds stacked toasts, each a <code>ToastRoot</code>, and anchored toasts, each a <code>ToastRoot</code> in a <code>ToastPositioner</code>:</p>
    <CodeFigure Code="@Anatomy" />
    <DocsHeading Title="API Reference" />
    <PartReference Type="typeof(ToastRoot)">
        <DataAttributes>
            <StyleHook Name="data-expanded" Type="boolean">Present when the toast is expanded in the viewport.</StyleHook>
            <StyleHook Name="data-limited" Type="boolean">Present when the toast was limited because the toast limit was exceeded.</StyleHook>
            <StyleHook Name="data-swipe-direction" Type="'up' | 'down' | 'left' | 'right'">The direction the toast was swiped.</StyleHook>
            <StyleHook Name="data-swiping" Type="boolean">Present when the toast is being swiped.</StyleHook>
            <StyleHook Name="data-type" Type="string">The type of the toast.</StyleHook>
            <StyleHook Name="data-starting-style">Present when the toast begins animating in.</StyleHook>
            <StyleHook Name="data-ending-style">Present when the toast is animating out.</StyleHook>
        </DataAttributes>
        <CssVariables>
            <StyleHook Name="--toast-height" Type="number">Indicates the measured natural height of the toast in pixels.</StyleHook>
            <StyleHook Name="--toast-index" Type="number">Indicates the index of the toast in the list.</StyleHook>
            <StyleHook Name="--toast-offset-y" Type="number">Indicates the vertical pixels offset of the toast in the list when expanded.</StyleHook>
            <StyleHook Name="--toast-swipe-movement-x" Type="number">Indicates the horizontal swipe movement of the toast.</StyleHook>
            <StyleHook Name="--toast-swipe-movement-y" Type="number">Indicates the vertical swipe movement of the toast.</StyleHook>
        </CssVariables>
    </PartReference>
    <PartReference Type="typeof(ToastProvider)" />
    <PartReference Type="typeof(ToastPortal)" />
    <PartReference Type="typeof(ToastPositioner)">
        <DataAttributes>
            <StyleHook Name="data-anchor-hidden">Present when the anchor is hidden.</StyleHook>
            <StyleHook Name="data-align" Type="'start' | 'center' | 'end'">Indicates how the toast is aligned relative to specified side.</StyleHook>
            <StyleHook Name="data-side" Type="'top' | 'bottom' | 'left' | 'right' | 'inline-end' | 'inline-start'">Indicates which side the toast is positioned relative to the trigger.</StyleHook>
        </DataAttributes>
        <CssVariables>
            <StyleHook Name="--anchor-height" Type="number">The anchor's height.</StyleHook>
            <StyleHook Name="--anchor-width" Type="number">The anchor's width.</StyleHook>
            <StyleHook Name="--available-height" Type="number">The available height between the anchor and the edge of the viewport.</StyleHook>
            <StyleHook Name="--available-width" Type="number">The available width between the anchor and the edge of the viewport.</StyleHook>
            <StyleHook Name="--transform-origin" Type="string">The coordinates that this element is anchored to. Used for animations and transitions.</StyleHook>
        </CssVariables>
    </PartReference>
    <PartReference Type="typeof(ToastArrow)">
        <DataAttributes>
            <StyleHook Name="data-uncentered">Present when the toast arrow is uncentered.</StyleHook>
            <StyleHook Name="data-align" Type="'start' | 'center' | 'end'">Indicates how the toast is aligned relative to specified side.</StyleHook>
            <StyleHook Name="data-side" Type="'top' | 'bottom' | 'left' | 'right' | 'inline-end' | 'inline-start'">Indicates which side the toast is positioned relative to the anchor.</StyleHook>
        </DataAttributes>
    </PartReference>
    <PartReference Type="typeof(ToastContent)">
        <DataAttributes>
            <StyleHook Name="data-behind" Type="boolean">Present when the toast is behind the frontmost toast in the stack.</StyleHook>
            <StyleHook Name="data-expanded" Type="boolean">Present when the toast viewport is expanded.</StyleHook>
        </DataAttributes>
    </PartReference>
    <PartReference Type="typeof(ToastTitle)">
        <DataAttributes>
            <StyleHook Name="data-type" Type="string">The type of the toast.</StyleHook>
        </DataAttributes>
    </PartReference>
    <PartReference Type="typeof(ToastDescription)">
        <DataAttributes>
            <StyleHook Name="data-type" Type="string">The type of the toast.</StyleHook>
        </DataAttributes>
    </PartReference>
    <PartReference Type="typeof(ToastClose)">
        <DataAttributes>
            <StyleHook Name="data-type" Type="string">The type of the toast.</StyleHook>
        </DataAttributes>
    </PartReference>
    <PartReference Type="typeof(ToastAction)">
        <DataAttributes>
            <StyleHook Name="data-type" Type="string">The type of the toast.</StyleHook>
        </DataAttributes>
    </PartReference>
    <PartReference Type="typeof(ToastViewport)">
        <DataAttributes>
            <StyleHook Name="data-expanded" Type="boolean">Indicates toasts are expanded in the viewport.</StyleHook>
        </DataAttributes>
        <CssVariables>
            <StyleHook Name="--toast-frontmost-height" Type="number">Indicates the height of the frontmost toast.</StyleHook>
        </CssVariables>
    </PartReference>
</DocsPage>

@code {
    private const string Anatomy = """
        @using Blazix.Primitives

        <ToastProvider>
            <ToastPortal>
                <ToastViewport>
                    <ToastRoot>
                        <ToastContent>
                            <ToastTitle />
                            <ToastDescription />
                            <ToastAction />
                            <ToastClose />
                        </ToastContent>
                    </ToastRoot>

                    <ToastPositioner>
                        <ToastRoot>
                            <ToastArrow />
                            <ToastContent>
                                <ToastTitle />
                                <ToastDescription />
                                <ToastAction />
                                <ToastClose />
                            </ToastContent>
                        </ToastRoot>
                    </ToastPositioner>
                </ToastViewport>
            </ToastPortal>
        </ToastProvider>
        """;
}
