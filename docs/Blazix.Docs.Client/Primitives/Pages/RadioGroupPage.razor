@page "/docs/primitives/radio-group"

<DocsPage Title="Radio Group" Description="Provides shared state to a series of radio buttons.">
    <ComponentPreview Name="primitives/radio-group-hero" />
    <DocsHeading Title="Usage guidelines" />
    <ul>
        <li>
            <strong>Form controls must have an accessible name:</strong> give them one with <code>&lt;label&gt;</code>
            elements, or the <a href="/docs/primitives/field">Field</a> and <a href="/docs/primitives/fieldset">Fieldset</a>
            parts. See <a href="#labeling-a-radio-group">Labeling a radio group</a>.
        </li>
    </ul>
    <DocsHeading Title="Anatomy" />
    <p>Import the primitives and assemble the parts:</p>
    <CodeFigure Code="@Anatomy" />
    <DocsHeading Title="Examples" />
    <DocsHeading Level="3" Title="Labeling a radio group" />
    <p>Label the group with <code>aria-labelledby</code> and a sibling label element:</p>
    <CodeFigure Code="@GroupLabelCode" Title="Using aria-labelledby to label a radio group" />
    <p>An enclosing <code>&lt;label&gt;</code> is the simplest labeling pattern for each radio:</p>
    <CodeFigure Code="@ItemLabelCode" Title="Using an enclosing label to label a radio button" />
    <p>
        <code>RadioRoot</code> renders a <code>&lt;span&gt;</code> with a hidden native <code>&lt;input&gt;</code> beside it.
        To label a radio with a sibling <code>&lt;label&gt;</code>, point the label's <code>for</code> at the hidden input's
        id, set with <code>InputId</code>:
    </p>
    <CodeFigure Code="@SiblingLabelCode" Title="Sibling label" />
    <DocsHeading Title="API Reference" />
    <PartReference Type="typeof(RadioGroupRoot)">
        <DataAttributes>
            <StyleHook Name="data-disabled">Present when the radio group is disabled.</StyleHook>
        </DataAttributes>
    </PartReference>
    <PartReference Type="typeof(RadioRoot)">
        <DataAttributes>
            <StyleHook Name="data-checked">Present when the radio is checked.</StyleHook>
            <StyleHook Name="data-unchecked">Present when the radio is not checked.</StyleHook>
            <StyleHook Name="data-disabled">Present when the radio is disabled.</StyleHook>
            <StyleHook Name="data-readonly">Present when the radio is readonly.</StyleHook>
            <StyleHook Name="data-required">Present when the radio is required.</StyleHook>
            <StyleHook Name="data-valid">Present when the radio is in a valid state (when wrapped in FieldRoot).</StyleHook>
            <StyleHook Name="data-invalid">Present when the radio is in an invalid state (when wrapped in FieldRoot).</StyleHook>
            <StyleHook Name="data-dirty">Present when the radio's value has changed (when wrapped in FieldRoot).</StyleHook>
            <StyleHook Name="data-touched">Present when the radio has been touched (when wrapped in FieldRoot).</StyleHook>
            <StyleHook Name="data-filled">Present when the radio is checked (when wrapped in FieldRoot).</StyleHook>
            <StyleHook Name="data-focused">Present when the radio is focused (when wrapped in FieldRoot).</StyleHook>
        </DataAttributes>
    </PartReference>
    <PartReference Type="typeof(RadioIndicator)">
        <DataAttributes>
            <StyleHook Name="data-checked">Present when the radio is checked.</StyleHook>
            <StyleHook Name="data-unchecked">Present when the radio is not checked.</StyleHook>
            <StyleHook Name="data-disabled">Present when the radio is disabled.</StyleHook>
            <StyleHook Name="data-readonly">Present when the radio is readonly.</StyleHook>
            <StyleHook Name="data-required">Present when the radio is required.</StyleHook>
            <StyleHook Name="data-valid">Present when the radio is in a valid state (when wrapped in FieldRoot).</StyleHook>
            <StyleHook Name="data-invalid">Present when the radio is in an invalid state (when wrapped in FieldRoot).</StyleHook>
            <StyleHook Name="data-dirty">Present when the radio's value has changed (when wrapped in FieldRoot).</StyleHook>
            <StyleHook Name="data-touched">Present when the radio has been touched (when wrapped in FieldRoot).</StyleHook>
            <StyleHook Name="data-filled">Present when the radio is checked (when wrapped in FieldRoot).</StyleHook>
            <StyleHook Name="data-focused">Present when the radio is focused (when wrapped in FieldRoot).</StyleHook>
            <StyleHook Name="data-starting-style">Present when the radio indicator begins animating in.</StyleHook>
            <StyleHook Name="data-ending-style">Present when the radio indicator is animating out.</StyleHook>
        </DataAttributes>
    </PartReference>
</DocsPage>

@code {
    private const string Anatomy = """
        @using Blazix.Primitives

        <RadioGroupRoot>
            <RadioRoot>
                <RadioIndicator />
            </RadioRoot>
        </RadioGroupRoot>
        """;

    private const string GroupLabelCode = """
        <div id="storage-type-label">Storage type</div>
        <RadioGroupRoot aria-labelledby="storage-type-label">...</RadioGroupRoot>
        """;

    private const string ItemLabelCode = """
        <label>
            <RadioRoot Value="ssd" />
            SSD
        </label>
        """;

    private const string SiblingLabelCode = """
        <div id="storage-type">Storage type</div>
        <RadioGroupRoot Value="ssd" aria-labelledby="storage-type">
            <div>
                <label for="storage-type-ssd">SSD</label>
                <RadioRoot Value="ssd" InputId="storage-type-ssd">
                    <RadioIndicator />
                </RadioRoot>
            </div>
        </RadioGroupRoot>
        """;
}
