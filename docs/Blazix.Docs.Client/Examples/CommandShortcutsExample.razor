<div class="flex flex-col gap-4">
    <Button Variant="ButtonVariant.Outline" Class="w-fit" @onclick="() => _open = true">Open Menu</Button>
    <CommandDialog @bind-Open="_open">
        <Command>
            <CommandInput placeholder="Type a command or search..." />
            <CommandList>
                <CommandEmpty>No results found.</CommandEmpty>
                <CommandGroup Heading="Settings">
                    <CommandItem>
                        <Icon Name="user" />
                        <span>Profile</span>
                        <CommandShortcut>⌘P</CommandShortcut>
                    </CommandItem>
                    <CommandItem>
                        <Icon Name="credit-card" />
                        <span>Billing</span>
                        <CommandShortcut>⌘B</CommandShortcut>
                    </CommandItem>
                    <CommandItem>
                        <Icon Name="settings" />
                        <span>Settings</span>
                        <CommandShortcut>⌘S</CommandShortcut>
                    </CommandItem>
                </CommandGroup>
            </CommandList>
        </Command>
    </CommandDialog>
</div>

@code {
    private bool _open;
}