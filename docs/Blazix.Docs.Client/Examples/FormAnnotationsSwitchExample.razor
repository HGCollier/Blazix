@using System.ComponentModel.DataAnnotations
@using System.Linq.Expressions
@using System.Text.Json
@inject ToastManager Toasts

<Card Class="w-full sm:max-w-md">
    <CardHeader>
        <CardTitle>Security Settings</CardTitle>
        <CardDescription>Manage your account security preferences.</CardDescription>
    </CardHeader>
    <CardContent>
        <EditForm @key="_editContext" id="form-annotations-switch" EditContext="_editContext" OnSubmit="Submit">
            <DataAnnotationsValidator />
            <FieldGroup>
                <Field Orientation="FieldOrientation.Horizontal" data-invalid="@Invalid(() => _model.TwoFactor)">
                    <FieldContent>
                        <FieldLabel for="form-annotations-switch-twoFactor">Multi-factor authentication</FieldLabel>
                        <FieldDescription>Enable multi-factor authentication to secure your account.</FieldDescription>
                        <FieldError Errors="@Errors(() => _model.TwoFactor)" />
                    </FieldContent>
                    <Switch id="form-annotations-switch-twoFactor" Name="twoFactor" Checked="@_model.TwoFactor"
                            CheckedChanged="@(value => Change(() => _model.TwoFactor = value))" aria-invalid="@Invalid(() => _model.TwoFactor)" />
                </Field>
            </FieldGroup>
        </EditForm>
    </CardContent>
    <CardFooter>
        <Field Orientation="FieldOrientation.Horizontal">
            <Button Type="ButtonType.button" Variant="ButtonVariant.Outline" @onclick="Reset">Reset</Button>
            <Button Type="ButtonType.submit" form="form-annotations-switch">Save</Button>
        </Field>
    </CardFooter>
</Card>

@code {
    private static readonly JsonSerializerOptions Json = new(JsonSerializerDefaults.Web);

    private SecuritySettings _model = new();
    private EditContext _editContext = null!;
    private bool _submitted;

    protected override void OnInitialized() => _editContext = new EditContext(_model);

    private void Submit()
    {
        _submitted = true;
        if (_editContext.Validate())
        {
            Toasts.Add(new ToastOptions { Title = "You submitted the following values:", Description = JsonSerializer.Serialize(_model, Json) });
        }
    }

    private void Change(Action update)
    {
        update();
        if (_submitted)
        {
            _editContext.Validate();
        }
    }

    private void Reset()
    {
        _model = new SecuritySettings();
        _editContext = new EditContext(_model);
        _submitted = false;
    }

    private IEnumerable<string> Errors(Expression<Func<object>> field) => _editContext.GetValidationMessages(field).Take(1);

    private string Invalid(Expression<Func<object>> field) => Errors(field).Any() ? "true" : "false";

    private sealed class SecuritySettings
    {
        [Range(typeof(bool), "true", "true", ErrorMessage = "It is highly recommended to enable two-factor authentication.")]
        public bool TwoFactor { get; set; }
    }
}
