<Breadcrumb>
    <BreadcrumbList>
        <BreadcrumbItem>
            <BreadcrumbLink>
                <Render>
                    <a @attributes="context.Attributes" href="/">Home</a>
                </Render>
            </BreadcrumbLink>
        </BreadcrumbItem>
        <BreadcrumbSeparator><Icon Data="LucideIcons.Dot" /></BreadcrumbSeparator>
        <BreadcrumbItem>
            <DropdownMenu>
                <DropdownMenuTrigger>
                    <Render>
                        <button @attributes="context.Attributes" class="flex items-center gap-1">
                            Components
                            <Icon Data="LucideIcons.ChevronDown" data-icon="inline-end" class="size-3.5" />
                        </button>
                    </Render>
                </DropdownMenuTrigger>
                <DropdownMenuContent Align="Align.Start">
                    <DropdownMenuGroup>
                        <DropdownMenuItem>Documentation</DropdownMenuItem>
                        <DropdownMenuItem>Themes</DropdownMenuItem>
                        <DropdownMenuItem>GitHub</DropdownMenuItem>
                    </DropdownMenuGroup>
                </DropdownMenuContent>
            </DropdownMenu>
        </BreadcrumbItem>
        <BreadcrumbSeparator><Icon Data="LucideIcons.Dot" /></BreadcrumbSeparator>
        <BreadcrumbItem><BreadcrumbPage>Breadcrumb</BreadcrumbPage></BreadcrumbItem>
    </BreadcrumbList>
</Breadcrumb>
