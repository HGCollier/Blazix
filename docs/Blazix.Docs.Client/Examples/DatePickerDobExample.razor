@using System.Globalization
<Field Class="mx-auto w-44">
    <FieldLabel for="date">Date of birth</FieldLabel>
    <Popover @bind-Open="_open">
        <PopoverTrigger id="date">
            <Render>
                <Button @attributes="context.Attributes" Variant="ButtonVariant.Outline" Class="justify-start font-normal">
                    @(_date?.ToString("M/d/yyyy", CultureInfo.InvariantCulture) ?? "Select date")
                </Button>
            </Render>
        </PopoverTrigger>
        <PopoverContent Class="w-auto overflow-hidden p-0" Align="Align.Start">
            <Calendar Mode="CalendarMode.Single" Selected="_date" DefaultMonth="_date" CaptionLayout="CalendarCaptionLayout.Dropdown"
                      SelectedChanged="Select" />
        </PopoverContent>
    </Popover>
</Field>

@code {
    private bool _open;
    private DateOnly? _date;

    private void Select(DateOnly? date)
    {
        _date = date;
        _open = false;
    }
}
