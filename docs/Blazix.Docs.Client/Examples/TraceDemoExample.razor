@implements IDisposable

<div class="flex min-h-72 w-full max-w-sm flex-col gap-4 py-6 text-sm">
    @if (_step > 0)
    {
        <Message Align="MessageAlign.End">
            <MessageContent>
                <Bubble Align="BubbleAlign.End" Variant="BubbleVariant.Muted">
                    <BubbleContent>Why does pnpm install fail in CI?</BubbleContent>
                </Bubble>
            </MessageContent>
        </Message>
        <Message>
            <MessageContent Class="gap-4">
                <Trace>
                    @{ var thinking = _step == 1; }
                    <TraceCollapsible Open="@(_thoughtOpen ?? thinking)" OpenChanged="@(open => _thoughtOpen = open)">
                        <TraceCollapsibleTrigger>
                            <TraceLine Status="@(thinking ? TraceLineStatus.Running : TraceLineStatus.None)">
                                <TraceIcon><Icon Name="@(thinking ? "loader-circle" : "circle-check")" class="@(thinking ? "animate-spin" : null)" /></TraceIcon>
                                <TraceTitle>@(thinking ? "Thinking" : "Thought for 5s")</TraceTitle>
                            </TraceLine>
                        </TraceCollapsibleTrigger>
                        <TraceCollapsibleContent Class="whitespace-pre-wrap">@Reasoning</TraceCollapsibleContent>
                    </TraceCollapsible>
                    @foreach (var (tool, index) in Tools.Select((t, i) => (t, i)).Where(t => _step >= 2 + t.i))
                    {
                        var running = _step == 2 + index;
                        if (running)
                        {
                            <TraceLine Status="TraceLineStatus.Running">
                                <TraceIcon><Icon Name="loader-circle" class="animate-spin" /></TraceIcon>
                                <TraceTitle>Running @tool.Command</TraceTitle>
                            </TraceLine>
                        }
                        else
                        {
                            <TraceCollapsible @key="tool.Command" Open="@(index == 1)">
                                <TraceCollapsibleTrigger>
                                    <TraceLine Status="@(tool.Failed ? TraceLineStatus.Error : TraceLineStatus.None)">
                                        <TraceIcon><Icon Name="@(tool.Failed ? "circle-alert" : "circle-check")" /></TraceIcon>
                                        <TraceTitle>@(tool.Failed ? "Failed to run" : "Ran") @tool.Command</TraceTitle>
                                    </TraceLine>
                                </TraceCollapsibleTrigger>
                                <TraceCollapsibleContent>
                                    <CodeBlock Size="CodeBlockSize.Sm" Variant="@(tool.Failed ? CodeBlockVariant.Destructive : CodeBlockVariant.Default)">
                                        <CodeBlockContent Wrap="true" Class="max-h-64" Code="@tool.Output" />
                                    </CodeBlock>
                                </TraceCollapsibleContent>
                            </TraceCollapsible>
                        }
                    }
                    @if (_step >= 5)
                    {
                        var reading = _step == 5;
                        <TraceCollapsible>
                            <TraceCollapsibleTrigger>
                                <TraceLine Status="@(reading ? TraceLineStatus.Running : TraceLineStatus.None)">
                                    <TraceIcon><Icon Name="@(reading ? "loader-circle" : "globe")" class="@(reading ? "animate-spin" : null)" /></TraceIcon>
                                    <TraceTitle>@(reading ? "Using" : "Used") @Sources.Length sources</TraceTitle>
                                </TraceLine>
                            </TraceCollapsibleTrigger>
                            <TraceCollapsibleContent>
                                <Trace>
                                    @foreach (var source in Sources)
                                    {
                                        <a @key="source.Url" href="@source.Url" target="_blank" rel="noreferrer">
                                            <TraceLine>
                                                <TraceIcon><Icon Name="globe" /></TraceIcon>
                                                <TraceTitle>
                                                    @source.Title
                                                    <span class="sr-only"> (opens in a new tab)</span>
                                                </TraceTitle>
                                                <TraceIcon><Icon Name="arrow-up-right" /></TraceIcon>
                                            </TraceLine>
                                        </a>
                                    }
                                </Trace>
                            </TraceCollapsibleContent>
                        </TraceCollapsible>
                    }
                </Trace>
                @if (_step >= 6)
                {
                    <p>@Answer</p>
                }
            </MessageContent>
        </Message>
    }
    @if (_step >= 6)
    {
        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-auto self-start" @onclick="ReplayAsync">Replay</Button>
    }
</div>

@code {
    private sealed record Tool(string Command, string Output, bool Failed, int Duration);

    private sealed record Source(string Url, string Title);

    private const string Reasoning =
        "CI installs with a frozen lockfile, so the install stops when package.json and pnpm-lock.yaml disagree. " +
        "I should check what the last commit changed, then reproduce the install.";

    private const string Answer =
        "The last commit bumped a version in package.json without updating pnpm-lock.yaml, so the frozen install fails. " +
        "Run pnpm install locally and commit the lockfile.";

    private static readonly Tool[] Tools =
    [
        new("pnpm --version", "10.18.0", false, 700),
        new("git diff --stat HEAD~1 -- package.json pnpm-lock.yaml", " package.json | 2 +-\n 1 file changed, 1 insertion(+), 1 deletion(-)", false, 900),
        new("pnpm install --frozen-lockfile",
            "ERR_PNPM_OUTDATED_LOCKFILE  Cannot install with \"frozen-lockfile\" because pnpm-lock.yaml is not up to date with package.json",
            true, 1200),
    ];

    private static readonly Source[] Sources =
    [
        new("https://pnpm.io/cli/install#--frozen-lockfile", "pnpm install | pnpm.io"),
        new("https://pnpm.io/continuous-integration", "Continuous Integration | pnpm.io"),
    ];

    private CancellationTokenSource _cancel = new();

    private int _step;
    private bool? _thoughtOpen;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await PlayAsync(_cancel.Token);
        }
    }

    private async Task ReplayAsync()
    {
        await _cancel.CancelAsync();
        _cancel.Dispose();
        _cancel = new CancellationTokenSource();
        await PlayAsync(_cancel.Token);
    }

    private async Task PlayAsync(CancellationToken token)
    {
        _thoughtOpen = null;
        try
        {
            await StepAsync(1, 300, token);
            await StepAsync(2, 2000, token);
            for (var i = 0; i < Tools.Length; i++)
            {
                await StepAsync(3 + i, Tools[i].Duration, token);
            }
            await Task.Delay(1000, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }
        _step = 6;
        StateHasChanged();
    }

    private async Task StepAsync(int step, int delay, CancellationToken token)
    {
        await Task.Delay(delay, token);
        _step = step;
        StateHasChanged();
    }

    public void Dispose()
    {
        _cancel.Cancel();
        _cancel.Dispose();
    }
}
