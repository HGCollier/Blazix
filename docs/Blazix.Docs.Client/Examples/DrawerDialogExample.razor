<Blazix.Primitives.MediaQuery Query="(min-width: 768px)" MatchesChanged="@(matches => _isDesktop = matches)" />
@if (_isDesktop)
{
    <Dialog @bind-Open="_open">
        <DialogTrigger>
            <Render Context="trigger">
                <Button @attributes="trigger.Attributes" Variant="ButtonVariant.Outline">Edit Profile</Button>
            </Render>
        </DialogTrigger>
        <DialogContent Class="sm:max-w-[425px]">
            <DialogHeader>
                <DialogTitle>Edit profile</DialogTitle>
                <DialogDescription>Make changes to your profile here. Click save when you&apos;re done.</DialogDescription>
            </DialogHeader>
            @ProfileForm(null)
        </DialogContent>
    </Dialog>
}
else
{
    <Drawer @bind-Open="_open">
        <DrawerTrigger>
            <Render Context="trigger">
                <Button @attributes="trigger.Attributes" Variant="ButtonVariant.Outline">Edit Profile</Button>
            </Render>
        </DrawerTrigger>
        <DrawerContent>
            <DrawerHeader Class="text-left">
                <DrawerTitle>Edit profile</DrawerTitle>
                <DrawerDescription>Make changes to your profile here. Click save when you&apos;re done.</DrawerDescription>
            </DrawerHeader>
            @ProfileForm("p-4")
        </DrawerContent>
    </Drawer>
}

@code {
    private bool _open;
    private bool _isDesktop = true;

    private static RenderFragment ProfileForm(string? @class) => @<form class="@Cn("grid items-start gap-6", @class)">
        <div class="grid gap-3">
            <Label for="email">Email</Label>
            <Input Type="email" id="email" Value="blazix@example.com" />
        </div>
        <div class="grid gap-3">
            <Label for="username">Username</Label>
            <Input id="username" Value="@("@blazix")" />
        </div>
        <Button Type="ButtonType.submit">Save changes</Button>
    </form>;
}
