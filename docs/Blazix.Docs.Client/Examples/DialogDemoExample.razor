<Dialog>
    <form>
        <DialogTrigger>
            <Render>
                <Button @attributes="context.Attributes" Variant="ButtonVariant.Outline">Open Dialog</Button>
            </Render>
        </DialogTrigger>
        <DialogContent Class="sm:max-w-sm">
            <DialogHeader>
                <DialogTitle>Edit profile</DialogTitle>
                <DialogDescription>Make changes to your profile here. Click save when you&apos;re done.</DialogDescription>
            </DialogHeader>
            <FieldGroup>
                <Field>
                    <Label for="name-1">Name</Label>
                    <Input id="name-1" name="name" Value="Pedro Duarte" />
                </Field>
                <Field>
                    <Label for="username-1">Username</Label>
                    <Input id="username-1" name="username" Value="@@peduarte" />
                </Field>
            </FieldGroup>
            <DialogFooter>
                <DialogClose>
                    <Render>
                        <Button @attributes="context.Attributes" Variant="ButtonVariant.Outline">Cancel</Button>
                    </Render>
                </DialogClose>
                <Button Type="submit">Save changes</Button>
            </DialogFooter>
        </DialogContent>
    </form>
</Dialog>
