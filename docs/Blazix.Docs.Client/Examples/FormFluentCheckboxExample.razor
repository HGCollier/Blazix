@using FluentValidation
@using System.Linq.Expressions
@using System.Text.Json
@inject ToastManager Toasts

<Card Class="w-full sm:max-w-md">
    <CardHeader>
        <CardTitle>Notifications</CardTitle>
        <CardDescription>Manage your notification preferences.</CardDescription>
    </CardHeader>
    <CardContent>
        <EditForm @key="_editContext" id="form-fluent-checkbox" EditContext="_editContext" OnSubmit="Submit">
            <FluentValidationValidator Validator="Validator" />
            <FieldGroup>
                <div>
                    <FieldSet data-invalid="@Invalid(() => _model.Responses)">
                        <FieldLegend Variant="FieldLegendVariant.Label">Responses</FieldLegend>
                        <FieldDescription>Get notified for requests that take time, like research or image generation.</FieldDescription>
                        <FieldGroup data-slot="checkbox-group">
                            <Field Orientation="FieldOrientation.Horizontal">
                                <Checkbox id="form-fluent-checkbox-responses" Name="responses" Checked="@_model.Responses"
                                          CheckedChanged="@(value => Change(() => _model.Responses = value))" Disabled="true" />
                                <FieldLabel for="form-fluent-checkbox-responses" Class="font-normal">Push notifications</FieldLabel>
                            </Field>
                        </FieldGroup>
                    </FieldSet>
                    <FieldError Errors="@Errors(() => _model.Responses)" />
                </div>
                <FieldSeparator />
                <FieldGroup>
                    <FieldSet data-invalid="@Invalid(() => _model.Tasks)">
                        <FieldLegend Variant="FieldLegendVariant.Label">Tasks</FieldLegend>
                        <FieldDescription>Get notified when tasks you&apos;ve created have updates.</FieldDescription>
                        <FieldGroup data-slot="checkbox-group">
                            @foreach (var task in TaskOptions)
                            {
                                <Field @key="task.Id" Orientation="FieldOrientation.Horizontal" data-invalid="@Invalid(() => _model.Tasks)">
                                    <Checkbox id="@($"form-fluent-checkbox-{task.Id}")" Name="tasks" aria-invalid="@Invalid(() => _model.Tasks)"
                                              Checked="@_model.Tasks.Contains(task.Id)" CheckedChanged="@(value => Change(() => ToggleTask(task.Id, value)))" />
                                    <FieldLabel for="@($"form-fluent-checkbox-{task.Id}")" Class="font-normal">@task.Label</FieldLabel>
                                </Field>
                            }
                        </FieldGroup>
                    </FieldSet>
                    <FieldError Errors="@Errors(() => _model.Tasks)" />
                </FieldGroup>
            </FieldGroup>
        </EditForm>
    </CardContent>
    <CardFooter>
        <Field Orientation="FieldOrientation.Horizontal">
            <Button Type="ButtonType.button" Variant="ButtonVariant.Outline" @onclick="Reset">Reset</Button>
            <Button Type="ButtonType.submit" form="form-fluent-checkbox">Save</Button>
        </Field>
    </CardFooter>
</Card>

@code {
    private static readonly JsonSerializerOptions Json = new(JsonSerializerDefaults.Web);
    private static readonly NotificationsValidator Validator = new();

    private static readonly (string Id, string Label)[] TaskOptions =
    [
        ("push", "Push notifications"),
        ("email", "Email notifications"),
    ];

    private Notifications _model = new();
    private EditContext _editContext = null!;
    private bool _submitted;

    protected override void OnInitialized() => _editContext = new EditContext(_model);

    private void Submit()
    {
        _submitted = true;
        if (_editContext.Validate())
        {
            Toasts.Add(new ToastOptions { Title = "You submitted the following values:", Description = JsonSerializer.Serialize(_model, Json) });
        }
    }

    private void Change(Action update)
    {
        update();
        if (_submitted)
        {
            _editContext.Validate();
        }
    }

    private void ToggleTask(string id, bool selected) =>
        _model.Tasks = selected ? [.. _model.Tasks, id] : [.. _model.Tasks.Where(task => task != id)];

    private void Reset()
    {
        _model = new Notifications();
        _editContext = new EditContext(_model);
        _submitted = false;
    }

    private IEnumerable<string> Errors(Expression<Func<object>> field) => _editContext.GetValidationMessages(field).Take(1);

    private string Invalid(Expression<Func<object>> field) => Errors(field).Any() ? "true" : "false";

    private sealed class Notifications
    {
        public bool Responses { get; set; } = true;
        public List<string> Tasks { get; set; } = [];
    }

    private sealed class NotificationsValidator : AbstractValidator<Notifications>
    {
        public NotificationsValidator()
        {
            RuleFor(notifications => notifications.Tasks)
                .NotEmpty().WithMessage("Please select at least one notification type.");
        }
    }
}
