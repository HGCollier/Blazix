@* Dragging needs an alternative for a single tap or click (WCAG 2.5.7): these buttons set the sidebar's width. *@
<div class="flex w-full max-w-sm flex-col gap-3">
    <ResizablePanelGroup @ref="_group" Orientation="Orientation.Horizontal" Class="min-h-[200px] rounded-lg border">
        <ResizablePanel Id="resizable-buttons-sidebar" DefaultSize="25%" MinSize="15%" MaxSize="60%">
            <div class="flex h-full items-center justify-center p-6">
                <span class="font-semibold">Sidebar</span>
            </div>
        </ResizablePanel>
        <ResizableHandle WithHandle aria-label="Resize sidebar" />
        <ResizablePanel DefaultSize="75%">
            <div class="flex h-full items-center justify-center p-6">
                <span class="font-semibold">Content</span>
            </div>
        </ResizablePanel>
    </ResizablePanelGroup>
    <ButtonGroup aria-label="Sidebar width">
        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" @onclick="() => SetWidthAsync(15)">Narrow</Button>
        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" @onclick="() => SetWidthAsync(25)">Default</Button>
        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" @onclick="() => SetWidthAsync(50)">Wide</Button>
    </ButtonGroup>
</div>

@code {
    private ResizablePanelGroup? _group;

    private Task SetWidthAsync(double percent) =>
        _group?.SetLayoutAsync(new Dictionary<string, double> { ["resizable-buttons-sidebar"] = percent }) ?? Task.CompletedTask;
}
