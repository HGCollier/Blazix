<ButtonGroup>
    <Button Variant="ButtonVariant.Outline">Follow</Button>
    <DropdownMenu>
        <DropdownMenuTrigger>
            <Render>
                <Button @attributes="context.Attributes" Variant="ButtonVariant.Outline" Class="pl-2!" aria-label="More options"><Icon Data="LucideIcons.ChevronDown" /></Button>
            </Render>
        </DropdownMenuTrigger>
        <DropdownMenuContent Align="Align.End" Class="w-44">
            <DropdownMenuGroup>
                <DropdownMenuItem>
                    <Icon Data="LucideIcons.VolumeOff" />
                    Mute Conversation
                </DropdownMenuItem>
                <DropdownMenuItem>
                    <Icon Data="LucideIcons.Check" />
                    Mark as Read
                </DropdownMenuItem>
                <DropdownMenuItem>
                    <Icon Data="LucideIcons.AlertTriangle" />
                    Report Conversation
                </DropdownMenuItem>
                <DropdownMenuItem>
                    <Icon Data="LucideIcons.UserRoundX" />
                    Block User
                </DropdownMenuItem>
                <DropdownMenuItem>
                    <Icon Data="LucideIcons.Share" />
                    Share Conversation
                </DropdownMenuItem>
                <DropdownMenuItem>
                    <Icon Data="LucideIcons.Copy" />
                    Copy Conversation
                </DropdownMenuItem>
            </DropdownMenuGroup>
            <DropdownMenuSeparator />
            <DropdownMenuGroup>
                <DropdownMenuItem Destructive="true">
                    <Icon Data="LucideIcons.Trash" />
                    Delete Conversation
                </DropdownMenuItem>
            </DropdownMenuGroup>
        </DropdownMenuContent>
    </DropdownMenu>
</ButtonGroup>
