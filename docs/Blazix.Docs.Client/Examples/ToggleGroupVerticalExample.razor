<ToggleGroup Multiple="true" Orientation="Orientation.Vertical" Spacing="1" Value="@(["bold", "italic"])">
    <ToggleGroupItem Value="bold" aria-label="Toggle bold"><Icon Name="bold" /></ToggleGroupItem>
    <ToggleGroupItem Value="italic" aria-label="Toggle italic"><Icon Name="italic" /></ToggleGroupItem>
    <ToggleGroupItem Value="underline" aria-label="Toggle underline"><Icon Name="underline" /></ToggleGroupItem>
</ToggleGroup>
