<ToggleGroup Multiple="true" Orientation="Orientation.Vertical" Spacing="1" Value="@(["bold", "italic"])">
    <ToggleGroupItem Value="bold" aria-label="Toggle bold"><Icon Data="LucideIcons.Bold" /></ToggleGroupItem>
    <ToggleGroupItem Value="italic" aria-label="Toggle italic"><Icon Data="LucideIcons.Italic" /></ToggleGroupItem>
    <ToggleGroupItem Value="underline" aria-label="Toggle underline"><Icon Data="LucideIcons.Underline" /></ToggleGroupItem>
</ToggleGroup>
