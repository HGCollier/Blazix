<Popover>
    <PopoverTrigger>
        <Render>
            <Button @attributes="context.Attributes" Variant="ButtonVariant.Outline" Class="w-fit">Open Popover</Button>
        </Render>
    </PopoverTrigger>
    <PopoverContent Align="Align.Start">
        <PopoverHeader>
            <PopoverTitle>Dimensions</PopoverTitle>
            <PopoverDescription>Set the dimensions for the layer.</PopoverDescription>
        </PopoverHeader>
    </PopoverContent>
</Popover>
