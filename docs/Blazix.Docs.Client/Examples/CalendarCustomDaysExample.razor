@using System.Globalization
<Card Class="mx-auto w-fit p-0">
    <CardContent Class="p-0">
        <Calendar Mode="CalendarMode.Range" DefaultMonth="@_range?.From" @bind-SelectedRange="_range" NumberOfMonths="1"
                  CaptionLayout="CalendarCaptionLayout.Dropdown" Class="[--cell-size:--spacing(8)] sm:[--cell-size:--spacing(10)] md:[--cell-size:--spacing(12)]"
                  FormatMonthDropdown="@(date => date.ToString("MMMM", CultureInfo.InvariantCulture))">
            <DayButton>
                <CalendarDayButton @attributes="context.Attributes">
                    @context.Day.Date.Day
                    @if (!context.Modifiers.Outside)
                    {
                        <span>@(context.Day.Date.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday ? "$120" : "$100")</span>
                    }
                </CalendarDayButton>
            </DayButton>
        </Calendar>
    </CardContent>
</Card>

@code {
    private static readonly DateOnly From = new(DateTime.Today.Year, 12, 8);
    private DateRange? _range = new(From, From.AddDays(10));
}
