<div class="mx-auto flex w-full max-w-sm flex-col gap-2 py-12">
    <Attachment State="AttachmentState.Idle" Class="w-full">
        <AttachmentMedia><Icon Data="LucideIcons.Clock" /></AttachmentMedia>
        <AttachmentContent>
            <AttachmentTitle>selected-file.pdf</AttachmentTitle>
            <AttachmentDescription>Ready to upload</AttachmentDescription>
        </AttachmentContent>
        <AttachmentActions>
            <AttachmentAction aria-label="Remove selected-file.pdf"><Icon Data="LucideIcons.X" /></AttachmentAction>
        </AttachmentActions>
    </Attachment>
    <Attachment State="AttachmentState.Uploading" Class="w-full">
        <AttachmentMedia><Spinner /></AttachmentMedia>
        <AttachmentContent>
            <AttachmentTitle>design-system.zip</AttachmentTitle>
            <AttachmentDescription>Uploading · 64%</AttachmentDescription>
        </AttachmentContent>
        <AttachmentActions>
            <AttachmentAction aria-label="Cancel upload"><Icon Data="LucideIcons.X" /></AttachmentAction>
        </AttachmentActions>
    </Attachment>
    <Attachment State="AttachmentState.Processing" Class="w-full">
        <AttachmentMedia><Icon Data="LucideIcons.FileText" /></AttachmentMedia>
        <AttachmentContent>
            <AttachmentTitle>market-research.pdf</AttachmentTitle>
            <AttachmentDescription>Processing document</AttachmentDescription>
        </AttachmentContent>
        <AttachmentActions>
            <AttachmentAction aria-label="Remove market-research.pdf"><Icon Data="LucideIcons.X" /></AttachmentAction>
        </AttachmentActions>
    </Attachment>
    <Attachment State="AttachmentState.Error" Class="w-full">
        <AttachmentMedia><Icon Data="LucideIcons.FileWarning" /></AttachmentMedia>
        <AttachmentContent>
            <AttachmentTitle>financial-model.xlsx</AttachmentTitle>
            <AttachmentDescription>Upload failed. Try again.</AttachmentDescription>
        </AttachmentContent>
        <AttachmentActions>
            <AttachmentAction aria-label="Retry upload"><Icon Data="LucideIcons.RefreshCw" /></AttachmentAction>
            <AttachmentAction aria-label="Remove financial-model.xlsx"><Icon Data="LucideIcons.X" /></AttachmentAction>
        </AttachmentActions>
    </Attachment>
    <Attachment State="AttachmentState.Done" Class="w-full">
        <AttachmentMedia><Icon Data="LucideIcons.Check" /></AttachmentMedia>
        <AttachmentContent>
            <AttachmentTitle>uploaded-report.pdf</AttachmentTitle>
            <AttachmentDescription>Uploaded · 1.8 MB</AttachmentDescription>
        </AttachmentContent>
        <AttachmentActions>
            <AttachmentAction aria-label="Remove uploaded-report.pdf"><Icon Data="LucideIcons.X" /></AttachmentAction>
        </AttachmentActions>
    </Attachment>
</div>
