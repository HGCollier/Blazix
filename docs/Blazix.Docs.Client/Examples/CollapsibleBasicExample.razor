<Card Class="mx-auto w-full max-w-sm">
    <CardContent>
        <Collapsible Class="rounded-md data-open:bg-muted">
            <CollapsibleTrigger Class="@ButtonVariants.Get(ButtonVariant.Ghost, ButtonSize.Default, "group/button w-full")">
                Product details
                <Icon Name="chevron-down" class="ml-auto group-data-panel-open/button:rotate-180" />
            </CollapsibleTrigger>
            <CollapsibleContent Class="flex flex-col items-start gap-2 p-2.5 pt-0 text-sm">
                <div>This panel can be expanded or collapsed to reveal additional content.</div>
                <Button Size="ButtonSize.Xs">Learn More</Button>
            </CollapsibleContent>
        </Collapsible>
    </CardContent>
</Card>
