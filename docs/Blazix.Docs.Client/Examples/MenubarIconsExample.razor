<Menubar Class="w-72">
    <MenubarMenu>
        <MenubarTrigger>File</MenubarTrigger>
        <MenubarContent>
            <MenubarItem>
                <Icon Data="LucideIcons.File" />
                New File
                <MenubarShortcut>⌘N</MenubarShortcut>
            </MenubarItem>
            <MenubarItem>
                <Icon Data="LucideIcons.Folder" />
                Open Folder
            </MenubarItem>
            <MenubarSeparator />
            <MenubarItem>
                <Icon Data="LucideIcons.Save" />
                Save
                <MenubarShortcut>⌘S</MenubarShortcut>
            </MenubarItem>
        </MenubarContent>
    </MenubarMenu>
    <MenubarMenu>
        <MenubarTrigger>More</MenubarTrigger>
        <MenubarContent>
            <MenubarGroup>
                <MenubarItem>
                    <Icon Data="LucideIcons.Settings" />
                    Settings
                </MenubarItem>
                <MenubarItem>
                    <Icon Data="LucideIcons.HelpCircle" />
                    Help
                </MenubarItem>
                <MenubarSeparator />
                <MenubarItem Destructive="true">
                    <Icon Data="LucideIcons.Trash" />
                    Delete
                </MenubarItem>
            </MenubarGroup>
        </MenubarContent>
    </MenubarMenu>
</Menubar>
