<Menubar Class="w-72">
    <MenubarMenu>
        <MenubarTrigger>File</MenubarTrigger>
        <MenubarContent>
            <MenubarItem>
                <Icon Name="file" />
                New File
                <MenubarShortcut>⌘N</MenubarShortcut>
            </MenubarItem>
            <MenubarItem>
                <Icon Name="folder" />
                Open Folder
            </MenubarItem>
            <MenubarSeparator />
            <MenubarItem>
                <Icon Name="save" />
                Save
                <MenubarShortcut>⌘S</MenubarShortcut>
            </MenubarItem>
        </MenubarContent>
    </MenubarMenu>
    <MenubarMenu>
        <MenubarTrigger>More</MenubarTrigger>
        <MenubarContent>
            <MenubarGroup>
                <MenubarItem>
                    <Icon Name="settings" />
                    Settings
                </MenubarItem>
                <MenubarItem>
                    <Icon Name="help-circle" />
                    Help
                </MenubarItem>
                <MenubarSeparator />
                <MenubarItem Destructive="true">
                    <Icon Name="trash" />
                    Delete
                </MenubarItem>
            </MenubarGroup>
        </MenubarContent>
    </MenubarMenu>
</Menubar>
