<div class="relative flex flex-col gap-4">
    <Card Class="mx-auto h-140 w-full max-w-sm gap-0">
        <CardHeader Class="gap-1 border-b">
            <CardTitle>Opening Position</CardTitle>
            <CardDescription>Choose where a saved transcript opens.</CardDescription>
        </CardHeader>
        <CardContent Class="flex-1 overflow-hidden p-0">
            <MessageScrollerProvider @ref="_scroller">
                <MessageScroller>
                    <MessageScrollerViewport>
                        <MessageScrollerContent Class="p-(--card-spacing)">
                            @foreach (var message in Messages)
                            {
                                <MessageScrollerItem @key="message.Id" MessageId="@message.Id" ScrollAnchor="@message.IsUser">
                                    <Message Align="@(message.IsUser ? MessageAlign.End : MessageAlign.Start)">
                                        <MessageContent>
                                            <Bubble Variant="@(message.IsUser ? BubbleVariant.Muted : BubbleVariant.Ghost)">
                                                <BubbleContent Class="space-y-2">
                                                    @foreach (var paragraph in ScriptedChat.Paragraphs(message.Text))
                                                    {
                                                        <p class="whitespace-pre-wrap">@paragraph</p>
                                                    }
                                                </BubbleContent>
                                            </Bubble>
                                        </MessageContent>
                                    </Message>
                                </MessageScrollerItem>
                            }
                        </MessageScrollerContent>
                    </MessageScrollerViewport>
                    <MessageScrollerButton />
                </MessageScroller>
            </MessageScrollerProvider>
        </CardContent>
        <CardFooter Class="flex items-center justify-center border-t">
            <Tabs Value="@_position" ValueChanged="SetPosition" Class="w-full">
                <TabsList Class="w-full">
                    @foreach (var option in Positions)
                    {
                        <TabsTrigger @key="option" Value="@option">@option</TabsTrigger>
                    }
                </TabsList>
            </Tabs>
        </CardFooter>
    </Card>
    <div class="mx-auto max-w-sm px-0.5 text-center text-xs text-muted-foreground">
        Toggle the defaultScrollPosition to see where the transcript starts when you open the thread
    </div>
</div>

@code {
    private static readonly string[] Positions = ["start", "end", "last-anchor"];

    private static readonly IReadOnlyList<ChatMessage> Messages = new ScriptedChat()
        .User("This is the first message the user sent in the conversation.", "open-1")
        .Assistant("Workspace creation rose 8%, but first invite completion only rose 2%.")
        .User("This is the last message the user sent in the conversation.", "open-3")
        .Assistant("Start with the invite step. Teams are creating workspaces but waiting to add collaborators.\n\nRecommended follow-up:\n\n1. Compare invite drop-off by account size.\n2. Check whether users who skip invites still return within 24 hours.\n3. Review the empty-state copy on the first project screen.\n4. Segment activation by template, since template users may not need invites right away.\n\nIf that pattern holds, the next experiment should make collaboration useful earlier instead of prompting for invites harder.")
        .Get();

    private MessageScrollerProvider _scroller = null!;
    private string _position = "last-anchor";
    private bool _jump = true;

    private void SetPosition(string? value)
    {
        if (value is not null)
        {
            _position = value;
            _jump = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_jump)
        {
            return;
        }
        _jump = false;
        switch (_position)
        {
            case "start":
                await _scroller.ScrollToStartAsync();
                break;
            case "end":
                await _scroller.ScrollToEndAsync();
                break;
            default:
                await _scroller.ScrollToMessageAsync("open-3", new MessageScrollerScrollOptions(ScrollMargin: 64));
                break;
        }
    }
}
