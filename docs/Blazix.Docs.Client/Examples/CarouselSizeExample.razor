<Carousel Opts="@Opts" aria-label="Slides a third wide" Class="w-full max-w-[12rem] sm:max-w-xs md:max-w-sm">
    <CarouselContent>
        @foreach (var index in Enumerable.Range(0, 5))
        {
            <CarouselItem @key="index" Class="basis-1/2 lg:basis-1/3">
                <div class="p-1">
                    <Card>
                        <CardContent Class="flex aspect-square items-center justify-center p-6">
                            <span class="text-3xl font-semibold">@(index + 1)</span>
                        </CardContent>
                    </Card>
                </div>
            </CarouselItem>
        }
    </CarouselContent>
    <CarouselPrevious />
    <CarouselNext />
</Carousel>

@code {
    private static readonly CarouselOptions Opts = new() { Align = Align.Start };
}
