<div class="w-full max-w-sm">
    <TraceCollapsible Open="true">
        <TraceCollapsibleTrigger>
            <TraceLine>
                <TraceIcon><Icon Name="globe" /></TraceIcon>
                <TraceTitle>Used @Sources.Length sources</TraceTitle>
            </TraceLine>
        </TraceCollapsibleTrigger>
        <TraceCollapsibleContent>
            <Trace>
                @foreach (var source in Sources)
                {
                    <a @key="source.Href" href="@source.Href" target="_blank" rel="noreferrer">
                        <TraceLine>
                            <TraceIcon><Icon Name="globe" /></TraceIcon>
                            <TraceTitle>
                                @source.Title
                                <span class="sr-only"> (opens in a new tab)</span>
                            </TraceTitle>
                            <TraceIcon><Icon Name="arrow-up-right" /></TraceIcon>
                        </TraceLine>
                    </a>
                }
            </Trace>
        </TraceCollapsibleContent>
    </TraceCollapsible>
</div>

@code {
    private sealed record Source(string Title, string Href);

    private static readonly Source[] Sources =
    [
        new("Install Astro | docs.astro.build", "https://docs.astro.build/en/install-and-setup/"),
        new("create-astro | npmjs.com", "https://www.npmjs.com/package/create-astro"),
        new("Settings: minimumReleaseAge | pnpm.io", "https://pnpm.io/settings#minimumreleaseage"),
    ];
}
