<div class="flex w-full max-w-sm flex-col items-start gap-4">
    <TraceCollapsible Open="true">
        <TraceCollapsibleTrigger>
            <TraceLine>
                <TraceIcon><Icon Data="LucideIcons.Terminal" /></TraceIcon>
                <TraceTitle>Ran node --version</TraceTitle>
            </TraceLine>
        </TraceCollapsibleTrigger>
        <TraceCollapsibleContent>
            <CodeBlock Size="CodeBlockSize.Sm">
                <CodeBlockContent Wrap="true" Class="max-h-64" Code="@("$ node --version\nv24.18.0")" />
            </CodeBlock>
        </TraceCollapsibleContent>
    </TraceCollapsible>
    <TraceCollapsible @bind-Open="_open">
        <TraceCollapsibleTrigger>
            <TraceLine>
                <TraceIcon><Icon Data="LucideIcons.Terminal" /></TraceIcon>
                <TraceTitle>Ran pnpm --version</TraceTitle>
            </TraceLine>
        </TraceCollapsibleTrigger>
        <TraceCollapsibleContent>
            <CodeBlock Size="CodeBlockSize.Sm">
                <CodeBlockContent Wrap="true" Class="max-h-64" Code="@("$ pnpm --version\n10.33.4")" />
            </CodeBlock>
        </TraceCollapsibleContent>
    </TraceCollapsible>
    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" @onclick="Toggle">
        @(_open ? "Hide" : "Show") the pnpm output
    </Button>
</div>

@code {
    private bool _open;

    private void Toggle() => _open = !_open;
}
