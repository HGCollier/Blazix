@using System.Globalization
<Field Class="mx-auto w-44">
    <FieldLabel for="date-picker-simple">Date</FieldLabel>
    <Popover>
        <PopoverTrigger id="date-picker-simple">
            <Render>
                <Button @attributes="context.Attributes" Variant="ButtonVariant.Outline" Class="justify-start font-normal">
                    @if (_date is { } date)
                    {
                        @Format(date)
                    }
                    else
                    {
                        <span>Pick a date</span>
                    }
                </Button>
            </Render>
        </PopoverTrigger>
        <PopoverContent Class="w-auto p-0" Align="Align.Start">
            <Calendar Mode="CalendarMode.Single" @bind-Selected="_date" DefaultMonth="_date" />
        </PopoverContent>
    </Popover>
</Field>

@code {
    private DateOnly? _date;

    private static string Format(DateOnly date) =>
        date.ToString("MMMM ", CultureInfo.InvariantCulture) + date.Day + (date.Day switch
        {
            1 or 21 or 31 => "st",
            2 or 22 => "nd",
            3 or 23 => "rd",
            _ => "th",
        }) + ", " + date.Year;
}
