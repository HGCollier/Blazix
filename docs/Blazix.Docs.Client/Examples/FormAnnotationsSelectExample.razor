@using System.ComponentModel.DataAnnotations
@using System.Linq.Expressions
@using System.Text.Json
@inject ToastManager Toasts

<Card Class="w-full sm:max-w-lg">
    <CardHeader>
        <CardTitle>Language Preferences</CardTitle>
        <CardDescription>Select your preferred spoken language.</CardDescription>
    </CardHeader>
    <CardContent>
        <EditForm @key="_editContext" id="form-annotations-select" EditContext="_editContext" OnSubmit="Submit">
            <DataAnnotationsValidator />
            <FieldGroup>
                <Field Orientation="FieldOrientation.Responsive" data-invalid="@Invalid(() => _model.Language)">
                    <FieldContent>
                        <FieldLabel for="form-annotations-select-language">Spoken Language</FieldLabel>
                        <FieldDescription>For best results, select the language you speak.</FieldDescription>
                        <FieldError Errors="@Errors(() => _model.Language)" />
                    </FieldContent>
                    <Select Items="Items" Name="language" Value="@_model.Language" ValueChanged="@(value => Change(() => _model.Language = value ?? ""))">
                        <SelectTrigger id="form-annotations-select-language" aria-invalid="@Invalid(() => _model.Language)" Class="min-w-[120px]">
                            <SelectValue Placeholder="Select" />
                        </SelectTrigger>
                        <SelectContent>
                            <SelectGroup>
                                <SelectItem Value="auto">Auto</SelectItem>
                                <SelectSeparator />
                                @foreach (var language in SpokenLanguages)
                                {
                                    <SelectItem @key="language.Value" Value="@language.Value">@language.Label</SelectItem>
                                }
                            </SelectGroup>
                        </SelectContent>
                    </Select>
                </Field>
            </FieldGroup>
        </EditForm>
    </CardContent>
    <CardFooter>
        <Field Orientation="FieldOrientation.Horizontal">
            <Button Type="ButtonType.button" Variant="ButtonVariant.Outline" @onclick="Reset">Reset</Button>
            <Button Type="ButtonType.submit" form="form-annotations-select">Save</Button>
        </Field>
    </CardFooter>
</Card>

@code {
    private static readonly JsonSerializerOptions Json = new(JsonSerializerDefaults.Web);

    private static readonly SelectOption[] SpokenLanguages =
    [
        new("en", "English"),
        new("es", "Spanish"),
        new("fr", "French"),
        new("de", "German"),
        new("it", "Italian"),
        new("zh", "Chinese"),
        new("ja", "Japanese"),
    ];

    private static readonly SelectOption[] Items = [new("auto", "Auto"), .. SpokenLanguages];

    private LanguagePreferences _model = new();
    private EditContext _editContext = null!;
    private bool _submitted;

    protected override void OnInitialized() => _editContext = new EditContext(_model);

    private void Submit()
    {
        _submitted = true;
        if (_editContext.Validate())
        {
            Toasts.Add(new ToastOptions { Title = "You submitted the following values:", Description = JsonSerializer.Serialize(_model, Json) });
        }
    }

    private void Change(Action update)
    {
        update();
        if (_submitted)
        {
            _editContext.Validate();
        }
    }

    private void Reset()
    {
        _model = new LanguagePreferences();
        _editContext = new EditContext(_model);
        _submitted = false;
    }

    private IEnumerable<string> Errors(Expression<Func<object>> field) => _editContext.GetValidationMessages(field).Take(1);

    private string Invalid(Expression<Func<object>> field) => Errors(field).Any() ? "true" : "false";

    private sealed class LanguagePreferences
    {
        [Required(ErrorMessage = "Please select your spoken language.")]
        [RegularExpression("^(?!auto$).*$", ErrorMessage = "Auto-detection is not allowed. Please select a specific language.")]
        public string Language { get; set; } = "";
    }
}
