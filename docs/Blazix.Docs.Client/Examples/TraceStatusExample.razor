<Trace Class="max-w-sm">
    <TraceLine>
        <TraceIcon><Icon Data="LucideIcons.CircleCheck" /></TraceIcon>
        <TraceTitle>Ran pnpm install</TraceTitle>
    </TraceLine>
    <TraceLine Status="TraceLineStatus.Error">
        <TraceIcon><Icon Data="LucideIcons.CircleAlert" /></TraceIcon>
        <TraceTitle>Failed to run pnpm lint</TraceTitle>
    </TraceLine>
    <TraceLine Status="TraceLineStatus.Running">
        <TraceIcon><Icon Data="LucideIcons.LoaderCircle" class="animate-spin" /></TraceIcon>
        <TraceTitle>Running pnpm build</TraceTitle>
    </TraceLine>
    <TraceLine Status="TraceLineStatus.Pending">
        <TraceIcon><Icon Data="LucideIcons.Circle" /></TraceIcon>
        <TraceTitle>Run pnpm test</TraceTitle>
    </TraceLine>
</Trace>
