<div class="flex w-full max-w-md flex-col gap-6">
    <Item Variant="ItemVariant.Outline">
        <ItemContent>
            <ItemTitle>Basic Item</ItemTitle>
            <ItemDescription>A simple item with title and description.</ItemDescription>
        </ItemContent>
        <ItemActions><Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm">Action</Button></ItemActions>
    </Item>
    <Item Variant="ItemVariant.Outline" Size="ItemSize.Sm">
        <Render>
            <a @attributes="context.Attributes" href="#">
                <ItemMedia><Icon Data="LucideIcons.BadgeCheck" class="size-5" /></ItemMedia>
                <ItemContent><ItemTitle>Your profile has been verified.</ItemTitle></ItemContent>
                <ItemActions><Icon Data="LucideIcons.ChevronRight" class="size-4" /></ItemActions>
            </a>
        </Render>
    </Item>
</div>
