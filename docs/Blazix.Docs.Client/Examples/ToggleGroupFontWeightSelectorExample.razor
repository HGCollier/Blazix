<Field>
    <FieldLabel>Font Weight</FieldLabel>
    <ToggleGroup Value="@([_fontWeight])" ValueChanged="SetFontWeight" Variant="ToggleVariant.Outline" Spacing="2" Size="ToggleSize.Lg">
        @foreach (var (value, label, weight) in Weights)
        {
            <ToggleGroupItem Value="@value" aria-label="@label" Class="flex size-16 flex-col items-center justify-center rounded-xl">
                <span class="@($"text-2xl leading-none {weight}")">Aa</span>
                <span class="text-xs text-muted-foreground">@label</span>
            </ToggleGroupItem>
        }
    </ToggleGroup>
    <FieldDescription>
        Use <code class="rounded-md bg-muted px-1 py-0.5 font-mono">font-@_fontWeight</code> to set the font weight.
    </FieldDescription>
</Field>

@code {
    private static readonly (string Value, string Label, string Class)[] Weights =
    [
        ("light", "Light", "font-light"),
        ("normal", "Normal", "font-normal"),
        ("medium", "Medium", "font-medium"),
        ("bold", "Bold", "font-bold"),
    ];

    private string _fontWeight = "normal";

    private void SetFontWeight(IReadOnlyList<string>? value)
    {
        if (value is [var weight, ..])
        {
            _fontWeight = weight;
        }
    }
}
