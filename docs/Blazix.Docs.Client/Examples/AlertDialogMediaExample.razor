<AlertDialog>
    <AlertDialogTrigger>
        <Render>
            <Button @attributes="context.Attributes" Variant="ButtonVariant.Outline">Share Project</Button>
        </Render>
    </AlertDialogTrigger>
    <AlertDialogContent>
        <AlertDialogHeader>
            <AlertDialogMedia><Icon Data="LucideIcons.CircleFadingPlus" /></AlertDialogMedia>
            <AlertDialogTitle>Share this project?</AlertDialogTitle>
            <AlertDialogDescription>Anyone with the link will be able to view and edit this project.</AlertDialogDescription>
        </AlertDialogHeader>
        <AlertDialogFooter>
            <AlertDialogCancel>Cancel</AlertDialogCancel>
            <AlertDialogAction>Share</AlertDialogAction>
        </AlertDialogFooter>
    </AlertDialogContent>
</AlertDialog>
