<div class="flex w-full max-w-sm flex-col gap-8 py-12">
    <Bubble Variant="BubbleVariant.Muted">
        <BubbleContent>Can you tell me what&apos;s the issue?</BubbleContent>
    </Bubble>
    <BubbleGroup>
        <Bubble Align="BubbleAlign.End"><BubbleContent>You tell me!</BubbleContent></Bubble>
        <Bubble Align="BubbleAlign.End"><BubbleContent>It worked yesterday. You broke it!</BubbleContent></Bubble>
