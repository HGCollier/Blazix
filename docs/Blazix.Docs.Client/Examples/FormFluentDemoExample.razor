@using FluentValidation
@using System.Linq.Expressions
@using System.Text.Json
@inject ToastManager Toasts

<Card Class="w-full sm:max-w-md">
    <CardHeader>
        <CardTitle>Bug Report</CardTitle>
        <CardDescription>Help us improve by reporting bugs you encounter.</CardDescription>
    </CardHeader>
    <CardContent>
        <EditForm @key="_editContext" id="form-fluent-demo" EditContext="_editContext" OnSubmit="Submit">
            <FluentValidationValidator Validator="Validator" />
            <FieldGroup>
                <Field data-invalid="@Invalid(() => _model.Title)">
                    <FieldLabel for="form-fluent-demo-title">Bug Title</FieldLabel>
                    <Input id="form-fluent-demo-title" Value="@_model.Title" ValueChanged="@(value => Change(() => _model.Title = value ?? ""))"
                           aria-invalid="@Invalid(() => _model.Title)" placeholder="Login button not working on mobile" autocomplete="off" />
                    <FieldError Errors="@Errors(() => _model.Title)" />
                </Field>
                <Field data-invalid="@Invalid(() => _model.Description)">
                    <FieldLabel for="form-fluent-demo-description">Description</FieldLabel>
                    <InputGroup>
                        <InputGroupTextarea id="form-fluent-demo-description" Value="@_model.Description" @oninput="@(e => Change(() => _model.Description = e.Value?.ToString() ?? ""))"
                                            placeholder="I'm having an issue with the login button on mobile." rows="6"
                                            Class="min-h-24 resize-none" aria-invalid="@Invalid(() => _model.Description)" />
                        <InputGroupAddon Align="InputGroupAddonAlign.BlockEnd">
                            <InputGroupText Class="tabular-nums">@_model.Description.Length/100 characters</InputGroupText>
                        </InputGroupAddon>
                    </InputGroup>
                    <FieldDescription>Include steps to reproduce, expected behavior, and what actually happened.</FieldDescription>
                    <FieldError Errors="@Errors(() => _model.Description)" />
                </Field>
            </FieldGroup>
        </EditForm>
    </CardContent>
    <CardFooter>
        <Field Orientation="FieldOrientation.Horizontal">
            <Button Type="ButtonType.button" Variant="ButtonVariant.Outline" @onclick="Reset">Reset</Button>
            <Button Type="ButtonType.submit" form="form-fluent-demo">Submit</Button>
        </Field>
    </CardFooter>
</Card>

@code {
    private static readonly JsonSerializerOptions Json = new(JsonSerializerDefaults.Web);
    private static readonly BugReportValidator Validator = new();

    private BugReport _model = new();
    private EditContext _editContext = null!;
    private bool _submitted;

    protected override void OnInitialized() => _editContext = new EditContext(_model);

    private void Submit()
    {
        _submitted = true;
        if (_editContext.Validate())
        {
            Toasts.Add(new ToastOptions
            {
                Title = "You submitted the following values:",
                Description = JsonSerializer.Serialize(_model, Json),
            });
        }
    }

    private void Change(Action update)
    {
        update();
        if (_submitted)
        {
            _editContext.Validate();
        }
    }

    private void Reset()
    {
        _model = new BugReport();
        _editContext = new EditContext(_model);
        _submitted = false;
    }

    private IEnumerable<string> Errors(Expression<Func<object>> field) => _editContext.GetValidationMessages(field).Take(1);

    private string Invalid(Expression<Func<object>> field) => Errors(field).Any() ? "true" : "false";

    private sealed class BugReport
    {
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
    }

    private sealed class BugReportValidator : AbstractValidator<BugReport>
    {
        public BugReportValidator()
        {
            RuleFor(report => report.Title)
                .MinimumLength(5).WithMessage("Bug title must be at least 5 characters.")
                .MaximumLength(32).WithMessage("Bug title must be at most 32 characters.");
            RuleFor(report => report.Description)
                .MinimumLength(20).WithMessage("Description must be at least 20 characters.")
                .MaximumLength(100).WithMessage("Description must be at most 100 characters.");
        }
    }
}
