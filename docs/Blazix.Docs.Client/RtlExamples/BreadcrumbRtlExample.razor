<Breadcrumb>
    <BreadcrumbList>
        <BreadcrumbItem>
            <BreadcrumbLink>
                <Render>
                    <a @attributes="context.Attributes" href="/">@T.Home</a>
                </Render>
            </BreadcrumbLink>
        </BreadcrumbItem>
        <BreadcrumbSeparator><Icon Name="dot" /></BreadcrumbSeparator>
        <BreadcrumbItem>
            <DropdownMenu>
                <DropdownMenuTrigger>
                    <Render>
                        <button @attributes="context.Attributes" class="flex items-center gap-1">
                            @T.Components
                            <Icon Name="chevron-down" data-icon="inline-end" class="size-3.5" />
                        </button>
                    </Render>
                </DropdownMenuTrigger>
                <DropdownMenuContent Align="Align.Start">
                    <DropdownMenuGroup>
                        <DropdownMenuItem>@T.Documentation</DropdownMenuItem>
                        <DropdownMenuItem>@T.Themes</DropdownMenuItem>
                        <DropdownMenuItem>@T.GitHub</DropdownMenuItem>
                    </DropdownMenuGroup>
                </DropdownMenuContent>
            </DropdownMenu>
        </BreadcrumbItem>
        <BreadcrumbSeparator><Icon Name="dot" /></BreadcrumbSeparator>
        <BreadcrumbItem><BreadcrumbPage>@T.Breadcrumb</BreadcrumbPage></BreadcrumbItem>
    </BreadcrumbList>
</Breadcrumb>

@code {
    [CascadingParameter] private Language Language { get; set; } = Language.Arabic;

    private Text T => Texts[Language];

    private static readonly Translations<Text> Texts = new(
        En: new("Home", "Components", "Documentation", "Themes", "GitHub", "Breadcrumb"),
        Ar: new("الرئيسية", "المكونات", "التوثيق", "السمات", "جيت هاب", "مسار التنقل"),
        He: new("בית", "רכיבים", "תיעוד", "ערכות נושא", "גיטהאב", "פירורי לחם"));

    private sealed record Text(string Home, string Components, string Documentation, string Themes, string GitHub, string Breadcrumb);
}
