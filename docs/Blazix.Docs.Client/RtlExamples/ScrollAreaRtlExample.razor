<ScrollArea Class="h-72 w-48 rounded-md border">
    <div class="p-4">
        <h4 class="mb-4 text-sm leading-none font-medium">@Texts[Language]</h4>
        @foreach (var tag in Tags)
        {
            <div class="text-sm">@tag</div>
            <Separator Class="my-2" />
        }
    </div>
</ScrollArea>

@code {
    [CascadingParameter] private Language Language { get; set; } = Language.Arabic;

    private static readonly Translations<string> Texts = new(En: "Tags", Ar: "العلامات", He: "תגיות");

    private static readonly string[] Tags = [.. Enumerable.Range(0, 50).Select(i => $"v1.2.0-beta.{50 - i}")];
}
