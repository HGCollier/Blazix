<Tabs Value="overview" Class="w-full max-w-sm min-w-0">
    <TabsList Class="max-w-full justify-start overflow-x-auto">
        @foreach (var tab in T.Tabs)
        {
            <TabsTrigger Value="@tab.Value">@tab.Label</TabsTrigger>
        }
    </TabsList>
    @foreach (var tab in T.Tabs)
    {
        <TabsContent Value="@tab.Value">
            <Card>
                <CardHeader>
                    <CardTitle>@tab.Label</CardTitle>
                    <CardDescription>@tab.Description</CardDescription>
                </CardHeader>
                <CardContent Class="text-sm text-muted-foreground">@tab.Content</CardContent>
            </Card>
        </TabsContent>
    }
</Tabs>

@code {
    [CascadingParameter] private Language Language { get; set; } = Language.Arabic;

    private Text T => Texts[Language];

    private static readonly Translations<Text> Texts = new(
        En: new([
            new("overview", "Overview", "View your key metrics and recent project activity. Track progress across all your active projects.",
                "You have 12 active projects and 3 pending tasks."),
            new("analytics", "Analytics", "Track performance and user engagement metrics. Monitor trends and identify growth opportunities.",
                "Page views are up 25% compared to last month."),
            new("reports", "Reports", "Generate and download your detailed reports. Export data in multiple formats for analysis.",
                "You have 5 reports ready and available to export."),
            new("settings", "Settings", "Manage your account preferences and options. Customize your experience to fit your needs.",
                "Configure notifications, security, and themes."),
        ]),
        Ar: new([
            new("overview", "نظرة عامة", "عرض مقاييسك الرئيسية وأنشطة المشروع الأخيرة. تتبع التقدم عبر جميع مشاريعك النشطة.",
                "لديك ١٢ مشروعًا نشطًا و٣ مهام معلقة."),
            new("analytics", "التحليلات", "تتبع مقاييس الأداء ومشاركة المستخدمين. راقب الاتجاهات وحدد فرص النمو.",
                "زادت مشاهدات الصفحة بنسبة ٢٥٪ مقارنة بالشهر الماضي."),
            new("reports", "التقارير", "إنشاء وتنزيل تقاريرك التفصيلية. تصدير البيانات بتنسيقات متعددة للتحليل.",
                "لديك ٥ تقارير جاهزة ومتاحة للتصدير."),
