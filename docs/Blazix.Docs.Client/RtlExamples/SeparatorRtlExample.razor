<div class="flex max-w-sm flex-col gap-4 text-sm">
    <div class="flex flex-col gap-1.5">
        <div class="leading-none font-medium">Blazix</div>
        <div class="text-muted-foreground">@T.Subtitle</div>
    </div>
    <Separator />
    <div>@T.Description</div>
</div>

@code {
    [CascadingParameter] private Language Language { get; set; } = Language.Arabic;

    private Text T => Texts[Language];

    private static readonly Translations<Text> Texts = new(
        En: new("The Foundation for your Design System",
            "A set of beautifully designed components that you can customize, extend, and build on."),
        Ar: new("الأساس لنظام التصميم الخاص بك",
            "مجموعة من المكونات المصممة بشكل جميل يمكنك تخصيصها وتوسيعها والبناء عليها."),
        He: new("הבסיס למערכת העיצוב שלך",
            "סט של רכיבים מעוצבים בצורה יפה שאתה יכול להתאים אישית, להרחיב ולבנות עליהם."));

    private sealed record Text(string Subtitle, string Description);
}
