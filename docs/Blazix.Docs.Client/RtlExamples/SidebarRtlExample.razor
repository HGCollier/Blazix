<Blazix.Primitives.MediaQuery Query="(max-width: 767px)" MatchesChanged="@(matches => _isMobile = matches)" />
<SidebarProvider>
    @* Side is physical: put the sidebar at the start of the reading direction, the right in RTL. *@
    <Sidebar Collapsible="SidebarCollapsible.Icon" Variant="SidebarVariant.Floating" Side="@(Rtl ? SidebarSide.Right : SidebarSide.Left)">
        <SidebarHeader>
            <SidebarMenu>
                <SidebarMenuItem>
                    <SidebarMenuButton Size="SidebarMenuButtonSize.Lg">
                        <Render Context="link">
                            <a @attributes="link.Attributes" href="#">
                                <div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                                    <Icon Name="gallery-vertical-end" class="size-4" />
                                </div>
                                <div class="flex flex-col gap-0.5 leading-none">
                                    <span class="font-medium">@T["teamName"]</span>
                                    <span>@T["teamPlan"]</span>
                                </div>
                            </a>
                        </Render>
                    </SidebarMenuButton>
                </SidebarMenuItem>
            </SidebarMenu>
        </SidebarHeader>
        <SidebarContent>
            <SidebarGroup>
                <SidebarGroupLabel>@T["platform"]</SidebarGroupLabel>
                <SidebarMenu>
                    @foreach (var item in NavMain)
                    {
                        <Collapsible @key="item.Title" Open="item.IsActive" Class="group/collapsible">
                            <Render Context="collapsible">
                                <SidebarMenuItem @attributes="collapsible.Attributes">
                                    <CollapsibleTrigger>
                                        <Render Context="trigger">
                                            <SidebarMenuButton @attributes="trigger.Attributes">
                                                <Tooltip>@T[item.Title]</Tooltip>
                                                <ChildContent>
                                                    <Icon Name="@item.Icon" />
                                                    <span>@T[item.Title]</span>
                                                    @* Points to the end, and down when open, in either direction. *@
                                                    <Icon Name="chevron-right" class="ms-auto transition-transform duration-200 group-data-open/collapsible:rotate-90 rtl:rotate-180 rtl:group-data-open/collapsible:rotate-90" />
                                                </ChildContent>
                                            </SidebarMenuButton>
                                        </Render>
                                    </CollapsibleTrigger>
                                    <CollapsibleContent>
                                        <SidebarMenuSub>
                                            @foreach (var subItem in item.Items)
                                            {
                                                <SidebarMenuSubItem @key="subItem">
                                                    <SidebarMenuSubButton>
                                                        <Render Context="link">
                                                            <a @attributes="link.Attributes" href="#"><span>@T[subItem]</span></a>
                                                        </Render>
                                                    </SidebarMenuSubButton>
                                                </SidebarMenuSubItem>
                                            }
                                        </SidebarMenuSub>
                                    </CollapsibleContent>
                                </SidebarMenuItem>
                            </Render>
                        </Collapsible>
                    }
                </SidebarMenu>
            </SidebarGroup>
            <SidebarGroup Class="group-data-[collapsible=icon]:hidden">
                <SidebarGroupLabel>@T["projects"]</SidebarGroupLabel>
                <SidebarMenu>
                    @foreach (var (name, icon) in Projects)
                    {
                        <SidebarMenuItem @key="name">
                            <SidebarMenuButton>
                                <Render Context="link">
                                    <a @attributes="link.Attributes" href="#">
                                        <Icon Name="@icon" />
                                        <span>@T[name]</span>
                                    </a>
                                </Render>
                            </SidebarMenuButton>
                            <DropdownMenu>
                                <DropdownMenuTrigger>
                                    <Render Context="trigger">
                                        <SidebarMenuAction @attributes="trigger.Attributes" ShowOnHover="true">
                                            <Icon Name="ellipsis" />
                                            <span class="sr-only">@T["more"]</span>
                                        </SidebarMenuAction>
                                    </Render>
                                </DropdownMenuTrigger>
                                <DropdownMenuContent Class="w-48 rounded-lg" Side="@SideForMenus" Align="@(_isMobile ? Align.End : Align.Start)">
                                    <DropdownMenuItem>
                                        <Icon Name="folder" class="text-muted-foreground" />
                                        <span>@T["viewProject"]</span>
                                    </DropdownMenuItem>
                                    <DropdownMenuItem>
                                        <Icon Name="forward" class="text-muted-foreground rtl:-scale-x-100" />
                                        <span>@T["shareProject"]</span>
                                    </DropdownMenuItem>
                                    <DropdownMenuSeparator />
                                    <DropdownMenuItem>
                                        <Icon Name="trash-2" class="text-muted-foreground" />
                                        <span>@T["deleteProject"]</span>
                                    </DropdownMenuItem>
                                </DropdownMenuContent>
                            </DropdownMenu>
                        </SidebarMenuItem>
                    }
                    <SidebarMenuItem>
                        <SidebarMenuButton Class="text-sidebar-foreground/70">
                            <Icon Name="ellipsis" class="text-sidebar-foreground/70" />
                            <span>@T["more"]</span>
                        </SidebarMenuButton>
                    </SidebarMenuItem>
                </SidebarMenu>
            </SidebarGroup>
        </SidebarContent>
        <SidebarFooter>
            <SidebarMenu>
                <SidebarMenuItem>
                    <DropdownMenu>
                        <DropdownMenuTrigger>
                            <Render Context="trigger">
                                <SidebarMenuButton @attributes="trigger.Attributes" Size="SidebarMenuButtonSize.Lg"
                                                   Class="data-[state=open]:bg-sidebar-accent data-[state=open]:text-sidebar-accent-foreground">
                                    @UserSummary
                                    <Icon Name="chevrons-up-down" class="ms-auto size-4" />
                                </SidebarMenuButton>
                            </Render>
                        </DropdownMenuTrigger>
                        <DropdownMenuContent Class="w-(--anchor-width) min-w-56 rounded-lg" Side="@SideForMenus" Align="Align.End" SideOffset="4">
                            <DropdownMenuGroup>
                                <DropdownMenuLabel Class="p-0 font-normal">
                                    <div class="flex items-center gap-2 px-1 py-1.5 text-start text-sm">@UserSummary</div>
                                </DropdownMenuLabel>
                            </DropdownMenuGroup>
                            <DropdownMenuSeparator />
                            <DropdownMenuGroup>
                                <DropdownMenuItem><Icon Name="sparkles" /> @T["upgradeToPro"]</DropdownMenuItem>
                            </DropdownMenuGroup>
                            <DropdownMenuSeparator />
                            <DropdownMenuGroup>
                                <DropdownMenuItem><Icon Name="badge-check" /> @T["account"]</DropdownMenuItem>
                                <DropdownMenuItem><Icon Name="credit-card" /> @T["billing"]</DropdownMenuItem>
                                <DropdownMenuItem><Icon Name="bell" /> @T["notifications"]</DropdownMenuItem>
                            </DropdownMenuGroup>
                            <DropdownMenuSeparator />
                            <DropdownMenuGroup>
                                <DropdownMenuItem><Icon Name="log-out" class="rtl:rotate-180" /> @T["logOut"]</DropdownMenuItem>
                            </DropdownMenuGroup>
                        </DropdownMenuContent>
                    </DropdownMenu>
                </SidebarMenuItem>
            </SidebarMenu>
        </SidebarFooter>
        <SidebarRail />
    </Sidebar>
    <SidebarInset>
        <header class="flex h-16 shrink-0 items-center gap-2 transition-[width,height] ease-linear group-has-data-[collapsible=icon]/sidebar-wrapper:h-12">
            <div class="flex items-center gap-2 px-4">
                <SidebarTrigger Class="-ms-1" />
            </div>
        </header>
    </SidebarInset>
</SidebarProvider>

