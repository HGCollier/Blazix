@* The swipe direction is physical: slide in from the end of the reading direction, the left in RTL. *@
<Drawer @bind-Open="_open" SwipeDirection="@(Language.Direction == TextDirection.Rtl ? DrawerSwipeDirection.Left : DrawerSwipeDirection.Right)">
    <DrawerTrigger>
        <Render>
            <Button @attributes="context.Attributes" Variant="ButtonVariant.Secondary">@T.Trigger</Button>
        </Render>
    </DrawerTrigger>
    <DrawerContent>
        <DrawerHeader>
            <DrawerTitle>@T.Title</DrawerTitle>
            <DrawerDescription>@T.Description</DrawerDescription>
        </DrawerHeader>
        <div class="flex-1 overflow-y-auto p-4">
            <RadioGroup @bind-Value="_deliveryTime" Class="gap-2">
                @foreach (var time in T.Times)
                {
                    <FieldLabel for="@($"drawer-rtl-{time.Value}")">
                        <Field Orientation="FieldOrientation.Horizontal">
                            <FieldContent>
                                <FieldTitle Class="flex items-center gap-2">
                                    @time.Label
                                    @if (time.Badge is not null)
                                    {
                                        <Badge Variant="BadgeVariant.Secondary">@time.Badge</Badge>
                                    }
                                </FieldTitle>
                                <FieldDescription>@time.Description</FieldDescription>
                            </FieldContent>
                            <RadioGroupItem Value="@time.Value" id="@($"drawer-rtl-{time.Value}")" />
                        </Field>
                    </FieldLabel>
                }
            </RadioGroup>
        </div>
        <DrawerFooter>
            <Button @onclick="() => _open = false">@T.Confirm</Button>
            <DrawerClose>
                <Render>
                    <Button @attributes="context.Attributes" Variant="ButtonVariant.Outline">@T.Cancel</Button>
                </Render>
            </DrawerClose>
        </DrawerFooter>
    </DrawerContent>
</Drawer>

@code {
    [CascadingParameter] private Language Language { get; set; } = Language.Arabic;

    private bool _open;
    private string? _deliveryTime = "asap";

    private Text T => Texts[Language];

    private static readonly Translations<Text> Texts = new(
        En: new("Open Drawer", "Pick a delivery time", "We'll prepare your order as soon as possible.", "Confirm Delivery Time",
