            ]),
        Ar: new("فتح الدرج", "اختر وقت التوصيل", "سنجهز طلبك في أقرب وقت ممكن.", "تأكيد وقت التوصيل", "إلغاء",
            [
                new("asap", "توصيل قياسي", "25–35 دقيقة · تم تعيين السائق الآن", "الأسرع"),
