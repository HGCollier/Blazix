<ResizablePanelGroup Orientation="Orientation.Horizontal" Class="max-w-sm rounded-lg border">
    <ResizablePanel DefaultSize="50%">
        <div class="flex h-[200px] items-center justify-center p-6">
            <span class="font-semibold">@T.One</span>
        </div>
    </ResizablePanel>
    <ResizableHandle WithHandle />
    <ResizablePanel DefaultSize="50%">
        <ResizablePanelGroup Orientation="Orientation.Vertical">
            <ResizablePanel DefaultSize="25%">
                <div class="flex h-full items-center justify-center p-6">
                    <span class="font-semibold">@T.Two</span>
                </div>
            </ResizablePanel>
            <ResizableHandle WithHandle />
            <ResizablePanel DefaultSize="75%">
                <div class="flex h-full items-center justify-center p-6">
                    <span class="font-semibold">@T.Three</span>
                </div>
            </ResizablePanel>
        </ResizablePanelGroup>
    </ResizablePanel>
</ResizablePanelGroup>

@code {
    [CascadingParameter] private Language Language { get; set; } = Language.Arabic;

    private Text T => Texts[Language];

    private static readonly Translations<Text> Texts = new(
        En: new("One", "Two", "Three"),
        Ar: new("واحد", "اثنان", "ثلاثة"),
        He: new("אחד", "שניים", "שלושה"));

    private sealed record Text(string One, string Two, string Three);
}
