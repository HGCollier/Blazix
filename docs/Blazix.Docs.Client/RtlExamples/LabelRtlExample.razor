<div class="flex gap-2">
    <Checkbox id="terms-rtl" />
    <Label for="terms-rtl">@Texts[Language]</Label>
</div>

@code {
    [CascadingParameter] private Language Language { get; set; } = Language.Arabic;

    private static readonly Translations<string> Texts = new(
        En: "Accept terms and conditions",
        Ar: "قبول الشروط والأحكام",
        He: "קבל תנאים והגבלות");
}
