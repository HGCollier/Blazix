<div class="mx-auto w-full max-w-xs overflow-hidden rounded-2xl border">
    <div tabindex="0" role="region" aria-label="@T.Label" class="scroll-fade-x no-scrollbar overflow-x-auto">
        <div class="flex w-max gap-1.5 p-1.5">
            @foreach (var tag in T.Tags)
            {
                <div class="shrink-0 rounded-lg bg-muted px-3 py-2.5 text-sm">@tag</div>
            }
        </div>
    </div>
</div>

@code {
    [CascadingParameter] private Language Language { get; set; } = Language.Arabic;

    private Text T => Texts[Language];

    private static readonly Translations<Text> Texts = new(
        En: new("Teams", ["Design", "Engineering", "Marketing", "Product", "Research", "Sales", "Support", "Operations", "Finance", "Legal"]),
        Ar: new("الفرق", ["تصميم", "هندسة", "تسويق", "منتج", "أبحاث", "مبيعات", "دعم", "عمليات", "مالية", "قانوني"]),
        He: new("צוותים", ["עיצוב", "הנדסה", "שיווק", "מוצר", "מחקר", "מכירות", "תמיכה", "תפעול", "כספים", "משפטי"]));

    private sealed record Text(string Label, string[] Tags);
}
