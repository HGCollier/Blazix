@inject SiteScript Site

<button type="button" data-slot="button" title="Toggle theme" @onclick="ToggleAsync"
        class="@SiteButton.Get(SiteButton.Ghost, SiteButton.SizeIcon, Cn("group/toggle size-8 pointer-coarse:relative pointer-coarse:touch-manipulation pointer-coarse:after:absolute pointer-coarse:after:-inset-2", Class))">
    <Icon Data="LucideIcons.SunMoon" aria-hidden="true" class="size-4.5" />
    <span class="sr-only">Toggle theme</span>
</button>

@code {
    [Parameter] public string? Class { get; set; }

    private async Task ToggleAsync()
    {
        var module = await Site.GetAsync(Assets["site.js"]);
        await module.InvokeVoidAsync("toggleTheme");
    }
}
