@using System.Globalization
@using System.Net.Http.Headers
@using System.Text.Json.Serialization

@* The header's link to the repository, with its star count, as on ui.shadcn.com. *@
<a href="@RepositoryUrl" target="_blank" rel="noreferrer" data-slot="button"
   class="@SiteButton.Get(SiteButton.Ghost, SiteButton.SizeSm, Cn("h-8 shadow-none", Class))">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
        <path fill="currentColor"
              d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
    </svg>
    <span class="sr-only">GitHub</span>
    @if (Stars is { } stars)
    {
        <span class="w-fit text-xs text-muted-foreground tabular-nums">
            @Format(stars)<span class="sr-only"> stars</span>
        </span>
    }
</a>

@code {
    private const string Repository = "HGCollier/Blazix";
    private const string RepositoryUrl = $"https://github.com/{Repository}";

    // One request per process: the prerender saves every page from the same server, and in the browser the header
    // stays put across navigations. A failed request isn't kept, so the next page tries again.
    private static readonly HttpClient Http = CreateClient();
    private static Task<int?>? _stars;

    [Parameter] public string? Class { get; set; }

    /// <summary>
    /// Fetched while prerendering and carried into the HTML, so the browser shows it without asking GitHub. The
    /// browser fetches it only when the prerender couldn't.
    /// </summary>
    [PersistentState] public int? Stars { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Stars is null)
        {
            Stars = await GetStarsAsync();
        }
    }

    private static Task<int?> GetStarsAsync() => _stars ??= FetchAsync();

    private static async Task<int?> FetchAsync()
    {
        try
        {
            var repo = await Http.GetFromJsonAsync<Repo>($"https://api.github.com/repos/{Repository}");
            return repo?.StargazersCount;
        }
        catch (Exception e) when (e is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            _stars = null;
            return null;
        }
    }

    private static HttpClient CreateClient()
    {
        var http = new HttpClient { Timeout = TimeSpan.FromSeconds(10) };
        http.DefaultRequestHeaders.Accept.Add(new MediaTypeWithQualityHeaderValue("application/vnd.github+json"));
        // The browser sets its own User-Agent and the page has no token; on the server GitHub requires the one and
        // takes the other (CI's GITHUB_TOKEN) for a higher rate limit than a shared runner's address gets.
        if (!OperatingSystem.IsBrowser())
        {
            http.DefaultRequestHeaders.UserAgent.Add(new ProductInfoHeaderValue("Blazix.Docs", null));
            if (Environment.GetEnvironmentVariable("GITHUB_TOKEN") is { Length: > 0 } token)
            {
                http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            }
        }
        return http;
    }

    // 1234 -> 1k and 107500 -> 108k, as shadcn's docs show it.
    private static string Format(int stars) => stars >= 1000
        ? Math.Round(stars / 1000d, MidpointRounding.AwayFromZero).ToString(CultureInfo.InvariantCulture) + "k"
        : stars.ToString(CultureInfo.InvariantCulture);

    private sealed record Repo([property: JsonPropertyName("stargazers_count")] int StargazersCount);
}
