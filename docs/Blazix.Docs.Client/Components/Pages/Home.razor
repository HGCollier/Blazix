@page "/"
@using Blazix.Docs.Components.Home

<PageTitle>Blazix - The Foundation for your Design System</PageTitle>
<HeadContent><meta name="description" content="@Description" /></HeadContent>

<main id="main-content" tabindex="-1" class="flex flex-1 flex-col outline-none">
    <section class="border-border/50 md:**:[.container]:pb-8 lg:**:[.container]:pb-12 dark:border-border">
        <div class="mx-auto w-full px-2">
            <div class="container mx-auto flex max-w-[1400px] flex-col items-center gap-2 px-6 py-8 text-center md:py-16 lg:py-20 xl:gap-4">
                <a href="/docs/primitives" class="@BadgeVariants.Get(BadgeVariant.Secondary, "bg-muted")">
                    New: Headless primitives <Icon Name="arrow-right" />
                </a>
                <h1 class="max-w-4xl text-3xl leading-tight font-semibold outline-none tracking-tight text-balance text-primary lg:leading-[1.1] lg:font-semibold xl:text-5xl xl:tracking-tighter">
                    The Foundation for your Design System
                </h1>
                <p class="max-w-4xl text-base text-balance text-foreground sm:text-lg">@Description</p>
                <div class="flex w-full flex-wrap items-center justify-center gap-2 pt-2 **:data-[slot=button]:shadow-none">
                    <a href="/docs/installation" class="@ButtonVariants.Get(ButtonVariant.Default, ButtonSize.Default, "h-[35px]")">Get Started</a>
                    <a href="/docs/components" class="@ButtonVariants.Get(ButtonVariant.Secondary, ButtonSize.Default, "h-9")">View Components</a>
                    <a href="/docs/primitives" class="@ButtonVariants.Get(ButtonVariant.Ghost, ButtonSize.Default, "h-9")">View Primitives</a>
                </div>
            </div>
        </div>
    </section>
    <div class="mx-auto w-full flex-1 p-0">
        <div class="mx-auto max-w-[1400px] overflow-hidden px-4 md:px-0 lg:max-w-none">
            <section class="-mx-4 w-[140vw] overflow-hidden md:hidden">
                <img src="@Assets["images/home-light.png"]" width="2560" height="2626" alt="The home page's cards" class="block h-auto w-full dark:hidden" />
                <img src="@Assets["images/home-dark.png"]" width="2560" height="2626" alt="The home page's cards" class="hidden h-auto w-full dark:block" />
            </section>
            <section class="hidden md:block">
                <CardsDemo />
            </section>
        </div>
    </div>
</main>

@code {
    private const string Description =
        "Blazor components with thoughtful defaults, built on headless primitives you can style any way you like. Start from the components, or compose the primitives into a library of your own.";
}
