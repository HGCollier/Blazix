@page "/docs/dark-mode"

<DocsPage Title="Dark Mode" Description="Adding dark mode to your site.">
    <p>
        The theme&apos;s dark tokens apply under a <code>.dark</code> class. Put it on <code>&lt;html&gt;</code> to darken the whole app, or on any
        element to darken part of it: popups render in the top layer but stay inside that element, so they follow along.
    </p>
    <DocsHeading Title="Setup" />
    <Steps>
        <Step>Apply the saved theme before the page paints</Step>
        <p>Add a script to the <code>&lt;head&gt;</code> of <code>App.razor</code>. It runs before anything shows, so there&apos;s no flash of the wrong theme.</p>
        <CodeFigure Code="@HeadCode" Title="Components/App.razor" LineNumbers="true" />
        <Step>Add a toggle script</Step>
        <p>The theme lives on <code>&lt;html&gt;</code>, which a Blazor app doesn&apos;t render interactively, so a small module switches it. It also saves the choice; if storage is turned off, the toggle still works for the current page.</p>
        <CodeFigure Code="@ScriptCode" Language="js" Title="wwwroot/theme.js" LineNumbers="true" />
        <Step>Add a mode toggle</Step>
        <p>Place a toggle on your site to switch between light and dark mode.</p>
        <CodeFigure Code="@ToggleCode" Title="Components/Layout/ModeToggle.razor" LineNumbers="true" />
    </Steps>
</DocsPage>

@code {
    private const string HeadCode = """
        <head>
            ...
            <script>
                try {
                    const dark = localStorage.theme === 'dark' ||
                        (!('theme' in localStorage) && matchMedia('(prefers-color-scheme: dark)').matches);
                    document.documentElement.classList.toggle('dark', dark);
                } catch (_) {}
            </script>
        </head>
        """;

    private const string ScriptCode = """
        export function toggleTheme() {
          const dark = !document.documentElement.classList.contains('dark');
          document.documentElement.classList.toggle('dark', dark);
          try {
            localStorage.theme = dark ? 'dark' : 'light';
          } catch {}
        }
        """;

    private const string ToggleCode = """
        @inject IJSRuntime JS
        @using Blazix.Icons
        @using Blazix.Icons.Lucide

        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" @onclick="ToggleAsync">
            <Icon Data="LucideIcons.Sun" aria-hidden="true" class="hidden dark:block" />
            <Icon Data="LucideIcons.Moon" aria-hidden="true" class="dark:hidden" />
            <span class="sr-only">Toggle theme</span>
        </Button>

        @code {
            private IJSObjectReference? _module;

            private async Task ToggleAsync()
            {
                _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./theme.js");
                await _module.InvokeVoidAsync("toggleTheme");
            }
        }
        """;
}
