@page "/docs/components/collapsible"

<DocsPage Title="Collapsible" Description="An interactive component which expands/collapses a panel.">
    <ComponentPreview Name="collapsible-demo" Align="start" />
    <DocsHeading Title="Installation" />
    <InstallationTabs Name="collapsible" />
    <DocsHeading Title="Usage" />
    <CodeFigure Code="@UsageCode" LineNumbers="true" />
    <DocsHeading Title="Composition" />
    <p>Use the following composition to build a <code>Collapsible</code>:</p>
    <CodeFigure Code="@CompositionCode" Language="text" />
    <DocsHeading Title="Controlled State" />
    <p>Use the <code>Open</code> and <code>OpenChanged</code> parameters to control the state.</p>
    <CodeFigure Code="@ControlledStateCode" LineNumbers="true" />
    <DocsHeading Title="Basic" />
    <ComponentPreview Name="collapsible-basic" Align="start" />
    <DocsHeading Title="Settings Panel" />
    <p>Use a trigger button to reveal additional settings.</p>
    <ComponentPreview Name="collapsible-settings" />
    <DocsHeading Title="File Tree" />
    <p>Use nested collapsibles to build a file tree. In a conversation, this is the File Tree pattern.</p>
    <ComponentPreview Name="collapsible-file-tree" PreviewClass="min-h-[36rem]" />
    <DocsHeading Title="RTL" />
    <p>To enable RTL support in Blazix, see the <a href="/docs/rtl">RTL configuration guide</a>.</p>
    <ComponentPreview Name="collapsible-rtl" Direction="rtl" />
    <DocsHeading Title="API Reference" />
    <ApiReference Name="collapsible" />
</DocsPage>

@code {
    private const string UsageCode = """
        <Collapsible>
            <CollapsibleTrigger>Can I use this in my project?</CollapsibleTrigger>
            <CollapsibleContent>Yes. Free to use for personal and commercial projects. No attribution required.</CollapsibleContent>
        </Collapsible>
        """;

    private const string CompositionCode = """
        Collapsible
        ├── CollapsibleTrigger
        └── CollapsibleContent
        """;

    private const string ControlledStateCode = """
        <Collapsible @bind-Open="_open">
            <CollapsibleTrigger>Toggle</CollapsibleTrigger>
            <CollapsibleContent>Content</CollapsibleContent>
        </Collapsible>

        @code {
            private bool _open;
        }
        """;
}
