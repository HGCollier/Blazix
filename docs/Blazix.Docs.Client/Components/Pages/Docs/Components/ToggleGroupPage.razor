@page "/docs/components/toggle-group"

<DocsPage Title="Toggle Group" Description="A set of two-state buttons that can be toggled on or off.">
    <ComponentPreview Name="toggle-group-demo" />
    <DocsHeading Title="Installation" />
    <InstallationTabs Name="toggle-group" />
    <DocsHeading Title="Usage" />
    <CodeFigure Code="@UsageCode" />
    <DocsHeading Title="Composition" />
    <p>Use the following composition to build a <code>ToggleGroup</code>:</p>
    <CodeFigure Code="@CompositionCode" Language="text" />
    <DocsHeading Title="Outline" />
    <p>Use <code>variant="outline"</code> for an outline style.</p>
    <ComponentPreview Name="toggle-group-outline" />
    <DocsHeading Title="Size" />
    <p>Use the <code>Size</code> parameter to change the size of the toggle group.</p>
    <ComponentPreview Name="toggle-group-sizes" />
    <DocsHeading Title="Spacing" />
    <p>Use <code>Spacing</code> to add spacing between toggle group items.</p>
    <ComponentPreview Name="toggle-group-spacing" />
    <DocsHeading Title="Vertical" />
    <p>Use <code>orientation="vertical"</code> for vertical toggle groups.</p>
    <ComponentPreview Name="toggle-group-vertical" />
    <DocsHeading Title="Disabled" />
    <ComponentPreview Name="toggle-group-disabled" />
    <DocsHeading Title="Custom" />
    <p>A custom toggle group example.</p>
    <ComponentPreview Name="toggle-group-font-weight-selector" PreviewClass="*:data-[slot=field]:max-w-xs" />
    <DocsHeading Title="RTL" />
    <p>To enable RTL support in Blazix, see the <a href="/docs/rtl">RTL configuration guide</a>.</p>
    <ComponentPreview Name="toggle-group-rtl" Direction="rtl" />
    <DocsHeading Title="API Reference" />
    <ApiReference Name="toggle-group" />
    <DocsHeading Title="Changelog" />
    <DocsHeading Level="3" Title="2026-05-17 Default Spacing" />
    <p>Changed the default <code>Spacing</code> from <code>0</code> to <code>2</code> so toggle groups render with space between items by default. Use <code>spacing={0}</code> for connected items.</p>
</DocsPage>

@code {
    private const string UsageCode = """
        <ToggleGroup type="single">
            <ToggleGroupItem Value="a">A</ToggleGroupItem>
            <ToggleGroupItem Value="b">B</ToggleGroupItem>
            <ToggleGroupItem Value="c">C</ToggleGroupItem>
        </ToggleGroup>
        """;

    private const string CompositionCode = """
        ToggleGroup
        ├── ToggleGroupItem
        └── ToggleGroupItem
        """;
}
