    <ComponentPreview Name="progress-label" />
    <DocsHeading Title="Controlled" />
    <p>A progress bar that can be controlled by a slider.</p>
    <ComponentPreview Name="progress-controlled" />
    <DocsHeading Title="API Reference" />
    <ApiReference Name="progress" />
</DocsPage>

