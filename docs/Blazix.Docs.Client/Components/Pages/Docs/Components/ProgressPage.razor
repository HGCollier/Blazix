@page "/docs/components/progress"

<DocsPage Title="Progress" Description="Displays an indicator showing the completion progress of a task, typically displayed as a progress bar.">
    <ComponentPreview Name="progress-demo" />
    <DocsHeading Title="Installation" />
    <InstallationTabs Name="progress" />
    <DocsHeading Title="Usage" />
    <CodeFigure Code="@UsageCode" LineNumbers="true" />
