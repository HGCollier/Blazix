@page "/docs/components/label"

<DocsPage Title="Label" Description="Renders an accessible label associated with controls.">
    <ComponentPreview Name="label-demo" />
    <Callout>For form fields, use the <a href="/docs/components/field">Field</a> component which includes built-in label, description, and error handling.</Callout>
    <DocsHeading Title="Installation" />
    <InstallationTabs Name="label" />
    <DocsHeading Title="Usage" />
    <CodeFigure Code="@UsageCode" />
    <DocsHeading Title="Label in Field" />
    <p>For form fields, use the <a href="/docs/components/field">Field</a> component which includes built-in <code>FieldLabel</code>, <code>FieldDescription</code>, and <code>FieldError</code> components.</p>
    <CodeFigure Code="@LabelInFieldCode" />
    <ComponentPreview Name="field-demo" PreviewClass="h-[44rem]" />
    <DocsHeading Title="API Reference" />
    <ApiReference Name="label" />
</DocsPage>

@code {
    private const string UsageCode = """
        <Label for="email">Your email address</Label>
        """;

    private const string LabelInFieldCode = """
        <Field>
            <FieldLabel for="email">Your email address</FieldLabel>
            <Input id="email" />
        </Field>
        """;
}
