@code {
    private const string PreviewClass = "h-auto theme-blue bg-surface dark:bg-background p-4 min-[480px]:p-8 min-[560px]:p-10 sm:px-10 sm:py-16";

    private const string UsageCode = """
        <MessageScrollerProvider>
            <MessageScroller>
                <MessageScrollerViewport>
                    <MessageScrollerContent>
                        @foreach (var message in messages)
                        {
                            <MessageScrollerItem @key="message.Id" MessageId="@message.Id" ScrollAnchor="@(message.Role == "user")">
                                <Message />
                            </MessageScrollerItem>
                        }
                    </MessageScrollerContent>
                </MessageScrollerViewport>
                <MessageScrollerButton />
            </MessageScroller>
        </MessageScrollerProvider>
        """;

    private const string HeightCode = """
        <div class="flex h-screen flex-col">
            <MessageScrollerProvider>
                <MessageScroller Class="flex-1">...</MessageScroller>
            </MessageScrollerProvider>
        </div>
        """;

    private const string CompositionCode = """
        MessageScrollerProvider
        └── MessageScroller
            ├── MessageScrollerViewport
            │   └── MessageScrollerContent
            │       ├── MessageScrollerItem (a message, marker, or row)
            │       ├── MessageScrollerItem
            │       └── MessageScrollerItem
            └── MessageScrollerButton
        """;

    private const string AnchorCode = """
        <MessageScrollerItem MessageId="@message.Id" ScrollAnchor="@(message.Role == "user")" />
        """;

    private const string MarkerCode = """
        <MessageScrollerItem MessageId="marcus-joined" ScrollAnchor="true">
            <Marker Variant="MarkerVariant.Separator">
                <MarkerContent>Marcus joined the chat</MarkerContent>
            </Marker>
        </MessageScrollerItem>
        """;

    private const string PeekCode = """
        <MessageScrollerProvider ScrollPreviousItemPeek="64">
            <MessageScroller>...</MessageScroller>
        </MessageScrollerProvider>
        """;

    private const string AutoScrollCode = """
        <MessageScrollerProvider AutoScroll="true">
            <MessageScroller>...</MessageScroller>
        </MessageScrollerProvider>
        """;

    private const string OpeningCode = """
        <MessageScrollerProvider DefaultScrollPosition="MessageScrollerScrollPosition.LastAnchor">
            <MessageScroller>...</MessageScroller>
        </MessageScrollerProvider>
        """;

    private const string FlashCode = """
        <MessageScroller>
            <MessageScrollerViewport id="messages">
                <MessageScrollerContent>...</MessageScrollerContent>
            </MessageScrollerViewport>
            <script>
                (function () {
                    var viewport = document.getElementById("messages")
                    if (!viewport) {
                        return
                    }
                    viewport.scrollTop = viewport.scrollHeight
                    viewport.removeAttribute("data-pending-scroll")
                })()
            </script>
            <MessageScrollerButton />
        </MessageScroller>
        """;

    private const string AnimationCode = """
        <MessageScrollerItem MessageId="@message.Id" ScrollAnchor="true"
                             Class="animate-in fade-in slide-in-from-bottom-4 duration-300 motion-reduce:animate-none">
            <Message />
        </MessageScrollerItem>
        """;

    private const string CommandsCode = """
        <MessageScrollerProvider @ref="_scroller">
            <Button @onclick="() => _scroller.ScrollToMessageAsync(id)">Jump</Button>
            <MessageScroller>...</MessageScroller>
        </MessageScrollerProvider>

        @code {
            private MessageScrollerProvider _scroller = null!;
        }
        """;

    private const string VisibilityCode = """
        <MessageScrollerVisibility Context="visibility">
            <span>Current turn: @visibility.CurrentAnchorId</span>
        </MessageScrollerVisibility>
        """;

    private const string ScrollableCode = """
        <MessageScrollerScrollable Context="scroll">
            <span>@(scroll.End ? "Newer messages below" : "Up to date")</span>
        </MessageScrollerScrollable>
        """;

    private const string VirtualizeCode = """
        <MessageScrollerProvider>
            <MessageScroller>
                <MessageScrollerViewport>
                    <MessageScrollerContent Class="block min-h-full">
                        <Virtualize Items="messages" Context="message" ItemSize="86" OverscanCount="8">
                            <div @key="message.Id" class="pb-4">
                                <Message>@message.Content</Message>
                            </div>
                        </Virtualize>
                    </MessageScrollerContent>
                </MessageScrollerViewport>
                <MessageScrollerButton />
            </MessageScroller>
        </MessageScrollerProvider>
        """;

    private const string BusyCode = """
        <MessageScrollerContent aria-busy="@(status == "streaming" ? "true" : "false")">
            ...
        </MessageScrollerContent>
        """;
}
