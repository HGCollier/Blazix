<Card Class="mx-auto w-full max-w-sm data-[size=sm]:pb-0" Size="CardSize.Sm">
    <CardHeader>
        <CardTitle>Analytics</CardTitle>
        <CardDescription>
            418.2K Visitors
            <Badge>+10%</Badge>
        </CardDescription>
        <CardAction><Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm">View Analytics</Button></CardAction>
    </CardHeader>
    <svg viewBox="0 0 100 86" preserveAspectRatio="none" class="aspect-[1/0.35] w-full text-chart-1" role="img" aria-label="Visitor trend">
        <path d="@AreaPath" fill="currentColor" opacity="0.28"></path>
        <path d="@StrokePath" fill="none" stroke="currentColor" stroke-width="1.5" vectorEffect="non-scaling-stroke"></path>
    </svg>
</Card>

@code {
    private const string AreaPath = "M0 52L18 40L36 46L54 70L72 50L100 49V86H0Z";

    private const string StrokePath = "M0 52L18 40L36 46L54 70L72 50L100 49";
}
