<div class="grid w-full grid-cols-2 gap-4 xl:gap-6">
    <SidebarSection Label="Overview" Class="xl:col-start-1 xl:row-start-2">
        @Entry(LucideIcons.ChartColumn, "Analytics", active: true)
        @Entry(LucideIcons.ArrowLeftRight, "Transactions")
        @Entry(LucideIcons.TrendingUp, "Investments")
        @Entry(LucideIcons.Landmark, "Accounts")
        @Entry(LucideIcons.ChartPie, "Spending")
    </SidebarSection>
    <SidebarSection Label="Planning" Class="xl:col-start-1 xl:row-start-1">
        @Entry(LucideIcons.FileText, "Documents")
        @Entry(LucideIcons.Wallet, "Budget")
        @Entry(LucideIcons.ChartColumnIncreasing, "Reports")
        @Entry(LucideIcons.Target, "Goals")
        @Entry(LucideIcons.Calendar, "Calendar")
    </SidebarSection>
    <SidebarSection Label="Support" Class="flex xl:col-start-2 xl:row-start-1">
        @Entry(LucideIcons.CircleHelp, "Help Center")
        @Entry(LucideIcons.BookOpen, "Docs")
        @Entry(LucideIcons.MessageSquare, "Contact Us")
        @Entry(LucideIcons.Activity, "Status")
        @Entry(LucideIcons.Globe, "Community")
    </SidebarSection>
    <SidebarSection Label="Account" Class="flex xl:col-start-2 xl:row-start-2">
        @Entry(LucideIcons.User, "Profile")
        @Entry(LucideIcons.CreditCard, "Billing", active: true)
        @Entry(LucideIcons.Bell, "Notifications")
        @Entry(LucideIcons.Shield, "Security")
        @Entry(LucideIcons.Palette, "Appearance")
    </SidebarSection>
</div>

@code {
    private static RenderFragment Entry(IconData icon, string label, bool active = false) =>
        @<SidebarMenuItem>
            <SidebarMenuButton IsActive="@active">
                <Icon Data="@icon" />
                @label
            </SidebarMenuButton>
        </SidebarMenuItem>;
}
