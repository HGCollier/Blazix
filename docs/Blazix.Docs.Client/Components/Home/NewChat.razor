<Card Class="mx-auto h-140 w-full max-w-sm gap-0">
    <CardHeader Class="gap-1 border-b">
        <CardTitle>New Chat</CardTitle>
        <CardDescription>How can I help you today?</CardDescription>
        <CardAction>
            <Tooltip>
                <TooltipTrigger>
                    <Render Context="trigger">
                        <Button @attributes="trigger.Attributes" Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" aria-label="Reset conversation">
                            <Icon Data="LucideIcons.RotateCw" />
                        </Button>
                    </Render>
                </TooltipTrigger>
                <TooltipContent><p>Reset</p></TooltipContent>
            </Tooltip>
        </CardAction>
    </CardHeader>
    <CardContent Class="flex-1 overflow-hidden p-0">
        <Empty Class="h-full">
            <EmptyHeader>
                <EmptyMedia Variant="EmptyMediaVariant.Icon"><Icon Data="LucideIcons.MessageCircleDashed" /></EmptyMedia>
                <EmptyTitle>Good morning!</EmptyTitle>
                <EmptyDescription>What are we working on today? Press send to start a new conversation</EmptyDescription>
            </EmptyHeader>
        </Empty>
    </CardContent>
    <CardFooter Class="flex-col gap-2">
        <div class="w-full">
            <InputGroup>
                <div class="h-14 w-full px-3 py-2.5">
                    <span class="line-clamp-2 opacity-60 data-[status=ready]:opacity-100" data-status="ready">
                        I&apos;m building a chat for our app and the scroll behavior is driving me nuts. Every time the AI streams a reply, the whole thread jumps around.
                    </span>
                </div>
                <InputGroupAddon Align="InputGroupAddonAlign.BlockEnd" Class="pt-1">
                    <DropdownMenu>
                        <DropdownMenuTrigger>
                            <Render Context="trigger">
                                <InputGroupButton @attributes="trigger.Attributes" aria-label="Add files" Size="InputGroupButtonSize.IconSm" Variant="ButtonVariant.Outline">
                                    <Icon Data="LucideIcons.Plus" />
                                </InputGroupButton>
                            </Render>
                        </DropdownMenuTrigger>
                        <DropdownMenuContent Align="Align.Start" Side="Side.Top" Class="w-44">
                            <DropdownMenuItem><Icon Data="LucideIcons.Paperclip" />Add Photos &amp; Files</DropdownMenuItem>
                            <DropdownMenuSeparator />
                            <DropdownMenuItem><Icon Data="LucideIcons.Image" />Create Image</DropdownMenuItem>
                            <DropdownMenuItem><Icon Data="LucideIcons.Telescope" />Deep Research</DropdownMenuItem>
                            <DropdownMenuItem><Icon Data="LucideIcons.Globe" />Web Search</DropdownMenuItem>
                        </DropdownMenuContent>
                    </DropdownMenu>
                    <InputGroupButton Variant="ButtonVariant.Default" Size="InputGroupButtonSize.IconSm" Class="ml-auto">
                        <Icon Data="LucideIcons.ArrowUp" />
                        <span class="sr-only">Send</span>
                    </InputGroupButton>
                </InputGroupAddon>
            </InputGroup>
        </div>
    </CardFooter>
</Card>
