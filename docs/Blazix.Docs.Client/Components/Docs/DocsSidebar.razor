@implements IDisposable
@inject NavigationManager Navigation
@inject SiteScript Site

<Sidebar Collapsible="SidebarCollapsible.None"
         Class="sticky top-[calc(var(--header-height)+0.6rem)] z-30 hidden h-[calc(100svh-10rem)] overflow-hidden overscroll-none bg-transparent [--sidebar-menu-width:--spacing(56)] lg:flex">
    <div class="absolute top-12 right-2 bottom-0 hidden h-full w-px bg-[linear-gradient(to_bottom,transparent_0%,var(--border)_10%,var(--border)_90%,transparent_100%)] lg:flex"></div>
    <nav @ref="_content" aria-label="Docs" data-slot="sidebar-content" data-sidebar="content"
         class="no-scrollbar flex min-h-0 w-(--sidebar-menu-width) flex-1 flex-col gap-0 overflow-auto overflow-x-hidden pl-2.5 scroll-fade">
        @foreach (var (group, index) in (DocsNav.SetFor(Path)?.Groups ?? DocsNav.ComponentsSet.Groups).Select((g, i) => (g, i)))
        {
            <SidebarGroup Class="@(index == 0 ? "pt-12" : null)">
                <SidebarGroupLabel Class="font-medium text-muted-foreground">@group.Title</SidebarGroupLabel>
                <SidebarGroupContent>
                    <SidebarMenu Class="gap-0.5">
                        @foreach (var page in group.Pages)
                        {
                            <DocsSidebarLink Page="page" Active="@(page.Href == Path)" />
                        }
                    </SidebarMenu>
                </SidebarGroupContent>
            </SidebarGroup>
        }
    </nav>
</Sidebar>

@code {
    private ElementReference _content;
    private bool _reveal = true;

    private string Path => DocsNav.CurrentPath(Navigation);

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _reveal = true;
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_reveal)
        {
            _reveal = false;
            var module = await Site.GetAsync(Assets["site.js"]);
            await module.InvokeVoidAsync("revealActive", _content);
        }
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
