<tr>
    <td class="align-top whitespace-normal!">
        <code>@Name</code>
        <p class="mt-1.5 max-w-xs text-[0.8rem] leading-normal text-muted-foreground">@ChildContent</p>
    </td>
    <td class="align-top whitespace-normal! [overflow-wrap:anywhere]">
        @if (Type is not null)
        {
            <code>@Type</code>
        }
        else
        {
            <span class="text-muted-foreground">-</span>
        }
    </td>
</tr>

@code {
    /// <summary>The attribute or variable, e.g. "data-open" or "--anchor-width".</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    /// <summary>The values it takes, e.g. "'horizontal' | 'vertical'". Leave it out for attributes that are only present or absent.</summary>
    [Parameter] public string? Type { get; set; }

    /// <summary>What it means.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
