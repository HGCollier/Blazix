<DynamicHeading Level="@Level" Id="@HeadingId" Class="@Class">
    <a class="group no-underline" href="@($"#{HeadingId}")">
        <span class="underline-offset-4 group-hover:underline">@Inline.Render(Title)</span>
        <span aria-hidden="true" class="ml-2 text-muted-foreground opacity-0 group-hover:opacity-100">#</span>
    </a>
</DynamicHeading>

@code {
    [CascadingParameter] private DocsPageState? Page { get; set; }

    [Parameter] public int Level { get; set; } = 2;

    /// <summary>The heading, with `code` in backticks.</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>Defaults to the title in kebab case: "API Reference" → "api-reference".</summary>
    [Parameter] public string? Id { get; set; }

    /// <summary>Leave it out of the table of contents.</summary>
    [Parameter] public bool NoToc { get; set; }

    [Parameter] public string? Class { get; set; }

    private string HeadingId => Id ?? Inline.Slug(Title);

    protected override void OnInitialized()
    {
        if (!NoToc && Level <= 3)
        {
            Page?.Add(new TocEntry(HeadingId, Title, Level));
        }
    }
}
