<DocsHeading Level="3" Title="@_part.Name" />
<p>
    @if (_part.Summary is not null)
    {
        @((MarkupString)_part.Summary)
        @(" ")
    }
    @if (_part.Kind == ApiPartKind.NoElement)
    {
        @("Doesn't render its own HTML element.")
    }
    else if (_part is { Kind: ApiPartKind.Element, Element: { } element })
    {
        @("Renders a ")<code>@($"<{element}>")</code>@(" element.")
    }
</p>
@ChildContent
@if (_part.Parameters.Count > 0)
{
    <DocsTable>
        <table>
            <thead>
                <tr><th>Parameter</th><th>Type</th><th>Default</th></tr>
            </thead>
            <tbody>
                @foreach (var parameter in _part.Parameters)
                {
                    <tr>
                        <td class="align-top whitespace-normal!">
                            <code>@parameter.Name</code>
                            @if (parameter.Required)
                            {
                                <span class="ml-1 text-xs text-muted-foreground">required</span>
                            }
                            @if (parameter.Summary is not null)
                            {
                                <p class="mt-1.5 max-w-xs text-[0.8rem] leading-normal text-muted-foreground">@((MarkupString)parameter.Summary)</p>
                            }
                        </td>
                        <td class="align-top whitespace-normal! [overflow-wrap:anywhere]"><code>@parameter.Type</code></td>
                        <td class="align-top">
                            @if (parameter.Default is not null)
                            {
                                <code>@parameter.Default</code>
                            }
                            else
                            {
                                <span class="text-muted-foreground">-</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </DocsTable>
}
@if (_part is { PassesAttributes: true, Kind: ApiPartKind.Element })
{
    <p class="mt-4 text-sm leading-relaxed text-muted-foreground">Other attributes are passed to the element it renders.</p>
}
@if (DataAttributes is not null)
{
    <DocsTable>
        <table>
            <thead>
                <tr><th>Attribute</th><th>Type</th></tr>
            </thead>
            <tbody>@DataAttributes</tbody>
        </table>
    </DocsTable>
}
@if (CssVariables is not null)
{
    <DocsTable>
        <table>
            <thead>
                <tr><th>CSS variable</th><th>Type</th></tr>
            </thead>
            <tbody>@CssVariables</tbody>
        </table>
    </DocsTable>
}

@code {
    private ApiPart _part = null!;

    /// <summary>The part, e.g. <c>typeof(AccordionRoot)</c>.</summary>
    [Parameter, EditorRequired] public Type Type { get; set; } = null!;

    /// <summary>Notes below the summary, before the parameters.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>The data attributes the part renders: StyleHook rows.</summary>
    [Parameter] public RenderFragment? DataAttributes { get; set; }

    /// <summary>The CSS variables the part sets: StyleHook rows.</summary>
    [Parameter] public RenderFragment? CssVariables { get; set; }

    protected override void OnParametersSet() => _part = ApiReader.Part(Type);
}
