@*
    The active styles use data-[active], not data-active: an attribute selector such as data-[active=true] outranks
    hover:, so the current page keeps its background on hover. The data-active variant is wrapped in :where() and would lose to hover:.
*@
<SidebarMenuItem>
    <SidebarMenuButton IsActive="@Active"
                       Class="relative h-[30px] w-fit overflow-visible border border-transparent text-[0.8rem] font-medium after:absolute after:inset-x-0 after:-inset-y-1 after:z-0 after:rounded-md data-[active]:border-accent data-[active]:bg-accent">
        <Render Context="link">
            <a @attributes="link.Attributes" href="@Page.Href">
                <span class="absolute inset-0 flex w-(--sidebar-menu-width) bg-transparent"></span>
                @Page.Title
                @if (Page.IsNew)
                {
                    <span aria-hidden="true" class="flex size-2 rounded-full bg-blue-500" title="New"></span>
                    <span class="sr-only">(new)</span>
                }
            </a>
        </Render>
    </SidebarMenuButton>
</SidebarMenuItem>

@code {
    [Parameter, EditorRequired] public DocsLink Page { get; set; } = null!;
    [Parameter] public bool Active { get; set; }
}
