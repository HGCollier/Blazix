<Project Sdk="Microsoft.NET.Sdk">

  <!-- Hugeicons (@hugeicons/core-free-icons 4.4.0 on npm), generated on build: see ../Blazix.Icons.Set.targets. -->
  <PropertyGroup>
    <IconSet>hugeicons</IconSet>
    <PackageId>Blazix.Icons.Hugeicons</PackageId>
    <Description>Hugeicons for Blazor: 6,100 icons as inline SVG, for Blazix.Icons' Icon component. Trimming keeps only the icons you use.</Description>
    <!-- Blazix's code is MIT; the icons are MIT. -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <Import Project="..\Blazix.Icons.Set.targets" />

</Project>
