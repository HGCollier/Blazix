<Project Sdk="Microsoft.NET.Sdk">

  <!-- Phosphor Icons (@phosphor-icons/core 2.1.1 on npm), generated on build: see ../Blazix.Icons.Set.targets. -->
  <PropertyGroup>
    <IconSet>phosphor</IconSet>
    <PackageId>Blazix.Icons.Phosphor</PackageId>
    <Description>Phosphor Icons for Blazor: 9,000 icons as inline SVG, for Blazix.Icons' Icon component. Trimming keeps only the icons you use.</Description>
    <!-- Blazix's code is MIT; the icons are MIT. -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <Import Project="..\Blazix.Icons.Set.targets" />

</Project>
