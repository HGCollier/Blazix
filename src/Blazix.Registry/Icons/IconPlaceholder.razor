@namespace Blazix.Registry
@using Blazix.Icons

@*
    An icon of the components, named in every set Blazix supports, like shadcn/ui's IconPlaceholder. Never copied:
    `blazix add` replaces each one with an Icon of the set in blazix.json's "iconLibrary", from that set's package
    (Blazix.Cli's Icons.cs), keeping the other attributes. Here it draws the Lucide icon from RegistryIcons.g.cs through
    the same Icon component, so the docs show what a copy renders.

    Name an icon in all six sets, as each names its files (lucide.dev, tabler.io/icons, hugeicons.com,
    phosphoricons.com, remixicon.com, fontawesome.com: solid unless "regular/…"), then regenerate
    RegistryIcons.g.cs (the command is at its top). Every placeholder is aria-hidden="true", or named (role and
    aria-label, or aria-labelledby), or takes its attributes from @attributes: the docs build checks.
*@
<Icon Data="@Drawing" @attributes="AdditionalAttributes" />

@code {
    /// <summary>The Lucide icon (lucide.dev), which the docs render and `add` copies by default.</summary>
    [Parameter, EditorRequired] public string Lucide { get; set; } = "";

    /// <summary>The Tabler icon (outline).</summary>
    [Parameter, EditorRequired] public string Tabler { get; set; } = "";

    /// <summary>The Hugeicons icon (free, stroke rounded).</summary>
    [Parameter, EditorRequired] public string Hugeicons { get; set; } = "";

    /// <summary>The Phosphor icon (regular weight).</summary>
    [Parameter, EditorRequired] public string Phosphor { get; set; } = "";

    /// <summary>The Remix Icon icon (a -line one).</summary>
    [Parameter, EditorRequired] public string Remixicon { get; set; } = "";

    /// <summary>The Font Awesome Free icon (solid, unless "regular/…").</summary>
    [Parameter, EditorRequired] public string FontAwesome { get; set; } = "";

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private IconData Drawing
    {
        get
        {
            var icon = RegistryIcons.Sets["lucide"].Icons.TryGetValue(Lucide, out var found)
                ? found
                : throw new InvalidOperationException($"No Lucide icon '{Lucide}' in RegistryIcons.g.cs: regenerate it.");
            return new IconData(icon.ViewBox, icon.Body, icon.Fill ? IconStyle.Fill : IconStyle.Stroke);
        }
    }
}
