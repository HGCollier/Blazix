<DropdownMenuRadioGroup data-slot="menubar-radio-group" @attributes="AdditionalAttributes"
                        Value="@Value" ValueChanged="@ValueChanged" Disabled="@Disabled" Class="@Class">
    @ChildContent
</DropdownMenuRadioGroup>

@code {
    /// <summary>The checked item's value. Supports <c>@bind-Value</c>.</summary>
    [Parameter] public string? Value { get; set; }

    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
