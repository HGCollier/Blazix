@using Blazix.Primitives
@using Microsoft.JSInterop
@using static Blazix.Registry.ClassNames

@*
    Its state is kept in the sidebar_state cookie: read it when the page renders and pass it as DefaultOpen to start
    the way the user left it.
*@
<CascadingValue Value="@_context">
    <MediaQuery Query="(max-width: 767px)" MatchesChanged="OnMobileChangedAsync" />
    <KeyboardShortcut Key="@KeyboardShortcut" OnPressed="@(() => _context.ToggleAsync())" />
    <div data-slot="sidebar-wrapper" @attributes="AdditionalAttributes"
         style="@($"--sidebar-width:{Width};--sidebar-width-icon:{WidthIcon};{Style}")"
         class="@Cn("group/sidebar-wrapper flex min-h-svh w-full has-data-[variant=inset]:bg-sidebar", Class)">
        @ChildContent
    </div>
</CascadingValue>

@code {
    /// <summary>The cookie the state is kept in: read it when the page renders and pass it as DefaultOpen.</summary>
    // ReSharper disable once MemberCanBePrivate.Global
    public const string CookieName = "sidebar_state";
    private const string Width = "16rem";
    public const string WidthMobile = "18rem";
    private const string WidthIcon = "3rem";
    private const string KeyboardShortcut = "b";
    private static readonly TimeSpan CookieMaxAge = TimeSpan.FromDays(7);

    private SidebarContext _context = null!;
    private bool _open;

    [Inject] private IJSRuntime JsRuntime { get; set; } = null!;

    /// <summary>Whether the sidebar starts expanded, when uncontrolled. Defaults to true.</summary>
    [Parameter] public bool DefaultOpen { get; set; } = true;

    /// <summary>Whether the sidebar is expanded. Supports <c>@bind-Open</c>; leave unset to let the provider manage it.</summary>
    [Parameter] public bool? Open { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>More inline style for the wrapper, e.g. <c>--sidebar-width:20rem</c>.</summary>
    [Parameter] public string? Style { get; set; }

    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    protected override void OnInitialized()
    {
        _open = DefaultOpen;
        _context = new SidebarContext(SetOpenAsync, SetOpenMobileAsync);
    }

    protected override void OnParametersSet() => _context.Open = Open ?? _open;

    private async Task SetOpenAsync(bool open)
    {
        _open = open;
        _context.Open = Open is null ? open : _context.Open;
        await OpenChanged.InvokeAsync(open);
        StateHasChanged();
        await BrowserCookies.SetAsync(JsRuntime, CookieName, open ? "true" : "false", CookieMaxAge);
    }

    private Task SetOpenMobileAsync(bool open)
    {
        _context.OpenMobile = open;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void OnMobileChangedAsync(bool mobile)
    {
        _context.IsMobile = mobile;
        StateHasChanged();
    }
}
