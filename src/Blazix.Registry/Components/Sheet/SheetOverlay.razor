@namespace Blazix.Registry
@using Blazix.Primitives
@using static Blazix.Registry.ClassNames

<DialogBackdrop data-slot="sheet-overlay" @attributes="AdditionalAttributes"
                class="@Cn(
                    "fixed inset-0 z-50 bg-black/10 transition-opacity duration-150 data-ending-style:opacity-0 data-starting-style:opacity-0 " +
                    "supports-backdrop-filter:backdrop-blur-xs",
                    Class)" />

@code {
    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
