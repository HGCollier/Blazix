@namespace Blazix.Registry
@using System.Globalization
@using Microsoft.JSInterop
@using static Blazix.Registry.ClassNames
@implements IAsyncDisposable

@{ Compute(); }
<div @ref="_root" data-slot="calendar" lang="@Culture.Name" data-mode="@ModeName" data-required="@(Required ? "true" : null)"
     data-multiple-months="@(NumberOfMonths > 1 ? "true" : null)" data-week-numbers="@(ShowWeekNumber ? "true" : null)"
     @attributes="AdditionalAttributes"
     class="@Cn("w-fit rdp-root",
                "group/calendar bg-background p-2 [--cell-radius:var(--radius-md)] [--cell-size:--spacing(7)] in-data-[slot=card-content]:bg-transparent in-data-[slot=popover-content]:bg-transparent",
                @"rtl:**:[.rdp-button\_next>svg]:rotate-180 rtl:**:[.rdp-button\_previous>svg]:rotate-180",
                Class)">
    <div class="relative flex flex-col gap-4 md:flex-row rdp-months">
        <nav aria-label="Month navigation" class="absolute inset-x-0 top-0 flex w-full items-center justify-between gap-1 rdp-nav">
            <button type="button" class="@ButtonVariants.Get(ButtonVariant, ButtonSize.Default, "size-(--cell-size) p-0 select-none aria-disabled:opacity-50 rdp-button_previous")"
                    tabindex="@(_previousMonth is null ? "-1" : null)" aria-disabled="@(_previousMonth is null ? "true" : null)"
                    aria-label="Go to the Previous Month" @onclick="() => GoToMonthAsync(_previousMonth)">
                <IconPlaceholder Lucide="chevron-left" Tabler="chevron-left" Hugeicons="arrow-left-01" Phosphor="caret-left" Remixicon="arrow-left-s-line" FontAwesome="chevron-left"
                                 aria-hidden="true" class="size-4 cn-rtl-flip rdp-chevron" />
            </button>
            <button type="button" class="@ButtonVariants.Get(ButtonVariant, ButtonSize.Default, "size-(--cell-size) p-0 select-none aria-disabled:opacity-50 rdp-button_next")"
                    tabindex="@(_nextMonth is null ? "-1" : null)" aria-disabled="@(_nextMonth is null ? "true" : null)"
                    aria-label="Go to the Next Month" @onclick="() => GoToMonthAsync(_nextMonth)">
                <IconPlaceholder Lucide="chevron-right" Tabler="chevron-right" Hugeicons="arrow-right-01" Phosphor="caret-right" Remixicon="arrow-right-s-line" FontAwesome="chevron-right"
                                 aria-hidden="true" class="size-4 cn-rtl-flip rdp-chevron" />
            </button>
        </nav>
        @for (var index = 0; index < _months.Count; index++)
        {
            var (month, weeks) = _months[index];
            var offset = index;
            <div class="flex w-full flex-col gap-4 rdp-month">
                <div class="flex h-(--cell-size) w-full items-center justify-center px-(--cell-size) rdp-month_caption">
                    @if (CaptionLayout == CalendarCaptionLayout.Label)
                    {
                        <span class="font-medium select-none text-sm rdp-caption_label" role="status" aria-live="polite">@Caption(month)</span>
                    }
                    else
                    {
                        <div class="flex h-(--cell-size) w-full items-center justify-center gap-1.5 text-sm font-medium rdp-dropdowns">
                            @if (Culture.DateTimeFormat.YearMonthPattern.StartsWith('y'))
                            {
                                @YearControl(month, offset)
                                @MonthControl(month, offset)
                            }
                            else
                            {
                                @MonthControl(month, offset)
                                @YearControl(month, offset)
                            }
                            <span role="status" aria-live="polite"
                                  style="border:0;clip:rect(0 0 0 0);height:1px;margin:-1px;overflow:hidden;padding:0;position:absolute;width:1px;white-space:nowrap;word-wrap:normal">@Caption(month)</span>
                        </div>
                    }
                </div>
                <table role="grid" aria-multiselectable="@(Mode is CalendarMode.Multiple or CalendarMode.Range ? "true" : "false")"
                       aria-label="@Caption(month)" class="w-full border-collapse rdp-month_grid">
                    <thead aria-hidden="true">
                        <tr class="flex rdp-weekdays">
                            @if (ShowWeekNumber)
                            {
                                <th aria-label="Week Number" class="w-(--cell-size) select-none rdp-week_number_header" scope="col"></th>
                            }
                            @for (var i = 0; i < 7; i++)
                            {
                                var weekday = (int)(Culture.DateTimeFormat.FirstDayOfWeek + i) % 7;
                                <th aria-label="@Culture.DateTimeFormat.DayNames[weekday]" scope="col"
                                    class="flex-1 rounded-(--cell-radius) text-[0.8rem] font-normal text-muted-foreground select-none rdp-weekday">@WeekdayName(weekday)</th>
                            }
                        </tr>
                    </thead>
                    <tbody class="rdp-weeks">
                        @foreach (var week in weeks)
                        {
                            <tr class="mt-2 flex w-full rdp-week">
                                @if (ShowWeekNumber)
                                {
                                    var weekNumber = WeekNumber(week[0].Date);
                                    <th aria-label="@($"Week {weekNumber}")" class="text-[0.8rem] font-normal text-muted-foreground select-none rdp-week_number" scope="row">
                                        <div class="flex size-(--cell-size) items-center justify-center text-center">@weekNumber.ToString("00", CultureInfo.InvariantCulture)</div>
                                    </th>
                                }
                                @foreach (var day in week)
                                {
                                    var m = Modify(day);
                                    var interactive = Mode is not null;
                                    <td @key="day" class="@DayClass(m)" role="gridcell" aria-selected="@(m.Selected ? "true" : null)"
                                        aria-label="@(!interactive && !m.Hidden ? Label(day.Date, m.Today, false) : null)"
                                        data-day="@day.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
                                        data-month="@(day.Outside ? day.Date.ToString("yyyy-MM", CultureInfo.InvariantCulture) : null)"
                                        data-selected="@True(m.Selected)" data-disabled="@True(m.Disabled)" data-hidden="@True(m.Hidden)"
                                        data-outside="@True(m.Outside)" data-focused="@True(m.Focused)" data-today="@True(m.Today)">
                                        @if (m.Hidden)
                                        {
                                            // Hidden days stay empty.
                                        }
                                        else if (interactive)
                                        {
                                            var props = new CalendarDayButtonProps(day, m, DayButtonAttributes(day, m));
                                            if (DayButton is null)
                                            {
                                                <CalendarDayButton @attributes="props.Attributes">@day.Date.Day</CalendarDayButton>
                                            }
                                            else
                                            {
                                                @DayButton(props)
                                            }
                                        }
                                        else
                                        {
                                            @day.Date.Day
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    internal static readonly CultureInfo DefaultLocale = CultureInfo.GetCultureInfo("en-US");

    private const string DayBase =
        "group/day relative aspect-square h-full w-full rounded-(--cell-radius) p-0 text-center select-none [&:last-child[data-selected=true]_button]:rounded-r-(--cell-radius) ";

    private ElementReference _root;
    private IJSObjectReference? _module;
    private IJSObjectReference? _calendar;
    private bool _focusPending;

    private bool _initialized;
    private DateOnly _month;
    private DateOnly? _selected;
    private IReadOnlyList<DateOnly>? _selectedDates;
    private DateRange? _selectedRange;
    private CalendarDay? _focused;
    private CalendarDay? _lastFocused;

    private DateOnly _today;
    private DateOnly? _navStart;
    private DateOnly? _navEnd;
    private DateOnly? _previousMonth;
    private DateOnly? _nextMonth;
    private List<(DateOnly Month, List<CalendarDay[]> Weeks)> _months = [];
    private CalendarDay? _focusTarget;

    [Inject] private IJSRuntime JsRuntime { get; set; } = null!;

    /// <summary>How days are selected. Leave null for a calendar that only displays dates.</summary>
    [Parameter] public CalendarMode? Mode { get; set; }

    /// <summary>The selected day in single mode. Bind it with <c>@bind-Selected</c>.</summary>
    [Parameter] public DateOnly? Selected { get; set; }

    [Parameter] public EventCallback<DateOnly?> SelectedChanged { get; set; }

    /// <summary>The selected days in multiple mode. Bind it with <c>@bind-SelectedDates</c>.</summary>
    [Parameter] public IReadOnlyList<DateOnly>? SelectedDates { get; set; }

    [Parameter] public EventCallback<IReadOnlyList<DateOnly>?> SelectedDatesChanged { get; set; }

    /// <summary>The selected range in range mode. Bind it with <c>@bind-SelectedRange</c>.</summary>
    [Parameter] public DateRange? SelectedRange { get; set; }

    [Parameter] public EventCallback<DateRange?> SelectedRangeChanged { get; set; }

    /// <summary>Keep at least one day selected: clicking the selected day doesn't clear it.</summary>
    [Parameter] public bool Required { get; set; }

    /// <summary>Days that can't be selected.</summary>
    [Parameter] public Func<DateOnly, bool>? Disabled { get; set; }

    /// <summary>Custom modifiers: a name and the days it matches. Style them with <c>ModifiersClassNames</c>.</summary>
    [Parameter] public IReadOnlyDictionary<string, Func<DateOnly, bool>>? Modifiers { get; set; }

    /// <summary>
    /// Classes for the day cells a modifier matches, by modifier name. Built-in names: focused, disabled,
    /// hidden, outside, today, selected, range_start, range_end, range_middle. A class replaces the default one.
    /// </summary>
    [Parameter] public IReadOnlyDictionary<string, string>? ModifiersClassNames { get; set; }

    /// <summary>The first displayed month, controlled. Bind it with <c>@bind-Month</c>.</summary>
    [Parameter] public DateOnly? Month { get; set; }

    /// <summary>Called with the first day of the month when the user navigates.</summary>
    [Parameter] public EventCallback<DateOnly> MonthChanged { get; set; }

    /// <summary>The month shown first when <c>Month</c> isn't set. Defaults to the current month.</summary>
    [Parameter] public DateOnly? DefaultMonth { get; set; }

    /// <summary>The earliest month the user can navigate to. Defaults to 100 years ago with a year dropdown.</summary>
    [Parameter] public DateOnly? StartMonth { get; set; }

    /// <summary>The latest month the user can navigate to. Defaults to the end of this year with a year dropdown.</summary>
    [Parameter] public DateOnly? EndMonth { get; set; }

    /// <summary>How many months to show side by side.</summary>
    [Parameter] public int NumberOfMonths { get; set; } = 1;

    /// <summary>Show the days of the previous and next months that fill the first and last weeks.</summary>
    [Parameter] public bool ShowOutsideDays { get; set; } = true;

    /// <summary>Always show six weeks per month.</summary>
    [Parameter] public bool FixedWeeks { get; set; }

    /// <summary>Show the week number in front of each week.</summary>
    [Parameter] public bool ShowWeekNumber { get; set; }

    /// <summary>Show the month and year as text, or as selects.</summary>
    [Parameter] public CalendarCaptionLayout CaptionLayout { get; set; } = CalendarCaptionLayout.Label;

    /// <summary>The variant of the previous and next month buttons.</summary>
    [Parameter] public ButtonVariant ButtonVariant { get; set; } = ButtonVariant.Ghost;

    /// <summary>Month and weekday names, the first day of the week and week numbering. Defaults to en-US.</summary>
    [Parameter] public CultureInfo? Locale { get; set; }

    /// <summary>The time zone (IANA or Windows id) that decides which day is today. Defaults to the server's.</summary>
    [Parameter] public string? TimeZone { get; set; }

    /// <summary>The month labels in the month dropdown. Defaults to the abbreviated name ("Jan").</summary>
    [Parameter] public Func<DateOnly, string>? FormatMonthDropdown { get; set; }

    /// <summary>Render each day's button yourself: spread <c>context.Attributes</c> onto a <c>CalendarDayButton</c>.</summary>
    [Parameter] public RenderFragment<CalendarDayButtonProps>? DayButton { get; set; }

    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>The reading direction from a <c>DirectionProvider</c>. <c>dir="rtl"</c> on the calendar wins.</summary>
    [CascadingParameter] private TextDirection? Direction { get; set; }

    private CultureInfo Culture => Locale ?? DefaultLocale;

    // react-day-picker's dir prop: Left and Right swap in right-to-left, where the week runs from the right.
    private bool Rtl => AdditionalAttributes?.TryGetValue("dir", out var dir) == true
        ? string.Equals(Convert.ToString(dir, CultureInfo.InvariantCulture), "rtl", StringComparison.OrdinalIgnoreCase)
        : Direction == TextDirection.Rtl;

    private string? ModeName => Mode?.ToString().ToLowerInvariant();

    private DateOnly? CurrentSelected => SelectedChanged.HasDelegate ? Selected : _selected;
    private IReadOnlyList<DateOnly>? CurrentSelectedDates => SelectedDatesChanged.HasDelegate ? SelectedDates : _selectedDates;
    private DateRange? CurrentSelectedRange => SelectedRangeChanged.HasDelegate ? SelectedRange : _selectedRange;

    protected override void OnParametersSet()
    {
        if (_initialized)
            return;
        _initialized = true;
        _selected = Selected;
        _selectedDates = SelectedDates;
        _selectedRange = SelectedRange;
        ComputeNav();
        _month = InitialMonth();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./_content/Blazix.Primitives/calendar.js");
            _calendar = await _module.InvokeAsync<IJSObjectReference>("attach", _root);
        }
        if (_focusPending && _calendar is not null)
        {
            _focusPending = false;
            await _calendar.InvokeVoidAsync("focusDay");
        }
    }

    // react-day-picker's getNavMonths.
    private void ComputeNav()
    {
        _today = DateOnly.FromDateTime(TimeZone is null ? DateTime.Now : TimeZoneInfo.ConvertTimeBySystemTimeZoneId(DateTime.UtcNow, TimeZone));
        var yearDropdown = CaptionLayout is CalendarCaptionLayout.Dropdown or CalendarCaptionLayout.DropdownYears;
        _navStart = StartMonth is { } start ? StartOfMonth(start) : null;
        _navEnd = EndMonth is { } end ? EndOfMonth(end) : null;
        if (yearDropdown)
        {
            _navStart ??= new DateOnly(_today.Year - 100, 1, 1);
            _navEnd ??= new DateOnly(_today.Year, 12, 31);
        }
    }

    // react-day-picker's getInitialMonth.
    private DateOnly InitialMonth()
    {
        var month = Month ?? DefaultMonth ?? _today;
        if (_navEnd is { } end && MonthsBetween(end, month) < NumberOfMonths - 1)
            month = end.AddMonths(-(NumberOfMonths - 1));
        if (_navStart is { } start && MonthsBetween(month, start) < 0)
            month = start;
        return StartOfMonth(month);
    }

    // react-day-picker's useCalendar: the displayed months, their weeks and the navigation targets.
    private void Compute()
    {
        ComputeNav();
        var first = Month is null ? _month : InitialMonth();

        var displayMonths = new List<DateOnly>();
        for (var i = 0; i < NumberOfMonths; i++)
        {
            var month = first.AddMonths(i);
            if (_navEnd is { } navEnd && month > navEnd)
                break;
            displayMonths.Add(month);
        }

        var gridStart = StartOfWeek(displayMonths[0]);
        var gridEnd = EndOfWeek(EndOfMonth(displayMonths[^1]));
        if (EndMonth is { } endMonth && gridEnd > EndOfWeek(EndOfMonth(endMonth)))
            gridEnd = EndOfWeek(EndOfMonth(endMonth));
        var dates = new List<DateOnly>();
        for (var date = gridStart; date <= gridEnd; date = date.AddDays(1))
            dates.Add(date);
        var fixedCount = 42 * displayMonths.Count;
        while (FixedWeeks && dates.Count < fixedCount)
            dates.Add(dates[^1].AddDays(1));

        _months = [];
        foreach (var month in displayMonths)
        {
            var firstDay = StartOfWeek(month);
            var lastDay = EndOfWeek(EndOfMonth(month));
            var monthDates = dates.Where(d => d >= firstDay && d <= lastDay).ToList();
            if (FixedWeeks && monthDates.Count < 42)
            {
                var extra = 42 - monthDates.Count;
                monthDates.AddRange(dates.Where(d => d > lastDay && d <= lastDay.AddDays(extra)));
            }
            _months.Add((month, monthDates.Select(d => new CalendarDay(d, month)).Chunk(7).ToList()));
        }

        _previousMonth = _navStart is { } start && MonthsBetween(first, start) <= 0 ? null : first.AddMonths(-1);
        _nextMonth = _navEnd is { } end && MonthsBetween(end, first) < NumberOfMonths ? null : first.AddMonths(1);
        _focusTarget = FocusTarget();
    }

    // react-day-picker's calculateFocusTarget: the day that gets the tab stop.
    private CalendarDay? FocusTarget()
    {
        CalendarDay? target = null;
        CalendarDay? firstFocusable = null;
        var found = -1;
        foreach (var day in _months.SelectMany(m => m.Weeks).SelectMany(w => w))
        {
            if (IsDisabled(day.Date) || IsHidden(day) || day.Outside)
                continue;
            firstFocusable ??= day;
            var priority = -1;
            if (day == _lastFocused)
                priority = 2;
            else if (IsSelected(day.Date))
                priority = 1;
            else if (day.Date == _today)
                priority = 0;
            if (priority > found)
            {
                target = day;
                found = priority;
            }
        }
        return target ?? firstFocusable;
    }

    private bool IsDisabled(DateOnly date) => Disabled?.Invoke(date) == true;

    private bool IsHidden(CalendarDay day) =>
        (_navStart is { } start && day.Date < start) ||
        (_navEnd is { } end && day.Date > end) ||
        (!ShowOutsideDays && day.Outside);

    private bool IsSelected(DateOnly date) => Mode switch
    {
        CalendarMode.Single => CurrentSelected == date,
        CalendarMode.Multiple => CurrentSelectedDates?.Contains(date) == true,
        CalendarMode.Range => CurrentSelectedRange is { } range && RangeIncludes(range, date, false),
        _ => false,
    };

    private static bool RangeIncludes(DateRange range, DateOnly date, bool excludeEnds) => range switch
    {
        { From: { } from, To: { } to } => excludeEnds ? date > from && date < to : date >= from && date <= to,
        { To: { } to } when !excludeEnds => date == to,
        { From: { } from } when !excludeEnds => date == from,
        _ => false,
    };

    private CalendarModifiers Modify(CalendarDay day)
    {
        var hidden = IsHidden(day);
        var range = Mode == CalendarMode.Range ? CurrentSelectedRange : null;
        var complete = range is { From: not null, To: not null };
        return new CalendarModifiers
        {
            Focused = !hidden && day == _focused,
            Disabled = IsDisabled(day.Date),
            Hidden = hidden,
            Outside = day.Outside,
            Today = day.Date == _today,
            Selected = IsSelected(day.Date),
            RangeStart = range is null ? null : complete && day.Date == range.From,
            RangeEnd = range is null ? null : complete && day.Date == range.To,
            RangeMiddle = range is null ? null : RangeIncludes(range, day.Date, true),
            Custom = Modifiers?.Where(modifier => modifier.Value(day.Date)).Select(modifier => modifier.Key).ToList() ?? [],
        };
    }

    // react-day-picker's getClassNamesForModifiers, with Tailwind classes. Joined, not merged, like react-day-picker.
    private string DayClass(CalendarModifiers m)
    {
        var classes = new List<string>
        {
            DayBase + (ShowWeekNumber
                ? "[&:nth-child(2)[data-selected=true]_button]:rounded-l-(--cell-radius) rdp-day"
                : "[&:first-child[data-selected=true]_button]:rounded-l-(--cell-radius) rdp-day"),
        };
        void Add(bool active, string name, string? defaultClass)
        {
            if (!active)
                return;
            if (ModifiersClassNames?.TryGetValue(name, out var custom) == true && custom.Length > 0)
                classes.Add(custom);
            else if (defaultClass is not null)
                classes.Add(defaultClass);
        }
        Add(m.Focused, "focused", "rdp-focused");
        Add(m.Disabled, "disabled", "text-muted-foreground opacity-50 rdp-disabled");
        Add(m.Hidden, "hidden", "invisible rdp-hidden");
        Add(m.Outside, "outside", "text-muted-foreground aria-selected:text-muted-foreground rdp-outside");
        Add(m.Today, "today", "rounded-(--cell-radius) bg-muted text-foreground data-[selected=true]:rounded-none rdp-today");
        foreach (var name in m.Custom)
            Add(true, name, null);
        Add(m.Selected, "selected", "rdp-selected");
        Add(m.RangeStart == true, "range_start", "relative isolate z-0 rounded-l-(--cell-radius) bg-muted after:absolute after:inset-y-0 after:right-0 after:w-4 after:bg-muted rdp-range_start");
        Add(m.RangeEnd == true, "range_end", "relative isolate z-0 rounded-r-(--cell-radius) bg-muted after:absolute after:inset-y-0 after:left-0 after:w-4 after:bg-muted rdp-range_end");
        Add(m.RangeMiddle == true, "range_middle", "rounded-none rdp-range_middle");
        return string.Join(' ', classes);
    }

    private Dictionary<string, object> DayButtonAttributes(CalendarDay day, CalendarModifiers m)
    {
        var attributes = new Dictionary<string, object>
        {
            ["Day"] = day,
            ["Modifiers"] = m,
            ["Locale"] = Culture,
            ["Disabled"] = m is { Focused: false, Disabled: true },
            ["Class"] = "rdp-day_button",
            ["tabindex"] = day == _focusTarget ? "0" : "-1",
            ["aria-label"] = Label(day.Date, m.Today, m.Selected),
            ["onclick"] = EventCallback.Factory.Create<MouseEventArgs>(this, () => ClickAsync(day, m)),
            ["onfocus"] = EventCallback.Factory.Create<FocusEventArgs>(this, () => _focused = day),
            ["onblur"] = EventCallback.Factory.Create<FocusEventArgs>(this, () =>
            {
                _lastFocused = _focused;
                _focused = null;
            }),
            ["onkeydown"] = EventCallback.Factory.Create<KeyboardEventArgs>(this, e => MoveFocusAsync(day, e)),
        };
        if (m is { Focused: true, Disabled: true })
            attributes["aria-disabled"] = "true";
        return attributes;
    }

    private async Task GoToMonthAsync(DateOnly? target)
    {
        if (target is not { } date)
            return;
        var month = StartOfMonth(date);
        if (_navStart is { } start && month < StartOfMonth(start))
            month = StartOfMonth(start);
        if (_navEnd is { } end && month > StartOfMonth(end))
            month = StartOfMonth(end);
        _month = month;
        await MonthChanged.InvokeAsync(month);
    }

    private async Task ClickAsync(CalendarDay day, CalendarModifiers m)
    {
        _focused = day;
        if (m.Disabled)
            return;
        switch (Mode)
        {
            case CalendarMode.Single:
                DateOnly? date = !Required && CurrentSelected == day.Date ? null : day.Date;
                _selected = date;
                await SelectedChanged.InvokeAsync(date);
                break;
            case CalendarMode.Multiple:
                var dates = CurrentSelectedDates ?? [];
                if (dates.Contains(day.Date))
                {
                    if (Required && dates.Count == 1)
                        return;
                    dates = dates.Where(d => d != day.Date).ToList();
                }
                else
                {
                    dates = [.. dates, day.Date];
                }
                _selectedDates = dates;
                await SelectedDatesChanged.InvokeAsync(dates);
                break;
            case CalendarMode.Range:
                var range = AddToRange(day.Date, CurrentSelectedRange, Required);
                _selectedRange = range;
                await SelectedRangeChanged.InvokeAsync(range);
                break;
        }
    }

    // react-day-picker's addToRange, without min and max.
    private static DateRange? AddToRange(DateOnly date, DateRange? range, bool required) => range switch
    {
        { From: { } from, To: null } when date < from => new(date, from),
        { From: { } from, To: null } => new(from, date),
        { From: { } from, To: { } to } when date == from && date == to => required ? range : null,
        { From: { } from, To: not null } when date == from => new(from, date),
        { From: not null, To: { } to } when date == to => new(date, date),
        { From: { } from, To: { } to } when date < from => new(date, to),
        { From: { } from, To: not null } => new(from, date),
        _ => new(date, date),
    };

    // react-day-picker's handleDayKeyDown and useFocus.moveFocus.
    private async Task MoveFocusAsync(CalendarDay day, KeyboardEventArgs e)
    {
        var (back, forward) = Rtl ? ("ArrowRight", "ArrowLeft") : ("ArrowLeft", "ArrowRight");
        Func<DateOnly, DateOnly>? move = e.Key switch
        {
            _ when e.Key == back => d => e.ShiftKey ? d.AddMonths(-1) : d.AddDays(-1),
            _ when e.Key == forward => d => e.ShiftKey ? d.AddMonths(1) : d.AddDays(1),
            "ArrowUp" => d => e.ShiftKey ? d.AddYears(-1) : d.AddDays(-7),
            "ArrowDown" => d => e.ShiftKey ? d.AddYears(1) : d.AddDays(7),
            "PageUp" => d => e.ShiftKey ? d.AddYears(-1) : d.AddMonths(-1),
            "PageDown" => d => e.ShiftKey ? d.AddYears(1) : d.AddMonths(1),
            "Home" => StartOfWeek,
            "End" => EndOfWeek,
            _ => null,
        };
        if (move is null)
            return;
        var after = e.Key == forward || e.Key is "ArrowDown" or "PageDown" or "End";

        // getNextFocus: skip disabled days, at most 365 times.
        var date = day.Date;
        for (var attempt = 0; attempt <= 365; attempt++)
        {
            date = move(date);
            if (!after && _navStart is { } start && date < start)
                date = start;
            if (after && _navEnd is { } end && date > end)
                date = end;
            if (IsDisabled(date))
                continue;

            var next = new CalendarDay(date, StartOfMonth(date));
            if (!_months.Any(m => m.Weeks.Any(w => w.Contains(next))))
                await GoToMonthAsync(date);
            _focused = next;
            _focusPending = true;
            return;
        }
    }

    private string Caption(DateOnly month) => month.ToString("Y", Culture);

    // date-fns "PPPP" ("Sunday, June 1st, 2025" in en-US), plus react-day-picker's "Today, " and ", selected".
    private string Label(DateOnly date, bool today, bool selected)
    {
        var label = Culture.Name == "en-US"
            ? $"{date.ToString("dddd, MMMM ", Culture)}{Ordinal(date.Day)}, {date.Year}"
            : date.ToString("D", Culture);
        return $"{(today ? "Today, " : "")}{label}{(selected ? ", selected" : "")}";
    }

    private static string Ordinal(int day) => day + (day % 100 is 11 or 12 or 13 ? "th" : (day % 10) switch
    {
        1 => "st",
        2 => "nd",
        3 => "rd",
        _ => "th",
    });

    private RenderFragment MonthControl(DateOnly month, int offset)
    {
        if (CaptionLayout is not (CalendarCaptionLayout.Dropdown or CalendarCaptionLayout.DropdownMonths))
            return @<span>@MonthLabel(month)</span>;
        var options = Enumerable.Range(1, 12).Select(m =>
        {
            var option = new DateOnly(month.Year, m, 1);
            var disabled = (_navStart is { } start && option < StartOfMonth(start)) || (_navEnd is { } end && option > StartOfMonth(end));
            return (m, MonthLabel(option), disabled);
        });
        return Dropdown("rdp-months_dropdown", "Choose the Month", month.Month, options,
            value => GoToMonthAsync(new DateOnly(month.Year, value, 1).AddMonths(-offset)));
    }

    private RenderFragment YearControl(DateOnly month, int offset)
    {
        if (CaptionLayout is not (CalendarCaptionLayout.Dropdown or CalendarCaptionLayout.DropdownYears))
            return @<span>@month.ToString("yyyy", Culture)</span>;
        var options = _navStart is { } start && _navEnd is { } end
            ? Enumerable.Range(start.Year, end.Year - start.Year + 1).Select(y => (y, y.ToString("0000", CultureInfo.InvariantCulture), false))
            : [];
        return Dropdown("rdp-years_dropdown", "Choose the Year", month.Year, options,
            value => GoToMonthAsync(new DateOnly(value, month.Month, 1).AddMonths(-offset)));
    }

    // react-day-picker's weekday format ("cccccc": Su, Mo, Tu): two letters of the abbreviated name. .NET's
    // ShortestDayNames are single letters (S, M, T) for en-US. Where two letters don't tell the days apart (every
    // Arabic name starts with ال), the culture's shortest names do.
    private string WeekdayName(int day) => WeekdayNames(Culture)[day];

    private static string[] WeekdayNames(CultureInfo culture)
    {
        var format = culture.DateTimeFormat;
        string[] names = [.. format.AbbreviatedDayNames.Select(n =>
        {
            var name = new StringInfo(n.TrimEnd('.'));
            return name.LengthInTextElements > 2 ? name.SubstringByTextElements(0, 2) : name.String;
        })];
        return names.Distinct().Count() == names.Length ? names : format.ShortestDayNames;
    }

    private string MonthLabel(DateOnly month) => FormatMonthDropdown?.Invoke(month) ?? month.ToString("MMM", Culture);

    // react-day-picker's Dropdown: a transparent native select over a label. The label has no box; focus still shows a ring.
    private RenderFragment Dropdown(string className, string label, int value, IEnumerable<(int Value, string Label, bool Disabled)> options, Func<int, Task> onChange)
    {
        var list = options.ToList();
        return @<span data-disabled="false" class="relative rounded-(--cell-radius) has-focus:ring-3 has-focus:ring-ring/50 rdp-dropdown_root">
            <select class="@($"absolute inset-0 bg-popover opacity-0 rdp-dropdown {className}")" aria-label="@label" value="@value"
                    @onchange="e => onChange(int.Parse((string)e.Value!, CultureInfo.InvariantCulture))">
                @foreach (var option in list)
                {
                    <option value="@option.Value" disabled="@option.Disabled">@option.Label</option>
                }
            </select>
            <span class="font-medium select-none flex items-center gap-1 rounded-(--cell-radius) text-sm [&>svg]:size-3.5 [&>svg]:text-muted-foreground rdp-caption_label" aria-hidden="true">
                @list.Find(o => o.Value == value).Label
                <IconPlaceholder Lucide="chevron-down" Tabler="chevron-down" Hugeicons="arrow-down-01" Phosphor="caret-down" Remixicon="arrow-down-s-line" FontAwesome="chevron-down"
                                 width="18" height="18" aria-hidden="true" class="size-4 rdp-chevron" />
            </span>
        </span>;
    }

    private DateOnly StartOfWeek(DateOnly date) =>
        date.AddDays(-(((int)date.DayOfWeek - (int)Culture.DateTimeFormat.FirstDayOfWeek + 7) % 7));

    private DateOnly EndOfWeek(DateOnly date) => StartOfWeek(date).AddDays(6);

    private static DateOnly StartOfMonth(DateOnly date) => new(date.Year, date.Month, 1);

    private static DateOnly EndOfMonth(DateOnly date) => new(date.Year, date.Month, DateTime.DaysInMonth(date.Year, date.Month));

    private static int MonthsBetween(DateOnly later, DateOnly earlier) => (later.Year - earlier.Year) * 12 + later.Month - earlier.Month;

    // date-fns getWeek: weeks start on the locale's first day, and week 1 contains January 1st, 4th or 7th.
    private int WeekNumber(DateOnly date)
    {
        var firstWeekContainsDate = Culture.DateTimeFormat.CalendarWeekRule switch
        {
            CalendarWeekRule.FirstFourDayWeek => 4,
            CalendarWeekRule.FirstFullWeek => 7,
            _ => 1,
        };
        DateOnly FirstWeek(int year) => StartOfWeek(new DateOnly(year, 1, firstWeekContainsDate));
        var weekYearStart = FirstWeek(date.Year + 1);
        if (date < weekYearStart)
            weekYearStart = date >= FirstWeek(date.Year) ? FirstWeek(date.Year) : FirstWeek(date.Year - 1);
        return (StartOfWeek(date).DayNumber - weekYearStart.DayNumber) / 7 + 1;
    }

    private static string? True(bool value) => value ? "true" : null;

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_calendar is not null)
            {
                await _calendar.InvokeVoidAsync("dispose");
                await _calendar.DisposeAsync();
            }
            if (_module is not null)
                await _module.DisposeAsync();
        }
        catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
        {
            // The circuit is gone; so is the page.
        }
    }
}
