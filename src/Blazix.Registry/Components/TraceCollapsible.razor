@using static Blazix.Registry.ClassNames

<Collapsible data-slot="trace-collapsible" @attributes="AdditionalAttributes" Open="@Open" OpenChanged="@OpenChanged"
             Class="@Cn("flex w-full min-w-0 flex-col", Class)">
    @ChildContent
</Collapsible>

@code {
    /// <summary>Supports <c>@bind-Open</c>.</summary>
    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
