@using Blazix.Primitives
@using static Blazix.Registry.ClassNames

<AlertDialogOverlay />
<AlertDialogPopup data-slot="alert-dialog-content" @attributes="AdditionalAttributes" Render="@Render" InitialFocus="@InitialFocus" FinalFocus="@FinalFocus"
                  data-size="@(Size == AlertDialogSize.Sm ? "sm" : "default")"
                  class="@Cn(
                      "group/alert-dialog-content fixed top-1/2 left-1/2 z-50 grid w-full -translate-x-1/2 -translate-y-1/2 gap-4 rounded-xl bg-popover p-4 text-popover-foreground ring-1 ring-foreground/10 duration-100 outline-none " +
                      "data-[size=default]:max-w-xs data-[size=sm]:max-w-xs data-[size=default]:sm:max-w-sm " +
                      "data-open:animate-in data-open:fade-in-0 data-open:zoom-in-95 data-closed:animate-out data-closed:fade-out-0 data-closed:zoom-out-95",
                      Class)">
    @ChildContent
</AlertDialogPopup>

@code {
    /// <summary>Render your own element or component; spread <c>props.Attributes</c> onto it.</summary>
    [Parameter] public RenderFragment<DialogPopupRenderProps>? Render { get; set; }

    /// <summary>Sm stacks the footer buttons in two columns.</summary>
    [Parameter] public AlertDialogSize Size { get; set; } = AlertDialogSize.Default;

    /// <summary>What gets focus on open: a CSS selector inside the dialog, "popup", or "none". Defaults to the first tabbable element.</summary>
    [Parameter] public string? InitialFocus { get; set; }

    /// <summary>The id of the element that gets focus on close. Defaults to the trigger.</summary>
    [Parameter] public string? FinalFocus { get; set; }

    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
