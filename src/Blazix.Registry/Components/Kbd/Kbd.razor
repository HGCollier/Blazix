@namespace Blazix.Registry
@using static Blazix.Registry.ClassNames

<kbd data-slot="kbd" @attributes="AdditionalAttributes"
     class="@Cn(
         "pointer-events-none inline-flex h-5 w-fit min-w-5 items-center justify-center gap-1 rounded-sm bg-muted px-1 font-sans " +
         "text-xs font-medium text-muted-foreground select-none in-data-[slot=tooltip-content]:bg-background/20 " +
         "in-data-[slot=tooltip-content]:text-background dark:in-data-[slot=tooltip-content]:bg-background/10 " +
         "[&_svg:not([class*='size-'])]:size-3",
         Class)">
    @ChildContent
</kbd>

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
