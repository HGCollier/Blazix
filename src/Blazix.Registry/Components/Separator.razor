@using Blazix.Primitives
@using static Blazix.Registry.ClassNames

<SeparatorRoot data-slot="separator" @attributes="AdditionalAttributes" Render="@Render" Orientation="@Orientation"
               class="@Cn("shrink-0 bg-border data-horizontal:h-px data-horizontal:w-full data-vertical:w-px data-vertical:self-stretch", Class)" />

@code {
    /// <summary>Render your own element or component; spread <c>props.Attributes</c> onto it.</summary>
    [Parameter] public RenderFragment<PartRenderProps>? Render { get; set; }

    [Parameter] public Orientation Orientation { get; set; } = Orientation.Horizontal;
    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
