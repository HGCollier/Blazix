@namespace Blazix.Registry
@using Blazix.Primitives

@if (Tooltip is null)
{
    <UseRender DefaultTagName="button" Render="@Render" @attributes="OwnAttributes">@ChildContent</UseRender>
}
else
{
    <Tooltip>
        <Blazix.Primitives.TooltipTrigger>
            <Render Context="trigger">
                @{ var attributes = MergeProps.Merge(trigger.Attributes, OwnAttributes); }
                @if (Render is not null)
                {
                    @Render(new UseRenderProps(attributes, null))
                }
                else
                {
                    <button @attributes="attributes">@ChildContent</button>
                }
            </Render>
        </Blazix.Primitives.TooltipTrigger>
        <TooltipContent Side="Side.Right" Align="Align.Center" hidden="@(Context.State != "collapsed" || Context.IsMobile)">@Tooltip</TooltipContent>
    </Tooltip>
}

@code {
    [CascadingParameter] private SidebarContext Context { get; set; } = null!;

    /// <summary>Render your own element or component; spread <c>props.Attributes</c> onto it.</summary>
    [Parameter] public RenderFragment<UseRenderProps>? Render { get; set; }

    /// <summary>Marks the button of the current page (<c>aria-current="page"</c>).</summary>
    [Parameter] public bool IsActive { get; set; }

    [Parameter] public SidebarMenuButtonVariant Variant { get; set; } = SidebarMenuButtonVariant.Default;
    [Parameter] public SidebarMenuButtonSize Size { get; set; } = SidebarMenuButtonSize.Default;

    /// <summary>Shown beside the button while the sidebar is collapsed to icons.</summary>
    [Parameter] public RenderFragment? Tooltip { get; set; }

    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private Dictionary<string, object> OwnAttributes
    {
        get
        {
            var attributes = new Dictionary<string, object>
            {
                ["data-slot"] = "sidebar-menu-button",
                ["data-sidebar"] = "menu-button",
                ["data-size"] = Size switch { SidebarMenuButtonSize.Sm => "sm", SidebarMenuButtonSize.Lg => "lg", _ => "default" },
            };
            if (IsActive)
            {
                attributes["data-active"] = "";
                attributes["aria-current"] = "page";
            }
            foreach (var (name, value) in AdditionalAttributes ?? new Dictionary<string, object>())
            {
                attributes[name] = value;
            }
            attributes["class"] = SidebarMenuButtonVariants.Get(Variant, Size, Class);
            return attributes;
        }
    }
}
