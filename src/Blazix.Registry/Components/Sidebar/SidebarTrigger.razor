@namespace Blazix.Registry
@using Blazix.Primitives
@using static Blazix.Registry.ClassNames

<Button data-sidebar="trigger" data-slot="sidebar-trigger" Type="@Type" Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSm" @attributes="AdditionalAttributes"
        Class="@Cn(Class)" @onclick="ToggleAsync">
    <IconPlaceholder Lucide="panel-left" Tabler="layout-sidebar" Hugeicons="sidebar-left" Phosphor="sidebar" Remixicon="side-bar-line" FontAwesome="bars"
                     aria-hidden="true" class="cn-rtl-flip" />
    <span class="sr-only">Toggle Sidebar</span>
</Button>

@code {
    [CascadingParameter] private SidebarContext Context { get; set; } = null!;

    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public ButtonType Type { get; set; } = ButtonType.button;
    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private async Task ToggleAsync(MouseEventArgs e)
    {
        await OnClick.InvokeAsync(e);
        await Context.ToggleAsync();
    }
}
