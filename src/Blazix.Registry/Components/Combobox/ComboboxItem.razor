@namespace Blazix.Registry
@using Blazix.Primitives
@using static Blazix.Registry.ClassNames

<Blazix.Primitives.ComboboxItem data-slot="combobox-item" @attributes="AdditionalAttributes" Render="@Render" Value="@Value" Label="@Label" Disabled="@Disabled"
                              class="@Cn(
                                  "relative flex w-full cursor-default items-center gap-2 rounded-md py-1 pr-8 pl-1.5 text-sm outline-hidden select-none " +
                                  "data-highlighted:bg-accent data-highlighted:ring-1 data-highlighted:ring-inset data-highlighted:ring-ring/50 data-highlighted:text-accent-foreground " +
                                  "not-data-[variant=destructive]:data-highlighted:**:text-accent-foreground data-disabled:pointer-events-none " +
                                  "data-disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4",
                                  Class)">
    @ChildContent
    <ComboboxItemIndicator class="pointer-events-none absolute right-2 flex size-4 items-center justify-center">
        <Render>
            <span @attributes="context.Attributes">
                <IconPlaceholder Lucide="check" Tabler="check" Hugeicons="tick-02" Phosphor="check" Remixicon="check-line" FontAwesome="check"
                                 aria-hidden="true" class="pointer-events-none" />
            </span>
        </Render>
    </ComboboxItemIndicator>
</Blazix.Primitives.ComboboxItem>

@code {
    /// <summary>Render your own element or component; spread <c>props.Attributes</c> onto it.</summary>
    [Parameter] public RenderFragment<ComboboxItemRenderProps>? Render { get; set; }

    [Parameter, EditorRequired] public string Value { get; set; } = "";

    /// <summary>The text shown in the input and used for filtering. Defaults to the combobox's ItemToLabel, else the value.</summary>
    [Parameter] public string? Label { get; set; }

    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
