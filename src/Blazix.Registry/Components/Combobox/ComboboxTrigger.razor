@namespace Blazix.Registry
@using Blazix.Primitives
@using static Blazix.Registry.ClassNames

<Blazix.Primitives.ComboboxTrigger data-slot="combobox-trigger" @attributes="AdditionalAttributes" Render="@Render"
                                 class="@Cn("[&_svg:not([class*='size-'])]:size-4", Class)">
    @ChildContent
    <IconPlaceholder Lucide="chevron-down" Tabler="chevron-down" Hugeicons="arrow-down-01" Phosphor="caret-down" Remixicon="arrow-down-s-line" FontAwesome="chevron-down"
                     aria-hidden="true" class="pointer-events-none size-4 text-muted-foreground" />
</Blazix.Primitives.ComboboxTrigger>

@code {
    /// <summary>Render your own element or component; spread <c>props.Attributes</c> onto it.</summary>
    [Parameter] public RenderFragment<ComboboxRenderProps>? Render { get; set; }

    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
