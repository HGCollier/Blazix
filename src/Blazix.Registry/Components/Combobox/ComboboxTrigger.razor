@namespace Blazix.Registry
@using Blazix.Primitives
@using static Blazix.Registry.ClassNames

<Blazix.Primitives.ComboboxTrigger data-slot="combobox-trigger" @attributes="AdditionalAttributes" Render="@Render"
                                 class="@Cn("[&_svg:not([class*='size-'])]:size-4", Class)">
    @ChildContent
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="pointer-events-none size-4 text-muted-foreground">
        <path d="m6 9 6 6 6-6" />
    </svg>
</Blazix.Primitives.ComboboxTrigger>

@code {
    /// <summary>Render your own element or component; spread <c>props.Attributes</c> onto it.</summary>
    [Parameter] public RenderFragment<ComboboxRenderProps>? Render { get; set; }

    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
