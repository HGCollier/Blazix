@namespace Blazix.Registry
@using Blazix.Primitives
@using static Blazix.Registry.ClassNames

<MenuSubmenuTrigger data-slot="context-menu-sub-trigger" @attributes="AdditionalAttributes" Render="@Render"
                    Disabled="@Disabled" Label="@Label" OpenOnHover="@OpenOnHover" Delay="@Delay" CloseDelay="@CloseDelay"
                    data-inset="@Inset"
                    class="@Cn(
                        "flex cursor-default items-center gap-1.5 rounded-md px-1.5 py-1 text-sm outline-hidden select-none focus:bg-accent focus-visible:ring-1 focus-visible:ring-inset focus-visible:ring-ring/50 " +
                        "focus:text-accent-foreground data-inset:pl-7 data-open:bg-accent data-open:text-accent-foreground " +
                        "[&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4",
                        Class)">
    @ChildContent
    <IconPlaceholder Lucide="chevron-right" Tabler="chevron-right" Hugeicons="arrow-right-01" Phosphor="caret-right" Remixicon="arrow-right-s-line" FontAwesome="chevron-right"
                     aria-hidden="true" class="cn-rtl-flip ml-auto" />
</MenuSubmenuTrigger>

@code {
    /// <summary>Render your own element or component; spread <c>props.Attributes</c> onto it.</summary>
    [Parameter] public RenderFragment<MenuItemRenderProps>? Render { get; set; }

    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Inset { get; set; }
    [Parameter] public string? Label { get; set; }

    /// <summary>Open the submenu when the pointer rests on the trigger. Defaults to true.</summary>
    [Parameter] public bool OpenOnHover { get; set; } = true;

    /// <summary>How long the pointer rests before the submenu opens, in milliseconds. Defaults to 100.</summary>
    [Parameter] public int Delay { get; set; } = 100;

    [Parameter] public int CloseDelay { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
