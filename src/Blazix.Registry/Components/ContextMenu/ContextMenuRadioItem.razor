@namespace Blazix.Registry
@using Blazix.Primitives
@using static Blazix.Registry.ClassNames

<MenuRadioItem data-slot="context-menu-radio-item" @attributes="AdditionalAttributes" Render="@Render"
               Value="@Value" Disabled="@Disabled" CloseOnClick="@CloseOnClick" Label="@Label"
               data-inset="@Inset"
               class="@Cn(
                   "relative flex cursor-default items-center gap-1.5 rounded-md py-1 pr-8 pl-1.5 text-sm outline-hidden select-none " +
                   "focus:bg-accent focus-visible:ring-1 focus-visible:ring-inset focus-visible:ring-ring/50 focus:text-accent-foreground data-inset:pl-7 data-disabled:pointer-events-none data-disabled:opacity-50 " +
                   "[&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4",
                   Class)">
    <span class="pointer-events-none absolute right-2">
        <MenuRadioItemIndicator>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 6 9 17l-5-5" />
            </svg>
        </MenuRadioItemIndicator>
    </span>
    @ChildContent
</MenuRadioItem>

@code {
    /// <summary>Render your own element or component; spread <c>props.Attributes</c> onto it.</summary>
    [Parameter] public RenderFragment<MenuRadioItemRenderProps>? Render { get; set; }

    /// <summary>The radio group's value when this item is checked.</summary>
    [Parameter, EditorRequired] public string Value { get; set; } = "";

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Close the menu when the item is clicked. Defaults to false.</summary>
    [Parameter] public bool CloseOnClick { get; set; }

    [Parameter] public bool Inset { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
