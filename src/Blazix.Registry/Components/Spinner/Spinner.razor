@namespace Blazix.Registry
@using static Blazix.Registry.ClassNames

<IconPlaceholder Lucide="loader-circle" Tabler="loader" Hugeicons="loading-03" Phosphor="spinner" Remixicon="loader-line" FontAwesome="circle-notch"
                 data-slot="spinner" role="status" aria-label="Loading" @attributes="AdditionalAttributes"
                 class="@Cn("size-4 animate-spin", Class)" />

@code {
    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
