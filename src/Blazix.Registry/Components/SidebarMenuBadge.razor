@using static Blazix.Registry.ClassNames

<div data-slot="sidebar-menu-badge" data-sidebar="menu-badge" @attributes="AdditionalAttributes"
     class="@Cn(
         "pointer-events-none absolute right-1 flex h-5 min-w-5 items-center justify-center rounded-md px-1 text-xs font-medium " +
         "text-sidebar-foreground tabular-nums select-none group-data-[collapsible=icon]:hidden " +
         "peer-hover/menu-button:text-sidebar-accent-foreground peer-data-[size=default]/menu-button:top-1.5 " +
         "peer-data-[size=lg]/menu-button:top-2.5 peer-data-[size=sm]/menu-button:top-1 " +
         "peer-data-active/menu-button:text-sidebar-accent-foreground",
         Class)">
    @ChildContent
</div>

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
