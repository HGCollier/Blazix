@using static Blazix.Registry.ClassNames

<div data-slot="item-media" data-variant="@VariantName" @attributes="AdditionalAttributes"
     class="@Cn(
         "flex shrink-0 items-center justify-center gap-2 group-has-data-[slot=item-description]/item:translate-y-0.5 " +
         "group-has-data-[slot=item-description]/item:self-start [&_svg]:pointer-events-none",
         Variant switch
         {
             ItemMediaVariant.Icon => "[&_svg:not([class*='size-'])]:size-4",
             ItemMediaVariant.Image =>
                 "size-10 overflow-hidden rounded-sm group-data-[size=sm]/item:size-8 group-data-[size=xs]/item:size-6 [&_img]:size-full " +
                 "[&_img]:object-cover",
             _ => "bg-transparent",
         },
         Class)">
    @ChildContent
</div>

@code {
    [Parameter] public ItemMediaVariant Variant { get; set; } = ItemMediaVariant.Default;

    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string VariantName => Variant switch
    {
        ItemMediaVariant.Icon => "icon",
        ItemMediaVariant.Image => "image",
        _ => "default",
    };
}
