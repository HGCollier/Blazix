@using Blazix.Primitives
@using static Blazix.Registry.ClassNames

<MenuTrigger data-slot="menubar-trigger" @attributes="AdditionalAttributes" Render="@Render"
             class="@Cn("flex items-center rounded-sm px-1.5 py-[2px] text-sm font-medium outline-hidden select-none hover:bg-muted aria-expanded:bg-muted focus-visible:ring-3 focus-visible:ring-ring/50", Class)">
    @ChildContent
</MenuTrigger>

@code {
    /// <summary>Render your own element or component; spread <c>props.Attributes</c> onto it.</summary>
    [Parameter] public RenderFragment<MenuTriggerRenderProps>? Render { get; set; }

    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
