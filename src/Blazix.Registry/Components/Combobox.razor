@using Blazix.Primitives

<ComboboxRoot Items="@Items" ItemToLabel="@ItemToLabel" Filter="@Filter" Limit="@Limit"
              Value="@Value" ValueChanged="@ValueChanged" Values="@Values" ValuesChanged="@ValuesChanged" OnValueChange="@OnValueChange"
              InputValue="@InputValue" InputValueChanged="@InputValueChanged" Multiple="@Multiple"
              Disabled="@Disabled" ReadOnly="@ReadOnly" Required="@Required" Name="@Name"
              AutoHighlight="@AutoHighlight" OpenOnInputClick="@OpenOnInputClick" Modal="@Modal" Grid="@Grid"
              Open="@Open" OpenChanged="@OpenChanged" OnOpenChange="@OnOpenChange" OnOpenChangeComplete="@OnOpenChangeComplete">
    @ChildContent
</ComboboxRoot>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>The items to choose from, filtered by what's typed.</summary>
    [Parameter] public IEnumerable<string>? Items { get; set; }

    /// <summary>The text shown for an item. Defaults to the item itself.</summary>
    [Parameter] public Func<string, string>? ItemToLabel { get; set; }

    /// <summary>Whether an item's label matches what's typed. Defaults to a case- and accent-insensitive "contains".</summary>
    [Parameter] public Func<string, string, bool>? Filter { get; set; }

    /// <summary>Show at most this many matching items.</summary>
    [Parameter] public int? Limit { get; set; }

    /// <summary>The selected item. Supports <c>@bind-Value</c>.</summary>
    [Parameter] public string? Value { get; set; }

    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>The selected items, with <see cref="Multiple"/>. Supports <c>@bind-Values</c>.</summary>
    [Parameter] public IReadOnlyList<string>? Values { get; set; }

    [Parameter] public EventCallback<IReadOnlyList<string>?> ValuesChanged { get; set; }

    /// <summary>Runs before the selection changes; call <c>Cancel()</c> to keep it.</summary>
    [Parameter] public EventCallback<ValueChangeEventArgs<IReadOnlyList<string>>> OnValueChange { get; set; }

    /// <summary>The input's text. Supports <c>@bind-InputValue</c>.</summary>
    [Parameter] public string? InputValue { get; set; }

    [Parameter] public EventCallback<string> InputValueChanged { get; set; }

    [Parameter] public bool Multiple { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public string? Name { get; set; }

    /// <summary>Highlight the first matching item as you type, so Enter picks it.</summary>
    [Parameter] public bool AutoHighlight { get; set; }

    /// <summary>Whether clicking the input opens the list. Defaults to true.</summary>
    [Parameter] public bool? OpenOnInputClick { get; set; }

    [Parameter] public bool Modal { get; set; }

    /// <summary>Lay items out in rows of a grid (ComboboxRow).</summary>
    [Parameter] public bool Grid { get; set; }

    /// <summary>Supports <c>@bind-Open</c>.</summary>
    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public EventCallback<OpenChangeEventArgs> OnOpenChange { get; set; }
    [Parameter] public EventCallback<bool> OnOpenChangeComplete { get; set; }
}
