@namespace Blazix.Registry
@using static Blazix.Registry.ClassNames

<Blazix.Primitives.NavigationMenuTrigger data-slot="navigation-menu-trigger" @attributes="AdditionalAttributes"
                                       class="@Cn(NavigationMenuTriggerStyle.Classes, "group", Class)">
    @ChildContent
    <IconPlaceholder Lucide="chevron-down" Tabler="chevron-down" Hugeicons="arrow-down-01" Phosphor="caret-down" Remixicon="arrow-down-s-line" FontAwesome="chevron-down"
                     aria-hidden="true" class="relative top-px ml-1 size-3 transition duration-300 group-data-popup-open/navigation-menu-trigger:rotate-180 group-data-open/navigation-menu-trigger:rotate-180" />
</Blazix.Primitives.NavigationMenuTrigger>

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
