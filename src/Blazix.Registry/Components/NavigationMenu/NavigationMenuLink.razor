@namespace Blazix.Registry
@using Blazix.Primitives
@using static Blazix.Registry.ClassNames

<Blazix.Primitives.NavigationMenuLink data-slot="navigation-menu-link" @attributes="AdditionalAttributes" Render="@Render" Active="@Active"
                                    class="@Cn(
                                        "flex items-center gap-2 rounded-lg p-2 text-sm transition-all outline-none hover:bg-muted focus:bg-muted " +
                                        "focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-1 " +
                                        "in-data-[slot=navigation-menu-content]:rounded-md data-active:bg-muted/50 data-active:hover:bg-muted " +
                                        "data-active:focus:bg-muted [&_svg:not([class*='size-'])]:size-4",
                                        Class)">
    @ChildContent
</Blazix.Primitives.NavigationMenuLink>

@code {
    /// <summary>Render your own element or component; spread <c>props.Attributes</c> onto it.</summary>
    [Parameter] public RenderFragment<NavigationMenuItemRenderProps>? Render { get; set; }

    /// <summary>Marks the link to the current page.</summary>
    [Parameter] public bool Active { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
