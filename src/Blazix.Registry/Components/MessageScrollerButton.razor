@using Blazix.Primitives
@using static Blazix.Registry.ClassNames

<Blazix.Primitives.MessageScrollerButton data-slot="message-scroller-button" data-direction="@DirectionName"
                                       data-variant="@Variant.ToString().ToLowerInvariant()" data-size="@SizeName"
                                       @attributes="AdditionalAttributes" Render="@Render" Direction="@Direction" Behavior="@Behavior"
                                       class="@ButtonVariants.Get(Variant, Size, Cn(
                                           "absolute inset-s-1/2 -translate-x-1/2 border-border bg-background text-foreground transition-[translate,scale,opacity] duration-200 hover:bg-muted hover:text-foreground data-[active=false]:pointer-events-none data-[active=false]:scale-95 data-[active=false]:opacity-0 data-[active=false]:duration-400 data-[active=false]:ease-[cubic-bezier(0.7,0,0.84,0)] data-[active=true]:translate-y-0 data-[active=true]:scale-100 data-[active=true]:opacity-100 data-[active=true]:ease-[cubic-bezier(0.23,1,0.32,1)] data-[direction=end]:bottom-4 data-[direction=end]:data-[active=false]:translate-y-full data-[direction=start]:top-4 data-[direction=start]:data-[active=false]:-translate-y-full rtl:translate-x-1/2 data-[direction=start]:[&_svg]:rotate-180",
                                           Class))">
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 5v14" />
            <path d="m19 12-7 7-7-7" />
        </svg>
        <span class="sr-only">@(Direction == MessageScrollerDirection.End ? "Scroll to end" : "Scroll to start")</span>
    }
</Blazix.Primitives.MessageScrollerButton>

@code {
    /// <summary>The edge it scrolls to. Defaults to End.</summary>
    [Parameter] public MessageScrollerDirection Direction { get; set; } = MessageScrollerDirection.End;

    /// <summary>Defaults to Smooth.</summary>
    [Parameter] public ScrollBehavior Behavior { get; set; } = ScrollBehavior.Smooth;

    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Secondary;
    [Parameter] public ButtonSize Size { get; set; } = ButtonSize.IconSm;

    /// <summary>Render your own element or component; spread <c>props.Attributes</c> onto it.</summary>
    [Parameter] public RenderFragment<MessageScrollerButtonRenderProps>? Render { get; set; }

    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string DirectionName => Direction == MessageScrollerDirection.End ? "end" : "start";

    private string SizeName => Size switch
    {
        ButtonSize.IconXs => "icon-xs",
        ButtonSize.IconSm => "icon-sm",
        ButtonSize.IconLg => "icon-lg",
        _ => Size.ToString().ToLowerInvariant(),
    };
}
