@namespace Blazix.Registry
@using static Blazix.Registry.ClassNames

<div data-slot="aspect-ratio" style="@($"--ratio:{Ratio.ToString(System.Globalization.CultureInfo.InvariantCulture)}")" @attributes="AdditionalAttributes"
     class="@Cn("relative aspect-(--ratio)", Class)">
    @ChildContent
</div>

@code {
    /// <summary>Width divided by height, e.g. <c>16 / 9.0</c>.</summary>
    [Parameter, EditorRequired] public double Ratio { get; set; } = 1;

    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
