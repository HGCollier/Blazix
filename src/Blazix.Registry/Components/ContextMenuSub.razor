@using Blazix.Primitives

<MenuSubmenuRoot Open="@Open" OpenChanged="@OpenChanged" OnOpenChange="@OnOpenChange" Disabled="@Disabled">
    @ChildContent
</MenuSubmenuRoot>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Supports <c>@bind-Open</c>; leave unset to let the submenu manage itself.</summary>
    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>Runs before the submenu opens or closes, with the reason; call <c>Cancel()</c> to keep it as it is.</summary>
    [Parameter] public EventCallback<OpenChangeEventArgs> OnOpenChange { get; set; }

    [Parameter] public bool Disabled { get; set; }
}
