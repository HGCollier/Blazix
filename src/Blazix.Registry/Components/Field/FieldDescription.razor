@namespace Blazix.Registry
@using static Blazix.Registry.ClassNames
@implements IDisposable

@* Describes the field's control (its aria-describedby). *@
<p id="@_id" data-slot="field-description" @attributes="AdditionalAttributes"
   class="@Cn(
       "text-left text-sm leading-normal font-normal text-muted-foreground group-has-data-horizontal/field:text-balance " +
       "[[data-variant=legend]+&]:-mt-1.5 last:mt-0 nth-last-2:-mt-1 [&>a]:underline [&>a]:underline-offset-4 " +
       "[&>a:hover]:text-primary",
       Class)">
    @ChildContent
</p>

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    [CascadingParameter] private FieldDescriptions? Descriptions { get; set; }

    private readonly string _generatedId = $"field-description-{Guid.NewGuid():N}";
    private string _id = "";

    protected override void OnParametersSet()
    {
        var id = AdditionalAttributes?.GetValueOrDefault("id") as string is { Length: > 0 } authored ? authored : _generatedId;
        if (id != _id)
        {
            Descriptions?.Remove(_id);
            _id = id;
        }
        Descriptions?.Add(_id);
    }

    public void Dispose() => Descriptions?.Remove(_id);
}
