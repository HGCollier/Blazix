@using Blazix.Primitives
@using static Blazix.Registry.ClassNames

<Blazix.Primitives.AvatarFallback data-slot="avatar-fallback" @attributes="AdditionalAttributes" Render="@Render" Delay="@Delay"
                                class="@Cn("flex size-full items-center justify-center rounded-full bg-muted text-sm text-muted-foreground group-data-[size=sm]/avatar:text-xs", Class)">
    @ChildContent
</Blazix.Primitives.AvatarFallback>

@code {
    /// <summary>Render your own element or component; spread <c>props.Attributes</c> onto it.</summary>
    [Parameter] public RenderFragment<AvatarRenderProps>? Render { get; set; }

    /// <summary>Wait this many milliseconds before showing, so a fast image doesn't flash the fallback.</summary>
    [Parameter] public int Delay { get; set; }

    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
