@using static Blazix.Registry.ClassNames

<Blazix.Primitives.ComboboxEmpty data-slot="combobox-empty" @attributes="AdditionalAttributes"
                               class="@Cn("hidden w-full justify-center py-2 text-center text-sm text-muted-foreground group-data-empty/combobox-content:flex", Class)">
    @ChildContent
</Blazix.Primitives.ComboboxEmpty>

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
