@namespace Blazix.Registry
@* No @using Blazix.Primitives: its DialogTitle and DialogDescription would clash with these in apps (RZ9985).
   PopupModal and OpenChangeEventArgs come from the global using that init adds. *@
@using static Blazix.Registry.ClassNames

<Dialog Open="@Open" OpenChanged="@OpenChanged" OnOpenChange="@OnOpenChange" OnOpenChangeComplete="@OnOpenChangeComplete"
        Modal="@Modal" DisablePointerDismissal="@DisablePointerDismissal">
    <DialogHeader Class="sr-only">
        <DialogTitle>@Title</DialogTitle>
        <DialogDescription>@Description</DialogDescription>
    </DialogHeader>
    <DialogContent Class="@Cn("top-1/3 translate-y-0 overflow-hidden rounded-xl! p-0", Class)" ShowCloseButton="@ShowCloseButton"
                   AdditionalAttributes="@AdditionalAttributes">
        @ChildContent
    </DialogContent>
</Dialog>

@code {
    /// <summary>The dialog's accessible title. Not shown visibly.</summary>
    [Parameter] public string Title { get; set; } = "Command Palette";

    /// <summary>The dialog's accessible description. Not shown visibly.</summary>
    [Parameter] public string Description { get; set; } = "Search for a command to run...";

    /// <summary>Show the close button in the corner.</summary>
    [Parameter] public bool ShowCloseButton { get; set; }

    /// <summary>Supports <c>@bind-Open</c>; leave unset to let the dialog manage itself.</summary>
    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>Runs before the dialog opens or closes, with the reason; call <c>Cancel()</c> to keep it as it is.</summary>
    [Parameter] public EventCallback<OpenChangeEventArgs> OnOpenChange { get; set; }

    /// <summary>Runs once the open or close animation has finished.</summary>
    [Parameter] public EventCallback<bool> OnOpenChangeComplete { get; set; }

    /// <summary>Whether focus is trapped and the page behind is inert. Defaults to true.</summary>
    [Parameter] public PopupModal Modal { get; set; } = PopupModal.True;

    /// <summary>Keep the dialog open when the user presses outside it.</summary>
    [Parameter] public bool DisablePointerDismissal { get; set; }

    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
