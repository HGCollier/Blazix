@namespace Blazix.Registry
@using static Blazix.Registry.ClassNames

@* Decorative: a listbox holds only options and groups, so no separator role. *@
@if (AlwaysRender || Root.Search.Length == 0)
{
    <div data-slot="command-separator" @attributes="AdditionalAttributes" cmdk-separator="" aria-hidden="true"
         class="@Cn("-mx-1 h-px bg-border", Class)"></div>
}

@code {
    [CascadingParameter] internal Command Root { get; set; } = null!;

    /// <summary>Keep the separator while searching. By default it hides.</summary>
    [Parameter] public bool AlwaysRender { get; set; }

    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
