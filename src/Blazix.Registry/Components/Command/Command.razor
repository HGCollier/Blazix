@namespace Blazix.Registry
@using Microsoft.JSInterop
@using static Blazix.Registry.ClassNames
@implements IAsyncDisposable

<div @ref="_root" data-slot="command" tabindex="-1" @attributes="AdditionalAttributes" cmdk-root=""
     class="@Cn("flex size-full flex-col overflow-hidden rounded-xl! bg-popover p-1 text-popover-foreground", Class)">
    <label cmdk-label="" for="@InputId" id="@LabelId" style="@SrOnly">@(Label ?? AdditionalAttributes?.GetValueOrDefault("aria-label"))</label>
    <CascadingValue Value="this">
        @ChildContent
    </CascadingValue>
</div>

@code {
    private const string SrOnly =
        "position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0, 0, 0, 0);white-space:nowrap;border-width:0";

    private readonly string _id = $"cmdk-{Guid.NewGuid():N}";
    private readonly List<CommandItem> _items = [];
    private readonly List<CommandGroup> _groups = [];
    private ElementReference _root;
    private IJSObjectReference? _module;
    private IJSObjectReference? _controller;
    private DotNetObjectReference<Command>? _dotnet;
    private string? _options;
    private string _value = "";
    private int _nextDocIndex = 1_000_000;
    private bool _rendered;
    private bool _sync = true;
    private bool _scroll = true;
    private bool _disposed;

    [Inject] private IJSRuntime JsRuntime { get; set; } = null!;

    /// <summary>Accessible label for the command menu. Not shown visibly.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Set to false to turn off the automatic filtering and sorting; then render the matching items yourself.</summary>
    [Parameter] public bool ShouldFilter { get; set; } = true;

    /// <summary>
    /// Ranks an item for the search: <c>(value, search, keywords)</c> to a number from 0 (hidden) to 1 (best match).
    /// Defaults to <see cref="DefaultFilter" />, cmdk's command-score.
    /// </summary>
    [Parameter] public Func<string, string, IReadOnlyList<string>, double>? Filter { get; set; }

    /// <summary>The selected (highlighted) item's value. Supports <c>@bind-Value</c>; leave unset to let the menu manage it.</summary>
    [Parameter] public string? Value { get; set; }

    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    /// <summary>Wrap around when the arrow keys reach either end.</summary>
    [Parameter] public bool Loop { get; set; }

    /// <summary>Don't select items when the pointer moves over them.</summary>
    [Parameter] public bool DisablePointerSelection { get; set; }

    /// <summary>Ctrl+N/J and Ctrl+P/K move the selection, like the arrow keys. Defaults to true.</summary>
    [Parameter] public bool VimBindings { get; set; } = true;

    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    internal string Search { get; private set; } = "";
    internal string ListId => _id + "-list";
    internal string LabelId => _id + "-label";
    internal string InputId => _id + "-input";

    /// <summary>Whether items are being filtered: there's a search, and <see cref="ShouldFilter" /> is on.</summary>
    internal bool Filtering => ShouldFilter && Search.Length > 0;

    /// <summary>Whether the items have been read once, so the empty state can trust <see cref="Count" />.</summary>
    internal bool Ready { get; private set; }

    /// <summary>How many items match (all of them without a search). Force-mounted items don't count.</summary>
    internal int Count => _items.Count(item => !item.ForceMounted && (!Filtering || item.Score > 0));

    internal string? SelectedItemId => SelectedItem()?.Id;

    internal bool IsSelected(string value) => _value.Length > 0 && _value == value;

    protected override void OnParametersSet()
    {
        if (Value is not null)
            _value = Value.Trim();
        Update();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _rendered = true;
        try
        {
            if (firstRender)
            {
                _module = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./_content/Blazix.Primitives/command.js");
                // Removed while the module loaded. The first import can take a while (in Firefox especially), long
                // enough to navigate away: the element is gone, and DisposeAsync ran before there was a module.
                if (_disposed)
                {
                    await DisposeJsAsync();
                    return;
                }
                _dotnet = DotNetObjectReference.Create(this);
            }
            if (_module is null)
                return;

            // A dictionary, not an anonymous type: JS interop reflects over the argument, and trimming removes an
            // anonymous type's members.
            var options = new Dictionary<string, object?> { ["vimBindings"] = VimBindings, ["disablePointerSelection"] = DisablePointerSelection };
            var key = $"{VimBindings}|{DisablePointerSelection}";
            if (_controller is null)
                _controller = await _module.InvokeAsync<IJSObjectReference>("init", _root, _dotnet, options);
            else if (key != _options)
                await _controller.InvokeVoidAsync("update", options);
            _options = key;
            if (_disposed)
            {
                // ...or while the browser side started or updated: stop it too, and don't read an element that's gone.
                await DisposeJsAsync();
                return;
            }

            if (_sync)
            {
                // Items without a Value are named by their text, which only the browser knows. The DOM also gives
                // the document order, which breaks ranking ties and drives keyboard navigation.
                _sync = false;
                var nodes = await _module.InvokeAsync<string?[][]>("read", _root);
                var items = _items.ToDictionary(item => item.Id);
                var groups = _groups.ToDictionary(group => group.Id);
                for (var i = 0; i < nodes.Length; i++)
                {
                    if (items.TryGetValue(nodes[i][0] ?? "", out var item))
                    {
                        item.DocIndex = i;
                        item.Text = nodes[i][1];
                    }
                    else if (groups.TryGetValue(nodes[i][0] ?? "", out var group))
                    {
                        group.DocIndex = i;
                    }
                }
                Ready = true;
                Update();
                StateHasChanged();
                if (_value.Length == 0)
                    await SelectFirstAsync();
                return;
            }

            if (_scroll)
            {
                _scroll = false;
                await _module.InvokeVoidAsync("scrollSelectedIntoView", _root);
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone.
        }
    }

    internal void Register(CommandItem item)
    {
        item.DocIndex = _nextDocIndex++;
        _items.Add(item);
        _sync = true;
        Refresh();
    }

    internal void Register(CommandGroup group)
    {
        group.DocIndex = _nextDocIndex++;
        _groups.Add(group);
        _sync = true;
        Refresh();
    }

    internal void Unregister(CommandItem item)
    {
        if (_disposed)
            return;
        var wasSelected = SelectedItem() == item;
        _items.Remove(item);
        Update();
        _ = InvokeAsync(async () =>
        {
            if (wasSelected)
                await SelectFirstAsync();
            StateHasChanged();
        });
    }

    internal void Unregister(CommandGroup group)
    {
        if (!_disposed)
            _groups.Remove(group);
    }

    /// <summary>An item's value, keywords or disabled state changed.</summary>
    internal void ItemChanged()
    {
        Update();
        Refresh();
    }

    internal async Task SetSearchAsync(string search)
    {
        if (search == Search)
            return;
        Search = search;
        Update();
        // Items that show up again may never have been read.
        _sync |= _items.Any(item => item.Text is null && item.IsRendered);
        StateHasChanged();
        await SelectFirstAsync();
    }

    internal async Task SetValueAsync(string value, bool scroll)
    {
        if (value == _value)
            return;
        if (Value is null)
            _value = value;
        _scroll |= scroll;
        StateHasChanged();
        await ValueChanged.InvokeAsync(value);
    }

    [JSInvokable]
    public Task OnKeyAsync(string action, bool meta, bool alt) => InvokeAsync(() => action switch
    {
        "next" when meta => ToIndexAsync(^1),
        "next" when alt => ByGroupAsync(1),
        "next" => ByItemAsync(1),
        "prev" when meta => ToIndexAsync(0),
        "prev" when alt => ByGroupAsync(-1),
        "prev" => ByItemAsync(-1),
        "first" => ToIndexAsync(0),
        "last" => ToIndexAsync(^1),
        "enter" => SelectedItem() is { } item ? item.SelectAsync() : Task.CompletedTask,
        _ => Task.CompletedTask,
    });

    [JSInvokable]
    public Task OnPointerAsync(string id) => InvokeAsync(() =>
        !DisablePointerSelection && _items.Find(candidate => candidate.Id == id) is { Disabled: false } item
            ? SetValueAsync(item.ResolvedValue, scroll: false)
            : Task.CompletedTask);

    private void Refresh()
    {
        if (_rendered && !_disposed)
            _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>Scores the items and ranks the matches, as cmdk's filterItems and sort do.</summary>
    private void Update()
    {
        var filtering = Filtering;
        var filter = Filter ?? DefaultFilter;
        foreach (var item in _items)
        {
            var value = item.ResolvedValue;
            item.Score = filtering && value.Length > 0 ? filter(value, Search, item.TrimmedKeywords()) : 0;
            item.Order = 0;
        }
        foreach (var group in _groups)
        {
            group.HasMatch = filtering && _items.Any(item => item.Group == group && item is { ForceMounted: false, Score: > 0 });
            group.Order = 0;
        }
        if (!filtering)
            return;

        // cmdk moves the enabled items to the end of their list or group, best first, then the matching groups after the
        // loose items, best first. Here CSS `order` does the moving: equal scores share an order, so the DOM breaks ties.
        var valid = _items.Where(item => item is { IsRendered: true, Disabled: false }).ToList();
        var offset = Rank(valid.Where(item => item.Group is null), item => item.Score, (item, order) => item.Order = order);
        foreach (var group in _groups)
            Rank(valid.Where(item => item.Group == group), item => item.Score, (item, order) => item.Order = order);
        Rank(_groups.Where(group => group.HasMatch),
            group => _items.Where(item => item.Group == group && !item.ForceMounted).Max(item => item.Score),
            (group, order) => group.Order = offset + order);
    }

    private static int Rank<T>(IEnumerable<T> source, Func<T, double> score, Action<T, int> setOrder)
    {
        var list = source.ToList();
        var scores = list.Select(score).Distinct().OrderDescending().ToList();
        foreach (var entry in list)
            setOrder(entry, scores.IndexOf(score(entry)) + 1);
        return scores.Count;
    }

    /// <summary>The rendered items as they appear on screen (enabled ones only when <paramref name="enabledOnly" />).</summary>
    private List<CommandItem> Ordered(bool enabledOnly) => _items
        .Where(item => item.IsRendered && !(enabledOnly && item.Disabled))
        .OrderBy(item => item.Group?.Order ?? item.Order)
        .ThenBy(item => item.Group?.DocIndex ?? item.DocIndex)
        .ThenBy(item => item.Group is null ? 0 : item.Order)
        .ThenBy(item => item.DocIndex)
        .ToList();

    private CommandItem? SelectedItem() => _value.Length == 0 ? null : Ordered(false).Find(item => item.ResolvedValue == _value);

    private Task SelectFirstAsync() => SetValueAsync(Ordered(true).FirstOrDefault()?.ResolvedValue ?? "", scroll: true);

    private Task ToIndexAsync(Index index)
    {
        var items = Ordered(true);
        var offset = index.GetOffset(items.Count);
        return offset >= 0 && offset < items.Count ? SetValueAsync(items[offset].ResolvedValue, scroll: true) : Task.CompletedTask;
    }

    private Task ByItemAsync(int change)
    {
        var items = Ordered(true);
        var selected = SelectedItem();
        var target = (selected is null ? -1 : items.IndexOf(selected)) + change;
        if (Loop && target < 0)
            target = items.Count - 1;
        else if (Loop && target == items.Count)
            target = 0;
        var next = target >= 0 && target < items.Count ? items[target] : null;
        return next is null ? Task.CompletedTask : SetValueAsync(next.ResolvedValue, scroll: true);
    }

    /// <summary>Selects the first item of the next or previous group that has one, else moves by one item.</summary>
    private Task ByGroupAsync(int change)
    {
        if (SelectedItem()?.Group is { } current)
        {
            var groups = _groups.OrderBy(group => group.Order).ThenBy(group => group.DocIndex).ToList();
            var items = Ordered(true);
            for (var i = groups.IndexOf(current) + change; i >= 0 && i < groups.Count; i += change)
            {
                if (items.Find(item => item.Group == groups[i]) is { } first)
                    return SetValueAsync(first.ResolvedValue, scroll: true);
            }
        }
        return ByItemAsync(change);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await DisposeJsAsync();
    }

    // Takes each reference first: a first render that outlived the component runs this too, after DisposeAsync.
    private async Task DisposeJsAsync()
    {
        var controller = _controller;
        var module = _module;
        _controller = null;
        _module = null;
        try
        {
            if (controller is not null)
            {
                await controller.InvokeVoidAsync("dispose");
                await controller.DisposeAsync();
            }
            if (module is not null)
                await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, and the page with it.
        }
        _dotnet?.Dispose();
    }

    // cmdk's command-score: continuous matches score 1, word starts nearly as much, other jumps little.
    private const double ScoreContinueMatch = 1;
    private const double ScoreSpaceWordJump = 0.9;
    private const double ScoreNonSpaceWordJump = 0.8;
    private const double ScoreCharacterJump = 0.17;
    private const double ScoreTransposition = 0.1;
    private const double PenaltySkipped = 0.999;
    private const double PenaltyCaseMismatch = 0.9999;
    private const double PenaltyNotComplete = 0.99;

    /// <summary>cmdk's default filter (command-score): how well <paramref name="search" /> matches the value and keywords, from 0 to 1.</summary>
    public static double DefaultFilter(string value, string search, IReadOnlyList<string> keywords)
    {
        if (keywords.Count > 0)
            value = value + " " + string.Join(' ', keywords);
        return ScoreInner(value, search, Format(value), Format(search), 0, 0, []);
    }

    private static string Format(string text) =>
        string.Create(text.Length, text, static (span, source) =>
        {
            for (var i = 0; i < source.Length; i++)
                span[i] = IsSpace(source[i]) ? ' ' : char.ToLowerInvariant(source[i]);
        });

    private static bool IsGap(char c) => c is '\\' or '/' or '_' or '+' or '.' or '#' or '"' or '@' or '[' or '(' or '{' or '&';

    private static bool IsSpace(char c) => char.IsWhiteSpace(c) || c == '-';

    // JavaScript's charAt: out of range is "", which equals any other out-of-range read.
    private static int At(string text, int index) => index >= 0 && index < text.Length ? text[index] : -1;

    private static int CountIn(string text, int start, int end, Func<char, bool> predicate)
    {
        var count = 0;
        for (var i = start; i < end; i++)
        {
            if (predicate(text[i]))
                count++;
        }
        return count;
    }

    private static double ScoreInner(string text, string abbreviation, string lowerText, string lowerAbbreviation,
        int textIndex, int abbreviationIndex, Dictionary<(int, int), double> memo)
    {
        if (abbreviationIndex >= abbreviation.Length)
            return textIndex == text.Length ? ScoreContinueMatch : PenaltyNotComplete;
        if (memo.TryGetValue((textIndex, abbreviationIndex), out var memoized))
            return memoized;

        var abbreviationChar = lowerAbbreviation[abbreviationIndex];
        var index = lowerText.IndexOf(abbreviationChar, textIndex);
        var highScore = 0d;
        while (index >= 0)
        {
            var score = ScoreInner(text, abbreviation, lowerText, lowerAbbreviation, index + 1, abbreviationIndex + 1, memo);
            if (score > highScore)
            {
                if (index == textIndex)
                {
                    score *= ScoreContinueMatch;
                }
                else if (IsGap(text[index - 1]))
                {
                    score *= ScoreNonSpaceWordJump;
                    var breaks = CountIn(text, textIndex, index - 1, IsGap);
                    if (breaks > 0 && textIndex > 0)
                        score *= Math.Pow(PenaltySkipped, breaks);
                }
                else if (IsSpace(text[index - 1]))
                {
                    score *= ScoreSpaceWordJump;
                    var breaks = CountIn(text, textIndex, index - 1, IsSpace);
                    if (breaks > 0 && textIndex > 0)
                        score *= Math.Pow(PenaltySkipped, breaks);
                }
                else
                {
                    score *= ScoreCharacterJump;
                    if (textIndex > 0)
                        score *= Math.Pow(PenaltySkipped, index - textIndex);
                }

                if (text[index] != abbreviation[abbreviationIndex])
                    score *= PenaltyCaseMismatch;
            }

            if ((score < ScoreTransposition && At(lowerText, index - 1) == At(lowerAbbreviation, abbreviationIndex + 1)) ||
                (At(lowerAbbreviation, abbreviationIndex + 1) == At(lowerAbbreviation, abbreviationIndex) &&
                 At(lowerText, index - 1) != At(lowerAbbreviation, abbreviationIndex)))
            {
                var transposed = ScoreInner(text, abbreviation, lowerText, lowerAbbreviation, index + 1, abbreviationIndex + 2, memo);
                if (transposed * ScoreTransposition > score)
                    score = transposed * ScoreTransposition;
            }

            if (score > highScore)
                highScore = score;
            index = lowerText.IndexOf(abbreviationChar, index + 1);
        }

        memo[(textIndex, abbreviationIndex)] = highScore;
        return highScore;
    }
}
