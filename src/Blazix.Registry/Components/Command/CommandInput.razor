@namespace Blazix.Registry
@using static Blazix.Registry.ClassNames

<div data-slot="command-input-wrapper" class="p-1 pb-0">
    <InputGroup Class="h-8! rounded-lg! border-input/5 bg-input/5 dark:border-input/15 dark:bg-input/15 shadow-none! *:data-[slot=input-group-addon]:ps-2!">
        <input data-slot="command-input" @attributes="AdditionalAttributes" cmdk-input="" autocomplete="off" autocorrect="off"
               spellcheck="false" aria-autocomplete="list" role="combobox" aria-expanded="true" aria-controls="@Root.ListId"
               aria-labelledby="@Root.LabelId" aria-activedescendant="@Root.SelectedItemId" id="@Root.InputId" type="text"
               value="@(Value ?? Root.Search)" @oninput="OnInputAsync"
               class="@Cn("w-full text-sm outline-hidden disabled:cursor-not-allowed disabled:opacity-50", Class)" />
        <InputGroupAddon>
            <IconPlaceholder Lucide="search" Tabler="search" Hugeicons="search-01" Phosphor="magnifying-glass" Remixicon="search-line" FontAwesome="magnifying-glass"
                             aria-hidden="true" class="size-4 shrink-0 opacity-50" />
        </InputGroupAddon>
    </InputGroup>
</div>

@code {
    [CascadingParameter] internal Command Root { get; set; } = null!;

    /// <summary>The search text. Supports <c>@bind-Value</c>; leave unset to let the menu manage it.</summary>
    [Parameter] public string? Value { get; set; }

    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    protected override Task OnParametersSetAsync() =>
        Value is not null && Value != Root.Search ? Root.SetSearchAsync(Value) : Task.CompletedTask;

    private async Task OnInputAsync(ChangeEventArgs e)
    {
        var search = e.Value?.ToString() ?? "";
        if (Value is null)
            await Root.SetSearchAsync(search);
        await ValueChanged.InvokeAsync(search);
    }
}
