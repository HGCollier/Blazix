@namespace Blazix.Registry
@using static Blazix.Registry.ClassNames
@implements IDisposable

@if (IsRendered)
{
    var selected = Root.IsSelected(ResolvedValue);
    <div data-slot="command-item" style="@(Order > 0 ? $"order:{Order}" : null)" @attributes="AdditionalAttributes"
         id="@Id" cmdk-item="" role="option"
         aria-disabled="@(Disabled ? "true" : "false")" aria-selected="@(selected ? "true" : "false")"
         data-disabled="@(Disabled ? "true" : "false")" data-selected="@(selected ? "true" : "false")"
         data-value="@ResolvedValue" @onclick="OnClickAsync"
         class="@Cn("group/command-item relative flex cursor-default items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-hidden select-none in-data-[slot=dialog-content]:rounded-lg! data-[disabled=true]:pointer-events-none data-[disabled=true]:opacity-50 data-selected:bg-muted data-selected:ring-1 data-selected:ring-inset data-selected:ring-ring/50 data-selected:text-foreground [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4 data-selected:*:[svg]:text-foreground", Class)">
        @ChildContent
        <IconPlaceholder Lucide="check" Tabler="check" Hugeicons="tick-02" Phosphor="check" Remixicon="check-line" FontAwesome="check"
                         aria-hidden="true" class="ms-auto opacity-0 group-has-data-[slot=command-shortcut]/command-item:hidden group-data-[checked=true]/command-item:opacity-100" />
    </div>
}

@code {
    private string? _key;

    [CascadingParameter] internal Command Root { get; set; } = null!;
    [CascadingParameter] internal CommandGroup? Group { get; set; }

    /// <summary>The value to filter and select by. Defaults to the item's text.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Extra words the search matches, such as aliases.</summary>
    [Parameter] public IReadOnlyList<string>? Keywords { get; set; }

    /// <summary>Whether the item can't be selected.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Called with the item's value when it's clicked, or when Enter is pressed while it's selected.</summary>
    [Parameter] public EventCallback<string> OnSelect { get; set; }

    /// <summary>Always render the item, even when it doesn't match the search.</summary>
    [Parameter] public bool ForceMount { get; set; }

    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    internal string Id { get; } = $"cmdk-item-{Guid.NewGuid():N}";
    internal string? Text { get; set; }
    internal double Score { get; set; }
    internal int Order { get; set; }
    internal int DocIndex { get; set; }
    internal string ResolvedValue => Value?.Trim() ?? Text ?? "";
    internal IReadOnlyList<string> TrimmedKeywords() => Keywords?.Select(keyword => keyword.Trim()).ToList() ?? [];
    internal bool ForceMounted => ForceMount || Group?.ForceMount == true;
    internal bool IsRendered => ForceMounted || !Root.Filtering || Score > 0;

    protected override void OnInitialized() => Root.Register(this);

    protected override void OnParametersSet()
    {
        var key = $"{Value}\u0001{Disabled}\u0001{string.Join('\u0001', Keywords ?? [])}";
        if (_key is not null && key != _key)
            Root.ItemChanged();
        _key = key;
    }

    internal async Task SelectAsync()
    {
        if (Disabled)
            return;
        await Root.SetValueAsync(ResolvedValue, scroll: false);
        await OnSelect.InvokeAsync(ResolvedValue);
    }

    private Task OnClickAsync() => SelectAsync();

    public void Dispose() => Root.Unregister(this);
}
