@using static Blazix.Registry.ClassNames

<div data-slot="empty-icon" data-variant="@(Variant == EmptyMediaVariant.Icon ? "icon" : "default")" @attributes="AdditionalAttributes"
     class="@Cn(
                "mb-2 flex shrink-0 items-center justify-center [&_svg]:pointer-events-none [&_svg]:shrink-0",
                Variant == EmptyMediaVariant.Icon
                    ? "flex size-8 shrink-0 items-center justify-center rounded-lg bg-muted text-foreground [&_svg:not([class*='size-'])]:size-4"
                    : "bg-transparent",
                Class)">
    @ChildContent
</div>

@code {
    [Parameter] public EmptyMediaVariant Variant { get; set; } = EmptyMediaVariant.Default;

    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
