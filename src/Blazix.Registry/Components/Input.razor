@using Blazix.Primitives
@using static Blazix.Registry.ClassNames

<InputRoot type="@Type" data-slot="input" @attributes="FieldDescriptions.Merge(Descriptions, AdditionalAttributes)" Render="@Render"
           Value="@Value" ValueChanged="@ValueChanged" OnValueChange="@OnValueChange" Disabled="@Disabled"
           class="@Cn(BaseClasses, Class)" />

@code {
    /// <summary>The input's classes, for parts that render an input of their own (Combobox).</summary>
    public const string BaseClasses =
        "h-8 w-full min-w-0 rounded-lg border border-input bg-transparent px-2.5 py-1 text-base transition-colors outline-none " +
        "file:inline-flex file:h-6 file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground " +
        "placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 " +
        "disabled:pointer-events-none disabled:cursor-not-allowed disabled:bg-input/10 disabled:opacity-50 " +
        "aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 md:text-sm dark:bg-input/15 " +
        "dark:disabled:bg-input/35 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 aria-invalid:focus-visible:ring-destructive/60 dark:aria-invalid:focus-visible:ring-destructive/60";

    /// <summary>Render your own element or component; spread <c>props.Attributes</c> onto it.</summary>
    [Parameter] public RenderFragment<FieldRenderProps>? Render { get; set; }

    [Parameter] public string? Type { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>Runs as the value changes; call <c>Cancel()</c> to keep the old one.</summary>
    [Parameter] public EventCallback<ValueChangeEventArgs<string?>> OnValueChange { get; set; }

    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    [CascadingParameter] private FieldDescriptions? Descriptions { get; set; }
}
