@namespace Blazix.Registry
@using Blazix.Primitives

<Blazix.Primitives.CollapsibleTrigger data-slot="collapsible-trigger" @attributes="AdditionalAttributes" Render="@Render" NativeButton="@NativeButton" class="@Class">
    @ChildContent
</Blazix.Primitives.CollapsibleTrigger>

@code {
    /// <summary>Render your own element or component; spread <c>props.Attributes</c> onto it.</summary>
    [Parameter] public RenderFragment<CollapsibleRenderProps>? Render { get; set; }

    /// <summary>Leave unset: whether Render produced a real &lt;button&gt; is detected. Set it to skip the check.</summary>
    [Parameter] public bool? NativeButton { get; set; }

    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
