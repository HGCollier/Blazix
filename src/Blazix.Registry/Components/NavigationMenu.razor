@using Blazix.Primitives
@using static Blazix.Registry.ClassNames

<NavigationMenuRoot data-slot="navigation-menu" @attributes="AdditionalAttributes" Value="@Value" ValueChanged="@ValueChanged"
                    OnValueChange="@OnValueChange" Delay="@Delay" CloseDelay="@CloseDelay" Orientation="@Orientation"
                    class="@Cn("group/navigation-menu relative flex max-w-max flex-1 items-center justify-center", Class)">
    @ChildContent
    <Blazix.Registry.NavigationMenuPositioner Align="@Align" />
</NavigationMenuRoot>

@code {
    /// <summary>The open item's value, or null when closed. Supports <c>@bind-Value</c>.</summary>
    [Parameter] public string? Value { get; set; }

    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public EventCallback<ValueChangeEventArgs<string?>> OnValueChange { get; set; }

    /// <summary>How long the pointer rests on a trigger before its content opens, in milliseconds. Defaults to 50.</summary>
    [Parameter] public int Delay { get; set; } = 50;

    [Parameter] public int CloseDelay { get; set; } = 50;
    [Parameter] public Orientation Orientation { get; set; } = Orientation.Horizontal;

    /// <summary>How the popup lines up with the open trigger. Defaults to start.</summary>
    [Parameter] public Align Align { get; set; } = Align.Start;
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
