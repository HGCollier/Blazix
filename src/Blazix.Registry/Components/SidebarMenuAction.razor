@using Blazix.Primitives
@using static Blazix.Registry.ClassNames

<UseRender DefaultTagName="button" Render="@Render" data-slot="sidebar-menu-action" data-sidebar="menu-action" @attributes="AdditionalAttributes"
           class="@Cn(
               "absolute top-1.5 right-1 flex aspect-square w-5 items-center justify-center rounded-md p-0 text-sidebar-foreground " +
               "ring-sidebar-ring outline-hidden transition-transform group-data-[collapsible=icon]:hidden " +
               "peer-hover/menu-button:text-sidebar-accent-foreground peer-data-[size=default]/menu-button:top-1.5 " +
               "peer-data-[size=lg]/menu-button:top-2.5 peer-data-[size=sm]/menu-button:top-1 after:absolute after:-inset-2 " +
               "hover:bg-sidebar-accent hover:text-sidebar-accent-foreground focus-visible:ring-2 md:after:hidden [&>svg]:size-4 " +
               "[&>svg]:shrink-0",
               ShowOnHover
                   ? "group-focus-within/menu-item:opacity-100 group-hover/menu-item:opacity-100 peer-data-active/menu-button:text-sidebar-accent-foreground aria-expanded:opacity-100 md:opacity-0"
                   : null,
               Class)">
    @ChildContent
</UseRender>

@code {
    /// <summary>Render your own element or component; spread <c>props.Attributes</c> onto it.</summary>
    [Parameter] public RenderFragment<UseRenderProps>? Render { get; set; }

    [Parameter] public bool ShowOnHover { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
