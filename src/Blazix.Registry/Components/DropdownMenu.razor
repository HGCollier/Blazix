@using Blazix.Primitives

<MenuRoot Open="@Open" OpenChanged="@OpenChanged" OnOpenChange="@OnOpenChange" OnOpenChangeComplete="@OnOpenChangeComplete"
          Disabled="@Disabled" Modal="@Modal" LoopFocus="@LoopFocus" HighlightItemOnHover="@HighlightItemOnHover">
    @ChildContent
</MenuRoot>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Supports <c>@bind-Open</c>; leave unset to let the menu manage itself.</summary>
    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>Runs before the menu opens or closes, with the reason; call <c>Cancel()</c> to keep it as it is.</summary>
    [Parameter] public EventCallback<OpenChangeEventArgs> OnOpenChange { get; set; }

    /// <summary>Runs once the open or close animation has finished.</summary>
    [Parameter] public EventCallback<bool> OnOpenChangeComplete { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Whether the page behind is inert and doesn't scroll while the menu is open. Defaults to true.</summary>
    [Parameter] public bool Modal { get; set; } = true;

    /// <summary>Whether arrow keys wrap from the last item to the first. Defaults to true.</summary>
    [Parameter] public bool LoopFocus { get; set; } = true;

    /// <summary>Whether moving the pointer over an item highlights it. Defaults to true.</summary>
    [Parameter] public bool HighlightItemOnHover { get; set; } = true;
}
