@namespace Blazix.Registry
<Blazix.Primitives.TooltipProvider Delay="@Delay" CloseDelay="@CloseDelay" Timeout="@Timeout">
    @ChildContent
</Blazix.Primitives.TooltipProvider>

@code {
    /// <summary>The open delay for the tooltips inside, in milliseconds. Defaults to 0.</summary>
    [Parameter] public int Delay { get; set; }

    /// <summary>The close delay for the tooltips inside, in milliseconds.</summary>
    [Parameter] public int? CloseDelay { get; set; }

    /// <summary>How long after one tooltip closes the next still opens at once, in milliseconds.</summary>
    [Parameter] public int Timeout { get; set; } = 400;

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
