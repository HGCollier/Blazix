@namespace Blazix.Registry
@using Blazix.Primitives

<Blazix.Primitives.ToastProvider ToastManager="@ToastManager" Timeout="@Timeout" Limit="@Limit">
    @ChildContent
</Blazix.Primitives.ToastProvider>

@code {
    /// <summary>The manager toasts are added to. Defaults to the provider's own.</summary>
    [Parameter] public ToastManager? ToastManager { get; set; }

    /// <summary>How long a toast stays, in milliseconds. Defaults to 5000.</summary>
    [Parameter] public int Timeout { get; set; } = 5000;

    /// <summary>How many toasts show at once; the others wait. Defaults to 3.</summary>
    [Parameter] public int Limit { get; set; } = 3;

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
