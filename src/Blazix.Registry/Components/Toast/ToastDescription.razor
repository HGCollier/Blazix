@namespace Blazix.Registry
@using static Blazix.Registry.ClassNames

<Blazix.Primitives.ToastDescription data-slot="toast-description" @attributes="AdditionalAttributes"
                                  class="@Cn("text-sm text-muted-foreground", Class)"
                                  ChildContent="@ChildContent" />

@code {
    [Parameter] public string? Class { get; set; }
    /// <summary>Overrides the toast's own text. Passed as a parameter, so leaving it out shows the toast's.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
