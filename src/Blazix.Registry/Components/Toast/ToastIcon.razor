@namespace Blazix.Registry
@if (Type is { } type)
{
    <span data-slot="toast-icon" class="@("shrink-0 [&_svg]:pointer-events-none [&_svg:not([class*='size-'])]:size-4")">
        @switch (type)
        {
            case ToastIconType.Success:
                <IconPlaceholder Lucide="circle-check" Tabler="circle-check" Hugeicons="checkmark-circle-02" Phosphor="check-circle" Remixicon="checkbox-circle-line" FontAwesome="circle-check"
                                 aria-hidden="true" />
                break;
            case ToastIconType.Info:
                <IconPlaceholder Lucide="info" Tabler="info-circle" Hugeicons="information-circle" Phosphor="info" Remixicon="information-line" FontAwesome="circle-info"
                                 aria-hidden="true" />
                break;
            case ToastIconType.Warning:
                <IconPlaceholder Lucide="triangle-alert" Tabler="alert-triangle" Hugeicons="alert-02" Phosphor="warning" Remixicon="error-warning-line" FontAwesome="triangle-exclamation"
                                 aria-hidden="true" />
                break;
            case ToastIconType.Error:
                <IconPlaceholder Lucide="octagon-x" Tabler="alert-octagon" Hugeicons="multiplication-sign-circle" Phosphor="x-circle" Remixicon="close-circle-line" FontAwesome="circle-xmark"
                                 aria-hidden="true" class="text-destructive" />
                break;
            case ToastIconType.Loading:
                <IconPlaceholder Lucide="loader-circle" Tabler="loader" Hugeicons="loading-03" Phosphor="spinner" Remixicon="loader-line" FontAwesome="circle-notch"
                                 aria-hidden="true" class="animate-spin" />
                break;
        }
    </span>
}

@code {
    /// <summary>The kind of toast this icon is for. Without one, nothing is drawn.</summary>
    [Parameter] public ToastIconType? Type { get; set; }
}
