@namespace Blazix.Registry
@using static Blazix.Registry.ClassNames

<Blazix.Primitives.ToastClose data-slot="toast-close" aria-label="Close toast" @attributes="AdditionalAttributes"
                            class="@ButtonVariants.Get(ButtonVariant.Ghost, ButtonSize.IconSm, Cn("relative shrink-0 text-muted-foreground after:absolute after:-inset-2 after:content-[''] hover:text-foreground", Class))">
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        <IconPlaceholder Lucide="x" Tabler="x" Hugeicons="cancel-01" Phosphor="x" Remixicon="close-line" FontAwesome="xmark"
                         aria-hidden="true" />
    }
</Blazix.Primitives.ToastClose>

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
