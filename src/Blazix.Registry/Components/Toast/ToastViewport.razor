@namespace Blazix.Registry
@using Blazix.Primitives
@using static Blazix.Registry.ClassNames

<Blazix.Primitives.ToastViewport data-slot="toast-viewport" @attributes="AdditionalAttributes" Template="@Template" SwipeDirections="@SwipeDirections"
                               class="@Cn(
                                   "pointer-events-none fixed inset-x-4 bottom-4 z-50 mx-auto w-auto max-w-sm outline-none sm:right-4 sm:left-auto " +
                                   "sm:mx-0 sm:w-full",
                                   Class)">
    @ChildContent
</Blazix.Primitives.ToastViewport>

@code {
    /// <summary>Renders each toast (newest first).</summary>
    [Parameter] public RenderFragment<ToastObject>? Template { get; set; }

    /// <summary>The directions a toast can be swiped away in. Defaults to down and right.</summary>
    [Parameter] public IReadOnlyList<string> SwipeDirections { get; set; } = ["down", "right"];

    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
