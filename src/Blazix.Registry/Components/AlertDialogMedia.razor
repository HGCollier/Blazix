@using static Blazix.Registry.ClassNames

<div data-slot="alert-dialog-media" @attributes="AdditionalAttributes"
     class="@Cn(
         "mb-2 inline-flex size-10 items-center justify-center rounded-md bg-muted sm:group-data-[size=default]/alert-dialog-content:row-span-2 " +
         "*:[svg:not([class*='size-'])]:size-6",
         Class)">
    @ChildContent
</div>

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
