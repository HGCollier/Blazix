@namespace Blazix.Registry
@using static Blazix.Registry.ClassNames

<CollapsibleTrigger data-slot="trace-collapsible-trigger" @attributes="AdditionalAttributes"
                    Class="@Cn(
                        "group/trace-collapsible-trigger flex w-fit max-w-full min-w-0 cursor-pointer items-center gap-1 rounded-md text-left " +
                        "text-muted-foreground transition-colors outline-none hover:text-foreground focus-visible:ring-3 " +
                        "focus-visible:ring-ring/50 has-[[data-status=error]]:text-destructive",
                        Class)">
    @ChildContent
    <TraceIcon Class="transition-transform group-aria-expanded/trace-collapsible-trigger:rotate-90">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m9 18 6-6-6-6" />
        </svg>
    </TraceIcon>
</CollapsibleTrigger>

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
