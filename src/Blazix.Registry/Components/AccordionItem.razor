@using Blazix.Primitives
@using static Blazix.Registry.ClassNames

<Blazix.Primitives.AccordionItem data-slot="accordion-item" @attributes="AdditionalAttributes" Render="@Render"
                               Value="@Value" Disabled="@Disabled" OnOpenChange="@OnOpenChange"
                               class="@Cn("not-last:border-b", Class)">
    @ChildContent
</Blazix.Primitives.AccordionItem>

@code {
    /// <summary>Render your own element or component; spread <c>props.Attributes</c> onto it.</summary>
    [Parameter] public RenderFragment<AccordionItemRenderProps>? Render { get; set; }

    /// <summary>Identifies the item in the accordion's value. Defaults to a generated id.</summary>
    [Parameter] public string? Value { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Runs before this item opens or closes; call <c>Cancel()</c> to keep it.</summary>
    [Parameter] public EventCallback<OpenChangeEventArgs> OnOpenChange { get; set; }

    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
