@namespace Blazix.Registry
@using Blazix.Primitives
@* A Button for the confirming action. It doesn't close the dialog by itself: close it from OnClick (bind Open). *@
<Button data-slot="alert-dialog-action" Type="@Type" @attributes="AdditionalAttributes" Variant="@Variant" Size="@Size" Disabled="@Disabled" Class="@Class">
    @ChildContent
</Button>

@code {
    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Default;
    [Parameter] public ButtonSize Size { get; set; } = ButtonSize.Default;
    [Parameter] public ButtonType Type { get; set; } = ButtonType.button;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
