@using static Blazix.Registry.ClassNames

<div data-slot="item-group" role="list" @attributes="AdditionalAttributes"
     class="@Cn(
         "group/item-group flex w-full flex-col gap-4 has-data-[size=sm]:gap-2.5 has-data-[size=xs]:gap-2",
         Class)">
    @* role="list": each Item in it is a listitem (Item adds the role). *@
    <CascadingValue Name="ItemGroup" Value="true" IsFixed="true">@ChildContent</CascadingValue>
</div>

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
