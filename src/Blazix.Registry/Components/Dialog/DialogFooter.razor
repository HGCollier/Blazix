@namespace Blazix.Registry
@using static Blazix.Registry.ClassNames

<div data-slot="dialog-footer" @attributes="AdditionalAttributes"
     class="@Cn("-mx-4 -mb-4 flex flex-col-reverse gap-2 rounded-b-xl border-t bg-muted/50 p-4 sm:flex-row sm:justify-end", Class)">
    @ChildContent
    @if (ShowCloseButton)
    {
        <Blazix.Primitives.DialogClose class="@ButtonVariants.Get(ButtonVariant.Outline)">Close</Blazix.Primitives.DialogClose>
    }
</div>

@code {
    /// <summary>Add an outline Close button after the content.</summary>
    [Parameter] public bool ShowCloseButton { get; set; }

    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
