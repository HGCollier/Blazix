@using static Blazix.Registry.ClassNames

<Blazix.Primitives.ProgressRoot data-slot="progress" @attributes="AdditionalAttributes" Render="@Render"
                              Value="@Value" Min="@Min" Max="@Max" Format="@Format" Culture="@Culture" GetAriaValueText="@GetAriaValueText"
                              class="@Cn("flex flex-wrap gap-3", Class)">
    @ChildContent
    <Blazix.Registry.ProgressTrack>
        <Blazix.Registry.ProgressIndicator />
    </Blazix.Registry.ProgressTrack>
</Blazix.Primitives.ProgressRoot>

@code {
    /// <summary>Render your own element or component; spread <c>props.Attributes</c> onto it.</summary>
    [Parameter] public RenderFragment<ProgressRenderProps>? Render { get; set; }

    /// <summary>The current value; null means indeterminate.</summary>
    [Parameter] public double? Value { get; set; }

    [Parameter] public double Min { get; set; }
    [Parameter] public double Max { get; set; } = 100;

    /// <summary>A .NET numeric format string for the value text (e.g. "P0").</summary>
    [Parameter] public string? Format { get; set; }

    [Parameter] public System.Globalization.CultureInfo? Culture { get; set; }
    [Parameter] public Func<string, double?, string>? GetAriaValueText { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
