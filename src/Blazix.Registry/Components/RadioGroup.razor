@using Blazix.Primitives
@using static Blazix.Registry.ClassNames

<RadioGroupRoot data-slot="radio-group" @attributes="FieldDescriptions.Merge(Descriptions, AdditionalAttributes)" Render="@Render"
                Value="@Value" ValueChanged="@ValueChanged" OnValueChange="@OnValueChange"
                Disabled="@Disabled" ReadOnly="@ReadOnly" Required="@Required" Name="@Name"
                class="@Cn("grid w-full gap-2", Class)">
    @ChildContent
</RadioGroupRoot>

@code {
    /// <summary>Render your own element or component; spread <c>props.Attributes</c> onto it.</summary>
    [Parameter] public RenderFragment<RadioGroupRenderProps>? Render { get; set; }

    /// <summary>The checked item's value. Supports <c>@bind-Value</c>; set it once for an uncontrolled group.</summary>
    [Parameter] public string? Value { get; set; }

    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>Runs before the value changes; call <c>Cancel()</c> to keep it.</summary>
    [Parameter] public EventCallback<ValueChangeEventArgs<string?>> OnValueChange { get; set; }

    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Required { get; set; }

    /// <summary>The name submitted with the form. Defaults to the field's name.</summary>
    [Parameter] public string? Name { get; set; }

    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    [CascadingParameter] private FieldDescriptions? Descriptions { get; set; }
}
