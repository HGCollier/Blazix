@using static Blazix.Registry.ClassNames

<Button Variant="@(IsActive ? ButtonVariant.Outline : ButtonVariant.Ghost)" Size="@Size" Class="@Cn(IsActive ? "border-input dark:border-input" : null, Class)" NativeButton="false">
    <Render>
        <a aria-current="@(IsActive ? "page" : null)" data-slot="pagination-link" data-active="@(IsActive ? "true" : null)"
           @attributes="Merge(context.Attributes)">@ChildContent</a>
    </Render>
</Button>

@code {
    /// <summary>Whether this is the current page.</summary>
    [Parameter] public bool IsActive { get; set; }

    [Parameter] public ButtonSize Size { get; set; } = ButtonSize.Icon;

    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    // The button's attributes, then the link's own (href...).
    private IReadOnlyDictionary<string, object> Merge(IReadOnlyDictionary<string, object> button) =>
        MergeProps.Merge(button, AdditionalAttributes);
}
