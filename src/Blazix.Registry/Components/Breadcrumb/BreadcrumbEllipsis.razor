@namespace Blazix.Registry
@using static Blazix.Registry.ClassNames

<span data-slot="breadcrumb-ellipsis" role="presentation" aria-hidden="true" @attributes="AdditionalAttributes"
      class="@Cn("flex size-5 items-center justify-center [&>svg]:size-4", Class)">
    <IconPlaceholder Lucide="ellipsis" Tabler="dots" Hugeicons="more-horizontal-circle-01" Phosphor="dots-three" Remixicon="more-line" FontAwesome="ellipsis"
                     aria-hidden="true" />
    <span class="sr-only">More</span>
</span>

@code {
    [Parameter] public string? Class { get; set; }
    
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

}
