@namespace Blazix.Registry
@using static Blazix.Registry.ClassNames

<li data-slot="breadcrumb-separator" role="presentation" aria-hidden="true" @attributes="AdditionalAttributes"
    class="@Cn("[&>svg]:size-3.5", Class)">
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        <IconPlaceholder Lucide="chevron-right" Tabler="chevron-right" Hugeicons="arrow-right-01" Phosphor="caret-right" Remixicon="arrow-right-s-line" FontAwesome="chevron-right"
                         aria-hidden="true" class="cn-rtl-flip" />
    }
</li>

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
