@namespace Blazix.Registry
@using Blazix.Primitives
@using static Blazix.Registry.ClassNames

<AccordionRoot data-slot="accordion" @attributes="AdditionalAttributes" Render="@Render"
               Value="@Value" ValueChanged="@ValueChanged" OnValueChange="@OnValueChange"
               Multiple="@Multiple" Disabled="@Disabled" Orientation="@Orientation" LoopFocus="@LoopFocus"
               KeepMounted="@KeepMounted" HiddenUntilFound="@HiddenUntilFound"
               class="@Cn("flex w-full flex-col", Class)">
    @ChildContent
</AccordionRoot>

@code {
    /// <summary>Render your own element or component; spread <c>props.Attributes</c> onto it.</summary>
    [Parameter] public RenderFragment<AccordionRenderProps>? Render { get; set; }

    /// <summary>The open items' values. Supports <c>@bind-Value</c>; set it once for an uncontrolled accordion.</summary>
    [Parameter] public IReadOnlyList<string>? Value { get; set; }

    [Parameter] public EventCallback<IReadOnlyList<string>?> ValueChanged { get; set; }

    /// <summary>Runs before the value changes; call <c>Cancel()</c> to keep it.</summary>
    [Parameter] public EventCallback<ValueChangeEventArgs<IReadOnlyList<string>>> OnValueChange { get; set; }

    /// <summary>Whether several items can be open at once.</summary>
    [Parameter] public bool Multiple { get; set; }

    [Parameter] public bool Disabled { get; set; }
    [Parameter] public Orientation Orientation { get; set; } = Orientation.Vertical;
    [Parameter] public bool LoopFocus { get; set; } = true;
    [Parameter] public bool KeepMounted { get; set; }
    [Parameter] public bool HiddenUntilFound { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
