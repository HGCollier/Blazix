@namespace Blazix.Registry
@using Blazix.Primitives
@using static Blazix.Registry.ClassNames

<div class="overflow-hidden" data-slot="carousel-content">
    <div @attributes="AdditionalAttributes"
         class="@Cn("flex", Carousel.Orientation == Orientation.Horizontal ? "-ms-4" : "-mt-4 flex-col", Class)">
        @ChildContent
    </div>
</div>

@code {
    [CascadingParameter] private CarouselContext Carousel { get; set; } = null!;

    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    protected override void OnParametersSet()
    {
        if (Carousel is null)
            throw new InvalidOperationException("CarouselContent must be used within a <Carousel>.");
    }
}
