@namespace Blazix.Registry
@using Blazix.Primitives
@using static Blazix.Registry.ClassNames

<Button data-slot="carousel-previous" Type="@Type" Variant="@Variant" Size="@Size" Disabled="@(!Carousel.CanScrollPrev)"
        @onclick="Carousel.ScrollPrevAsync" @attributes="AdditionalAttributes"
        Class="@Cn("absolute touch-manipulation rounded-full",
                   Carousel.Orientation == Orientation.Horizontal ? "inset-y-0 -inset-s-12 my-auto" : "-top-12 left-1/2 -translate-x-1/2 rotate-90",
                   Class)">
    <IconPlaceholder Lucide="chevron-left" Tabler="chevron-left" Hugeicons="arrow-left-01" Phosphor="caret-left" Remixicon="arrow-left-s-line" FontAwesome="chevron-left"
                     aria-hidden="true" class="cn-rtl-flip" />
    <span class="sr-only">Previous slide</span>
</Button>

@code {
    [CascadingParameter] private CarouselContext Carousel { get; set; } = null!;

    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Outline;
    [Parameter] public ButtonSize Size { get; set; } = ButtonSize.IconSm;
    [Parameter] public ButtonType Type { get; set; } = ButtonType.button;
    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    protected override void OnParametersSet()
    {
        if (Carousel is null)
            throw new InvalidOperationException("CarouselPrevious must be used within a <Carousel>.");
    }
}
