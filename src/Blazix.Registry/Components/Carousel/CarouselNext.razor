@namespace Blazix.Registry
@using Blazix.Primitives
@using static Blazix.Registry.ClassNames

<Button data-slot="carousel-next" Variant="@Variant" Size="@Size" Disabled="@(!Carousel.CanScrollNext)"
        @onclick="Carousel.ScrollNextAsync" @attributes="AdditionalAttributes"
        Class="@Cn("absolute touch-manipulation rounded-full",
                   Carousel.Orientation == Orientation.Horizontal ? "inset-y-0 -right-12 my-auto" : "-bottom-12 left-1/2 -translate-x-1/2 rotate-90",
                   Class)">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="cn-rtl-flip">
        <path d="m9 18 6-6-6-6" />
    </svg>
    <span class="sr-only">Next slide</span>
</Button>

@code {
    [CascadingParameter] private CarouselContext Carousel { get; set; } = null!;

    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Outline;
    [Parameter] public ButtonSize Size { get; set; } = ButtonSize.IconSm;
    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    protected override void OnParametersSet()
    {
        if (Carousel is null)
            throw new InvalidOperationException("CarouselNext must be used within a <Carousel>.");
    }
}
