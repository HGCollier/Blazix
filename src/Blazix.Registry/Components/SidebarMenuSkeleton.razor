@using static Blazix.Registry.ClassNames

<div data-slot="sidebar-menu-skeleton" data-sidebar="menu-skeleton" @attributes="AdditionalAttributes"
     class="@Cn("flex h-8 items-center gap-2 rounded-md px-2", Class)">
    @if (ShowIcon)
    {
        <Skeleton Class="size-4 rounded-md" data-sidebar="menu-skeleton-icon" />
    }
    <Skeleton Class="h-4 max-w-(--skeleton-width) flex-1" data-sidebar="menu-skeleton-text" style="@($"--skeleton-width:{_width}")" />
</div>

@code {
    // Between 50 and 90%.
    private readonly string _width = $"{Random.Shared.Next(50, 90)}%";

    [Parameter] public bool ShowIcon { get; set; }
    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
