@namespace Blazix.Registry
@using Blazix.Primitives
@using static Blazix.Registry.ClassNames

<UseRender DefaultTagName="div" Render="@Render" data-slot="item" data-variant="@VariantName" data-size="@SizeName" role="@Role" @attributes="AdditionalAttributes"
           class="@Cn(
                 "group/item flex w-full flex-wrap items-center rounded-lg border text-sm transition-colors duration-100 outline-none " +
                 "focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 [a]:transition-colors [a]:hover:bg-muted",
                 Variant switch
                 {
                     ItemVariant.Outline => "border-border",
                     ItemVariant.Muted => "border-transparent bg-muted/50",
                     _ => "border-transparent",
                 },
                 Size == ItemSize.Xs ? "gap-2 px-2.5 py-2 in-data-[slot=dropdown-menu-content]:p-0" : "gap-2.5 px-3 py-2.5",
                 Class)">
    @ChildContent
</UseRender>

@code {
    /// <summary>
    /// Render your own element or component; spread <c>props.Attributes</c> onto it. Inside an ItemGroup (a list), wrap an
    /// item you render as a link or button in <c>&lt;div role="listitem"&gt;</c>: the role would replace the link's or button's.
    /// </summary>
    [Parameter] public RenderFragment<UseRenderProps>? Render { get; set; }

    [CascadingParameter(Name = "ItemGroup")] private bool InGroup { get; set; }

    // In an ItemGroup's list, an item rendered as itself is a listitem; one rendered as a link or button keeps its role.
    private string? Role => InGroup && Render is null ? "listitem" : null;

    [Parameter] public ItemVariant Variant { get; set; } = ItemVariant.Default;
    [Parameter] public ItemSize Size { get; set; } = ItemSize.Default;

    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string VariantName => Variant switch
    {
        ItemVariant.Outline => "outline",
        ItemVariant.Muted => "muted",
        _ => "default",
    };
    
    private string SizeName => Size switch
    {
        ItemSize.Sm => "sm",
        ItemSize.Xs => "xs",
        _ => "default",
    };
}
