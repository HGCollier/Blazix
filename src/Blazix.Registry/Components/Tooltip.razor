@using Blazix.Primitives

<TooltipRoot Open="@Open" OpenChanged="@OpenChanged" OnOpenChange="@OnOpenChange" OnOpenChangeComplete="@OnOpenChangeComplete"
             Disabled="@Disabled" HoverablePopup="@HoverablePopup">
    @ChildContent
</TooltipRoot>

@code {
    /// <summary>Supports <c>@bind-Open</c>; leave unset to let the tooltip manage itself.</summary>
    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>Runs before the tooltip opens or closes, with the reason; call <c>Cancel()</c> to keep it as it is.</summary>
    [Parameter] public EventCallback<OpenChangeEventArgs> OnOpenChange { get; set; }

    /// <summary>Runs once the open or close animation has finished.</summary>
    [Parameter] public EventCallback<bool> OnOpenChangeComplete { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Whether the pointer may move into the tooltip without closing it. Defaults to true.</summary>
    [Parameter] public bool HoverablePopup { get; set; } = true;

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
