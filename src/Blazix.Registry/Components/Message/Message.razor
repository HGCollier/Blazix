@namespace Blazix.Registry
@using static Blazix.Registry.ClassNames

<div data-slot="message" data-align="@(Align == MessageAlign.End ? "end" : "start")" @attributes="AdditionalAttributes"
     class="@Cn("group/message relative flex w-full min-w-0 gap-2 text-sm data-[align=end]:flex-row-reverse", Class)">
    @ChildContent
</div>

@code {
    [Parameter] public MessageAlign Align { get; set; } = MessageAlign.Start;

    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
