@namespace Blazix.Registry
@using Blazix.Primitives
@using static Blazix.Registry.ClassNames

<div role="separator" id="@_id" aria-label="Resize" aria-orientation="@(Group?.Orientation == Orientation.Vertical ? "horizontal" : "vertical")"
     aria-disabled="@(Disabled ? "true" : null)" tabindex="@(Disabled ? null : "0")"
     data-slot="resizable-handle" @attributes="OuterAttributes" data-separator="@(Disabled ? "disabled" : "inactive")"
     class="@Cn("relative flex w-px items-center justify-center bg-input ring-offset-background after:absolute after:inset-y-0 after:left-1/2 after:w-1 after:-translate-x-1/2 focus-visible:ring-1 focus-visible:ring-ring focus-visible:outline-hidden aria-[orientation=horizontal]:h-px aria-[orientation=horizontal]:w-full aria-[orientation=horizontal]:after:left-0 aria-[orientation=horizontal]:after:h-1 aria-[orientation=horizontal]:after:w-full aria-[orientation=horizontal]:after:translate-x-0 aria-[orientation=horizontal]:after:-translate-y-1/2 [&[aria-orientation=horizontal]>div]:rotate-90", Class)"
     style="@($"flex-basis: auto; {(Disabled && Group?.DisableCursor != true ? "cursor: not-allowed; " : "")}{UserStyle}flex-grow: 0; flex-shrink: 0; touch-action: none;")">
    @if (WithHandle)
    {
        <div class="z-10 flex h-6 w-1 shrink-0 rounded-lg bg-input"></div>
    }
    @ChildContent
</div>

@code {
    private string _id = $"resizable-handle-{Guid.NewGuid():N}";

    [CascadingParameter] private ResizablePanelGroup? Group { get; set; }

    /// <summary>Shows a visible grip on the handle.</summary>
    [Parameter] public bool WithHandle { get; set; }

    /// <summary>Stops the handle from resizing its panels.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>The handle element's id. Generated when not set.</summary>
    [Parameter] public string? Id { get; set; }

    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private IEnumerable<KeyValuePair<string, object>>? OuterAttributes => AdditionalAttributes?.Where(attribute => attribute.Key != "style");

    private string UserStyle => AdditionalAttributes?.GetValueOrDefault("style") is { } style ? $"{style}; " : "";

    protected override void OnParametersSet()
    {
        if (Id is not null)
            _id = Id;
    }
}
