@namespace Blazix.Registry
@using System.Globalization
@using Microsoft.JSInterop
@using Blazix.Primitives
@using static Blazix.Registry.ClassNames
@implements IAsyncDisposable

<CascadingValue Value="this">
    <div @ref="_element" data-slot="resizable-panel-group" @attributes="AdditionalAttributes" data-group id="@_id"
         class="@Cn("flex h-full w-full aria-[orientation=vertical]:flex-col", Class)"
         style="@($"height: 100%; width: 100%; overflow: hidden; {UserStyle}display: flex; flex-direction: {(Orientation == Orientation.Horizontal ? "row" : "column")}; flex-wrap: nowrap; touch-action: {(Orientation == Orientation.Horizontal ? "pan-y" : "pan-x")};")">
        @ChildContent
    </div>
</CascadingValue>

@code {
    private ElementReference _element;
    private IJSObjectReference? _module;
    private IJSObjectReference? _controller;
    private DotNetObjectReference<Interop>? _interop;
    private string? _optionsKey;
    private string _id = $"resizable-group-{Guid.NewGuid():N}";
    private bool _disposed;

    [Inject] private IJSRuntime JsRuntime { get; set; } = null!;

    /// <summary>The direction panels are laid out and resized in.</summary>
    [Parameter] public Orientation Orientation { get; set; } = Orientation.Horizontal;

    /// <summary>
    /// The initial layout: a percentage (0..100) for each panel, keyed by panel <c>Id</c>. Ignored unless it names every panel;
    /// panels' <c>DefaultSize</c> is used instead.
    /// </summary>
    [Parameter] public IReadOnlyDictionary<string, double>? DefaultLayout { get; set; }

    /// <summary>Stops the panels from being resized with the pointer or keyboard.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Stops the group from setting the global cursor while a separator is hovered or dragged.</summary>
    [Parameter] public bool DisableCursor { get; set; }

    /// <summary>Called whenever the layout changes, including while a separator is being dragged; panel sizes are percentages keyed by panel <c>Id</c>.</summary>
    [Parameter] public EventCallback<IReadOnlyDictionary<string, double>> OnLayoutChange { get; set; }

    /// <summary>Called once a layout change has finished, e.g. when the pointer is released; panel sizes are percentages keyed by panel <c>Id</c>.</summary>
    [Parameter] public EventCallback<IReadOnlyDictionary<string, double>> OnLayoutChanged { get; set; }

    /// <summary>The group element's id. Generated when not set.</summary>
    [Parameter] public string? Id { get; set; }

    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string UserStyle => AdditionalAttributes?.GetValueOrDefault("style") is { } style ? $"{style}; " : "";

    protected override void OnParametersSet()
    {
        if (Id is not null)
            _id = Id;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // A dictionary, not an anonymous type: JS interop reflects over the argument, and trimming removes an
        // anonymous type's members.
        var options = new Dictionary<string, object?>
        {
            ["orientation"] = Orientation == Orientation.Horizontal ? "horizontal" : "vertical",
            ["disabled"] = Disabled,
            ["disableCursor"] = DisableCursor,
            ["defaultLayout"] = DefaultLayout,
            ["notifyChange"] = OnLayoutChange.HasDelegate,
            ["notifyChanged"] = OnLayoutChanged.HasDelegate,
        };
        // What changed, built by hand rather than with JsonSerializer (which would need reflection).
        var layout = DefaultLayout is null ? "" : string.Join(",", DefaultLayout.Select(p => string.Create(CultureInfo.InvariantCulture, $"{p.Key}={p.Value}")));
        var key = string.Join("|", options.Where(p => p.Key != "defaultLayout").Select(p => p.Value)) + "|" + layout;
        if (key == _optionsKey)
            return;

        _optionsKey = key;
        if (_controller is null)
        {
            _module = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./_content/Blazix.Primitives/resizable.js");
            // Removed while the module loaded. The first import can take a while (in Firefox especially), long
            // enough to navigate away: the element is gone, and DisposeAsync ran before there was a module.
            if (_disposed)
            {
                await DisposeJsAsync();
                return;
            }
            _interop = DotNetObjectReference.Create(new Interop(this));
            _controller = await _module.InvokeAsync<IJSObjectReference>("createGroup", _element, _interop, options);
            if (_disposed)
            {
                // ...or while the group started: stop it too, or its document listeners stay.
                await DisposeJsAsync();
            }
        }
        else
        {
            await _controller.InvokeVoidAsync("update", options);
        }
    }

    /// <summary>
    /// Sets panel sizes, as percentages by panel id, within the panels' limits; panels left out share what remains.
    /// Use it to offer a way to resize without dragging, such as buttons: WCAG 2.5.7 asks for one wherever dragging
    /// changes something, and the handles' arrow keys only help keyboard users.
    /// </summary>
    public async Task SetLayoutAsync(IReadOnlyDictionary<string, double> layout)
    {
        if (_controller is not null)
        {
            await _controller.InvokeVoidAsync("setLayout", layout);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await DisposeJsAsync();
    }

    // Takes each reference first: a first render that outlived the component runs this too, after DisposeAsync.
    private async Task DisposeJsAsync()
    {
        var controller = _controller;
        var module = _module;
        _controller = null;
        _module = null;
        try
        {
            if (controller is not null)
            {
                await controller.InvokeVoidAsync("dispose");
                await controller.DisposeAsync();
            }
            if (module is not null)
                await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, and the page with it.
        }
        _interop?.Dispose();
    }

    private sealed class Interop(ResizablePanelGroup owner)
    {
        [JSInvokable]
        public Task LayoutChange(Dictionary<string, double> layout) => owner.OnLayoutChange.InvokeAsync(layout);

        [JSInvokable]
        public Task LayoutChanged(Dictionary<string, double> layout) => owner.OnLayoutChanged.InvokeAsync(layout);
    }
}
