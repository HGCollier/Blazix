@using Blazix.Primitives
@using static Blazix.Registry.ClassNames

<RadioRoot data-slot="radio-group-item" @attributes="AdditionalAttributes" Render="@Render"
           Value="@Value" Disabled="@Disabled" ReadOnly="@ReadOnly" Required="@Required" InputId="@InputId"
           class="@Cn(
               "group/radio-group-item peer relative flex aspect-square size-4 shrink-0 rounded-full border border-input outline-none " +
               "group-has-[:focus-visible]/field-label:ring-0 group-has-[:focus-visible]/field-label:not-data-checked:border-input " +
               "after:absolute after:-inset-x-3 after:-inset-y-2 focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 " +
               "disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 " +
               "aria-invalid:aria-checked:border-primary dark:bg-input/15 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 aria-invalid:focus-visible:ring-destructive/60 dark:aria-invalid:focus-visible:ring-destructive/60 " +
               "data-checked:border-primary data-checked:bg-primary data-checked:text-primary-foreground " +
               "group-has-[:focus-visible]/field-label:data-checked:border-primary dark:data-checked:bg-primary",
               Class)">
    <RadioIndicator data-slot="radio-group-indicator" class="flex size-4 items-center justify-center">
        <span class="absolute top-1/2 left-1/2 size-2 -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary-foreground"></span>
    </RadioIndicator>
</RadioRoot>

@code {
    /// <summary>Render your own element or component; spread <c>props.Attributes</c> onto it.</summary>
    [Parameter] public RenderFragment<RadioRenderProps>? Render { get; set; }

    /// <summary>The group's value when this item is checked.</summary>
    [Parameter, EditorRequired] public string Value { get; set; } = "";

    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Required { get; set; }

    /// <summary>The id of the hidden native input, for a &lt;label for="..."&gt;.</summary>
    [Parameter] public string? InputId { get; set; }

    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
