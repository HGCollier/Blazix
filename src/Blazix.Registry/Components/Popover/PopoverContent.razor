@namespace Blazix.Registry
@using Blazix.Primitives
@using static Blazix.Registry.ClassNames

<PopoverPopup data-slot="popover-content" @attributes="AdditionalAttributes" Render="@Render"
              Side="@Side" Align="@Align" SideOffset="@SideOffset" AlignOffset="@AlignOffset"
              InitialFocus="@InitialFocus" FinalFocus="@FinalFocus" PositionerAttributes="@Positioner"
              class="@Cn(
                  "z-50 flex w-72 origin-(--transform-origin) flex-col gap-2.5 rounded-lg bg-popover p-2.5 text-sm text-popover-foreground shadow-md ring-1 ring-foreground/10 outline-hidden duration-100 " +
                  "data-[side=bottom]:slide-in-from-top-2 data-[side=inline-end]:slide-in-from-left-2 data-[side=inline-start]:slide-in-from-right-2 " +
                  "data-[side=left]:slide-in-from-right-2 data-[side=right]:slide-in-from-left-2 data-[side=top]:slide-in-from-bottom-2 " +
                  "data-open:animate-in data-open:fade-in-0 data-open:zoom-in-95 data-closed:animate-out data-closed:fade-out-0 data-closed:zoom-out-95",
                  Class)">
    @ChildContent
</PopoverPopup>

@code {
    private static readonly IReadOnlyDictionary<string, object> Positioner = new Dictionary<string, object> { ["class"] = "isolate z-50" };

    /// <summary>Render your own element or component; spread <c>props.Attributes</c> onto it.</summary>
    [Parameter] public RenderFragment<PopupRenderProps>? Render { get; set; }

    [Parameter] public Side Side { get; set; } = Side.Bottom;
    [Parameter] public Align Align { get; set; } = Align.Center;
    [Parameter] public int SideOffset { get; set; } = 4;
    [Parameter] public int AlignOffset { get; set; }

    /// <summary>What gets focus on open: a CSS selector inside the popover, "popup", or "none".</summary>
    [Parameter] public string? InitialFocus { get; set; }

    /// <summary>The id of the element that gets focus on close. Defaults to the trigger.</summary>
    [Parameter] public string? FinalFocus { get; set; }

    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
