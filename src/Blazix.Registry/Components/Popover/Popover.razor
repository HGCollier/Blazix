@namespace Blazix.Registry
@using Blazix.Primitives

<PopoverRoot Open="@Open" OpenChanged="@OpenChanged" OnOpenChange="@OnOpenChange" OnOpenChangeComplete="@OnOpenChangeComplete" Modal="@Modal">
    @ChildContent
</PopoverRoot>

@code {
    /// <summary>Supports <c>@bind-Open</c>; leave unset to let the popover manage itself.</summary>
    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>Runs before the popover opens or closes, with the reason; call <c>Cancel()</c> to keep it as it is.</summary>
    [Parameter] public EventCallback<OpenChangeEventArgs> OnOpenChange { get; set; }

    /// <summary>Runs once the open or close animation has finished.</summary>
    [Parameter] public EventCallback<bool> OnOpenChangeComplete { get; set; }

    /// <summary>Whether focus is trapped and the page behind is inert while open. Defaults to false.</summary>
    [Parameter] public PopupModal Modal { get; set; } = PopupModal.False;

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
