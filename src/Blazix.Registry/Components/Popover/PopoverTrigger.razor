@namespace Blazix.Registry
@using Blazix.Primitives

<Blazix.Primitives.PopoverTrigger data-slot="popover-trigger" @attributes="AdditionalAttributes" Render="@Render" NativeButton="@NativeButton" Disabled="@Disabled"
                                OpenOnHover="@OpenOnHover" Delay="@Delay" CloseDelay="@CloseDelay" class="@Class">
    @ChildContent
</Blazix.Primitives.PopoverTrigger>

@code {
    /// <summary>Render your own element or component; spread <c>props.Attributes</c> onto it.</summary>
    [Parameter] public RenderFragment<PopupTriggerRenderProps>? Render { get; set; }

    /// <summary>Leave unset: whether Render produced a real &lt;button&gt; is detected. Set it to skip the check.</summary>
    [Parameter] public bool? NativeButton { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Also open when the pointer rests on the trigger.</summary>
    [Parameter] public bool OpenOnHover { get; set; }

    /// <summary>How long the pointer rests before opening, in milliseconds. Defaults to 300.</summary>
    [Parameter] public int Delay { get; set; } = 300;

    /// <summary>How long after the pointer leaves before closing, in milliseconds.</summary>
    [Parameter] public int CloseDelay { get; set; }

    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
