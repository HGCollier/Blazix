@namespace Blazix.Registry
@using static Blazix.Registry.ClassNames

<div data-slot="code-block-actions" @attributes="AdditionalAttributes"
     class="@Cn(
         "-my-1 ms-auto -me-1.5 flex shrink-0 items-center gap-1 [[data-slot=code-block]>&]:absolute " +
         "[[data-slot=code-block]>&]:end-2 [[data-slot=code-block]>&]:top-2 [[data-slot=code-block]>&]:z-10 " +
         "[[data-slot=code-block]>&]:m-0 [[data-slot=code-block]>&]:opacity-0 [[data-slot=code-block]>&]:transition-opacity " +
         "[[data-slot=code-block]>&]:group-focus-within/code-block:opacity-100 " +
         "[[data-slot=code-block]>&]:group-hover/code-block:opacity-100 " +
         "group-data-[size=sm]/code-block:[[data-slot=code-block]>&]:end-1.5 " +
         "group-data-[size=sm]/code-block:[[data-slot=code-block]>&]:top-1.5 [[data-slot=code-block]>&]:pointer-coarse:opacity-100 " +
         "[[data-slot=code-block]>&]:*:[button]:bg-background [[data-slot=code-block]>&]:*:[button]:ring-1 " +
         "[[data-slot=code-block]>&]:*:[button]:ring-foreground/10",
         Class)">
    @ChildContent
</div>

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
