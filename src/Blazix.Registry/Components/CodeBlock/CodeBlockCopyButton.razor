@namespace Blazix.Registry
@using Blazix.Primitives
@using Microsoft.JSInterop
@using static Blazix.Registry.ClassNames
@implements IDisposable

<Button data-slot="code-block-copy-button" data-copied="@_copied" Variant="@Variant" Size="@Size" aria-label="@(_copied ? "Copied" : "Copy")"
        @attributes="AdditionalAttributes" Class="@Cn(Class)" @onclick="CopyAsync">
    @if (_copied)
    {
        <IconPlaceholder Lucide="check" Tabler="check" Hugeicons="tick-02" Phosphor="check" Remixicon="check-line" FontAwesome="check"
                         aria-hidden="true" />
    }
    else
    {
        <IconPlaceholder Lucide="copy" Tabler="copy" Hugeicons="copy-01" Phosphor="copy" Remixicon="file-copy-line" FontAwesome="copy"
                         aria-hidden="true" />
    }
</Button>
<span aria-live="polite" class="sr-only">@(_copied ? "Copied" : "")</span>

@code {
    private bool _copied;
    private CancellationTokenSource? _reset;

    [Inject] private IJSRuntime JsRuntime { get; set; } = null!;

    /// <summary>The text to copy.</summary>
    [Parameter, EditorRequired] public string Value { get; set; } = "";

    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Ghost;
    [Parameter] public ButtonSize Size { get; set; } = ButtonSize.IconXs;
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private async Task CopyAsync(MouseEventArgs e)
    {
        await OnClick.InvokeAsync(e);
        if (!await BrowserClipboard.CopyAsync(JsRuntime, Value))
        {
            return;
        }
        _copied = true;
        if (_reset is not null)
        {
            await _reset.CancelAsync();
            _reset.Dispose();
        }
        _reset = new CancellationTokenSource();
        var token = _reset.Token;
        try
        {
            await Task.Delay(2000, token);
            _copied = false;
            StateHasChanged();
        }
        catch (TaskCanceledException)
        {
            // Copied again: the newer press resets it.
        }
    }

    public void Dispose()
    {
        _reset?.Cancel();
        _reset?.Dispose();
    }
}
