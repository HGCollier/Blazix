@namespace Blazix.Registry
@using static Blazix.Registry.ClassNames

<div data-slot="code-block-header" @attributes="AdditionalAttributes"
     class="@Cn(
         "flex min-w-0 shrink-0 items-center gap-2 px-3 pt-3 text-muted-foreground group-data-[size=sm]/code-block:px-2.5 " +
         "group-data-[size=sm]/code-block:pt-2.5 group-data-[variant=destructive]/code-block:text-destructive " +
         "*:has-[>[data-slot=code-block-title]]:min-w-0",
         Class)">
    @ChildContent
</div>

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
