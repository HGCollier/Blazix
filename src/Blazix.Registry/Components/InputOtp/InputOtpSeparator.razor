@namespace Blazix.Registry
@* A Class replaces the default classes rather than adding to them. *@
<div data-slot="input-otp-separator" class="@(Class ?? "flex items-center [&_svg:not([class*='size-'])]:size-4")" role="separator"
     @attributes="AdditionalAttributes">
    <IconPlaceholder Lucide="minus" Tabler="minus" Hugeicons="minus-sign" Phosphor="minus" Remixicon="subtract-line" FontAwesome="minus"
                     aria-hidden="true" />
</div>

@code {
    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
