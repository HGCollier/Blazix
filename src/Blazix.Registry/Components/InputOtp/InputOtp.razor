@namespace Blazix.Registry
@using Microsoft.JSInterop
@using static Blazix.Registry.ClassNames
@implements IAsyncDisposable

@*
    One transparent input over the slots, so typing, Backspace, arrows, selection, paste and one-time-code autofill
    are the browser's own. Extra attributes (id, name, required, aria-*) go on that input.
*@
<div @ref="_container" data-input-otp-container translate="no"
     style="position: relative; cursor: @(Disabled ? "default" : "text"); user-select: none; -webkit-user-select: none; pointer-events: none;"
     class="@Cn("flex items-center gap-2 has-disabled:opacity-50", ContainerClass)">
    <CascadingValue Name="InputOtpValue" Value="_value">
        @ChildContent
    </CascadingValue>
    <div style="position: absolute; inset: 0; pointer-events: none;">
        <input @ref="_input" autocomplete="one-time-code" inputmode="numeric" data-slot="input-otp" @attributes="AdditionalAttributes"
               data-input-otp data-input-otp-placeholder-shown="@(_value.Length == 0)"
               pattern="@Pattern" maxlength="@MaxLength" value="@_value" @oninput="OnInputAsync" spellcheck="false" disabled="@Disabled"
               style="@InputStyle" class="@Cn("disabled:cursor-not-allowed", Class)" />
    </div>
</div>

@code {
    private const string InputStyle =
        "position: absolute; inset: 0; width: 100%; height: 100%; display: flex; text-align: left; opacity: 1; " +
        "color: transparent; pointer-events: all; background: transparent; caret-color: transparent; " +
        "border: 0 solid transparent; outline: 0 solid transparent; box-shadow: none; line-height: 1; " +
        "letter-spacing: -.5em; font-size: var(--root-height, 16px); font-family: monospace; font-variant-numeric: tabular-nums;";

    private ElementReference _container;
    private ElementReference _input;
    private IJSObjectReference? _module;
    private IJSObjectReference? _controller;
    private string _value = "";
    private string _painted = "";
    private bool _initialized;

    [Inject] private IJSRuntime JsRuntime { get; set; } = null!;

    /// <summary>How many characters the code has.</summary>
    [Parameter, EditorRequired] public int MaxLength { get; set; }

    /// <summary>A regular expression the whole value must match, e.g. <c>InputOtpPatterns.OnlyDigits</c>. Input that doesn't match is ignored.</summary>
    [Parameter] public string? Pattern { get; set; }

    /// <summary>The code typed so far. Use <c>@bind-Value</c>, or leave unset for an uncontrolled input.</summary>
    [Parameter] public string? Value { get; set; }

    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    /// <summary>The initial code of an uncontrolled input.</summary>
    [Parameter] public string? DefaultValue { get; set; }

    /// <summary>Runs with the code once every slot is filled.</summary>
    [Parameter] public EventCallback<string> OnComplete { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Classes for the input (which is invisible).</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Classes for the container that lays out the groups and separators.</summary>
    [Parameter] public string? ContainerClass { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (!_initialized)
        {
            _initialized = true;
            _value = _painted = Value ?? DefaultValue ?? "";
        }
        else if (Value is not null && Value != _value)
        {
            await SetValueAsync(Value, notify: false);
        }
    }

    private Task OnInputAsync(ChangeEventArgs e)
    {
        _painted = e.Value as string ?? "";
        return SetValueAsync(_painted, notify: true);
    }

    private async Task SetValueAsync(string value, bool notify)
    {
        var previous = _value;
        _value = value;
        if (notify)
            await ValueChanged.InvokeAsync(value);
        if (value != previous && previous.Length < MaxLength && value.Length == MaxLength)
            await OnComplete.InvokeAsync(value);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./_content/Blazix.Primitives/input-otp.js");
            _controller = await _module.InvokeAsync<IJSObjectReference>("createInputOtp", _input, _container);
        }
        else if (_controller is not null && _painted != _value)
        {
            _painted = _value;
            await _controller.InvokeVoidAsync("sync");
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_controller is not null)
            {
                await _controller.InvokeVoidAsync("dispose");
                await _controller.DisposeAsync();
            }
            if (_module is not null)
                await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, and the page with it.
        }
    }
}
