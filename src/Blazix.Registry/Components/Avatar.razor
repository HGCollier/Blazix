@using Blazix.Primitives
@using static Blazix.Registry.ClassNames

<AvatarRoot data-slot="avatar" @attributes="AdditionalAttributes" Render="@Render"
            data-size="@SizeName"
            class="@Cn(
                "group/avatar relative flex size-8 shrink-0 rounded-full select-none after:absolute after:inset-0 after:rounded-full after:border after:border-border after:mix-blend-darken " +
                "data-[size=lg]:size-10 data-[size=sm]:size-6 dark:after:mix-blend-lighten",
                Class)">
    @ChildContent
</AvatarRoot>

@code {
    /// <summary>Render your own element or component; spread <c>props.Attributes</c> onto it.</summary>
    [Parameter] public RenderFragment<AvatarRenderProps>? Render { get; set; }

    [Parameter] public AvatarSize Size { get; set; } = AvatarSize.Default;
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string SizeName => Size switch
    {
        AvatarSize.Sm => "sm",
        AvatarSize.Lg => "lg",
        _ => "default",
    };
}
