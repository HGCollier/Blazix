@using Blazix.Primitives

<CascadingValue Value="@_settings" IsFixed="false">
    <DrawerRoot Open="@Open" OpenChanged="@OpenChanged" OnOpenChange="@OnOpenChange" OnOpenChangeComplete="@OnOpenChangeComplete"
                Modal="@(Modal ? PopupModal.True : PopupModal.False)" SwipeDirection="@SwipeDirection"
                SnapPoints="@SnapPoints" SnapPoint="@SnapPoint" SnapPointChanged="@SnapPointChanged" OnSnapPointChange="@OnSnapPointChange"
                DefaultSnapPoint="@DefaultSnapPoint" SnapToSequentialPoints="@SnapToSequentialPoints" DisablePointerDismissal="@DisablePointerDismissal">
        @ChildContent
    </DrawerRoot>
</CascadingValue>

@code {
    private DrawerSettings _settings = new(false, true, false, DrawerSwipeDirection.Down);

    /// <summary>Supports <c>@bind-Open</c>; leave unset to let the drawer manage itself.</summary>
    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public EventCallback<OpenChangeEventArgs> OnOpenChange { get; set; }
    [Parameter] public EventCallback<bool> OnOpenChangeComplete { get; set; }

    /// <summary>Whether focus is trapped and the page behind is inert, with an overlay. Defaults to true.</summary>
    [Parameter] public bool Modal { get; set; } = true;

    /// <summary>Show a handle to grab at the edge it's swiped toward. Defaults to false.</summary>
    [Parameter] public bool ShowSwipeHandle { get; set; }

    /// <summary>Which way it's swiped to close. Defaults to down (a bottom sheet).</summary>
    [Parameter] public DrawerSwipeDirection SwipeDirection { get; set; } = DrawerSwipeDirection.Down;

    /// <summary>Heights a bottom or top drawer rests at: fractions of the viewport (0 to 1), pixels, or px/rem strings.</summary>
    [Parameter] public IReadOnlyList<DrawerSnapPoint>? SnapPoints { get; set; }

    /// <summary>The snap point it rests at. Supports <c>@bind-SnapPoint</c>.</summary>
    [Parameter] public DrawerSnapPoint? SnapPoint { get; set; }

    [Parameter] public EventCallback<DrawerSnapPoint?> SnapPointChanged { get; set; }

    /// <summary>Runs before a swipe (or closing) changes the snap point; call <c>Cancel()</c> to stay put.</summary>
    [Parameter] public EventCallback<ValueChangeEventArgs<DrawerSnapPoint?>> OnSnapPointChange { get; set; }

    [Parameter] public DrawerSnapPoint? DefaultSnapPoint { get; set; }
    [Parameter] public bool SnapToSequentialPoints { get; set; }
    [Parameter] public bool DisablePointerDismissal { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override void OnParametersSet() =>
        _settings = new DrawerSettings(SnapPoints is { Count: > 0 }, Modal, ShowSwipeHandle, SwipeDirection);
}
