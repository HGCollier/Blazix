@using static Blazix.Registry.ClassNames

<div data-slot="attachment-group" @attributes="AdditionalAttributes"
     class="@Cn(
         "flex min-w-0 scroll-fade-x snap-x snap-mandatory scroll-px-1 scrollbar-none gap-3 overflow-x-auto overscroll-x-contain " +
         "py-1 *:data-[slot=attachment]:flex-none *:data-[slot=attachment]:snap-start",
         Class)">
    @ChildContent
</div>

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
