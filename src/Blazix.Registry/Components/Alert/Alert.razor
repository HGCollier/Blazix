@namespace Blazix.Registry
@using static Blazix.Registry.ClassNames

<div data-slot="alert" role="alert" @attributes="AdditionalAttributes"
     class="@Cn(
         "group/alert relative grid w-full gap-0.5 rounded-lg border px-2.5 py-2 text-left text-sm " +
         "has-data-[slot=alert-action]:relative has-data-[slot=alert-action]:pr-18 has-[>svg]:grid-cols-[auto_1fr] " +
         "has-[>svg]:gap-x-2 *:[svg]:row-span-2 *:[svg]:translate-y-0.5 *:[svg]:text-current *:[svg:not([class*='size-'])]:size-4",
         Variant == AlertVariant.Destructive
             ? "bg-card text-destructive *:data-[slot=alert-description]:text-destructive/90 *:[svg]:text-current"
             : "bg-card text-card-foreground",
         Class)">
    @ChildContent
</div>

@code {
    [Parameter] public AlertVariant Variant { get; set; } = AlertVariant.Default;

    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
