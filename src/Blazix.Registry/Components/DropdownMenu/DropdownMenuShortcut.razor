@namespace Blazix.Registry
@using static Blazix.Registry.ClassNames

@* Purely visual hint. It's in the item's text, so typeahead ignores it (it matches the start). *@
<span data-slot="dropdown-menu-shortcut" @attributes="AdditionalAttributes"
      class="@Cn("ml-auto text-xs tracking-widest text-muted-foreground group-focus/dropdown-menu-item:text-accent-foreground", Class)">
    @ChildContent
</span>

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
