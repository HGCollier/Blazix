@namespace Blazix.Registry
@using Blazix.Primitives
@using static Blazix.Registry.ClassNames

@* Focus follows the highlight (keyboard and hover), so focus: styles the highlighted item. *@
<MenuItem data-slot="dropdown-menu-item" @attributes="AdditionalAttributes" Render="@Render"
          OnClick="@OnClick"
          Disabled="@Disabled"
          CloseOnClick="@CloseOnClick"
          Label="@Label"
          data-inset="@Inset"
          data-variant="@(Destructive ? "destructive" : "default")"
          class="@Cn(
              "group/dropdown-menu-item relative flex cursor-default items-center gap-1.5 rounded-md px-1.5 py-1 text-sm outline-hidden select-none " +
              "focus:bg-accent focus-visible:ring-1 focus-visible:ring-inset focus-visible:ring-ring/50 data-[variant=destructive]:focus-visible:ring-destructive/60 focus:text-accent-foreground not-data-[variant=destructive]:focus:**:text-accent-foreground data-inset:pl-7 " +
              "data-[variant=destructive]:text-destructive data-[variant=destructive]:focus:bg-destructive/10 data-[variant=destructive]:focus:text-destructive " +
              "dark:data-[variant=destructive]:focus:bg-destructive/20 data-disabled:pointer-events-none data-disabled:opacity-50 " +
              "[&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4 data-[variant=destructive]:*:[svg]:text-destructive",
              Class)">
    @ChildContent
</MenuItem>

@code {
    /// <summary>Render your own element or component; spread <c>props.Attributes</c> onto it.</summary>
    [Parameter] public RenderFragment<MenuItemRenderProps>? Render { get; set; }

    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool CloseOnClick { get; set; } = true;

    /// <summary>Styles the item as destructive.</summary>
    [Parameter] public bool Destructive { get; set; }

    /// <summary>Indent to line up with items that have an icon.</summary>
    [Parameter] public bool Inset { get; set; }

    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
