@namespace Blazix.Registry
@using Blazix.Primitives
@using static Blazix.Registry.ClassNames

<MenuSeparator data-slot="dropdown-menu-separator" @attributes="AdditionalAttributes" Render="@Render"
               class="@Cn("-mx-1 my-1 h-px bg-border", Class)" />

@code {
    /// <summary>Render your own element or component; spread <c>props.Attributes</c> onto it.</summary>
    [Parameter] public RenderFragment<MenuSeparatorRenderProps>? Render { get; set; }

    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
