@namespace Blazix.Registry
@using Blazix.Primitives
@using static Blazix.Registry.ClassNames

@* On close the popup stays mounted with data-closed until animate-out finishes. *@
<MenuPopup data-slot="dropdown-menu-content" @attributes="AdditionalAttributes" Render="@Render"
           Side="@Side"
           Align="@Align"
           SideOffset="@SideOffset"
           AlignOffset="@AlignOffset"
           PositionerAttributes="@Positioner"
           class="@Cn(
               "z-50 max-h-(--available-height) w-(--anchor-width) min-w-32 origin-(--transform-origin) overflow-x-hidden overflow-y-auto " +
               "rounded-lg bg-popover p-1 text-popover-foreground shadow-md ring-1 ring-foreground/10 duration-100 outline-none " +
               "data-[side=bottom]:slide-in-from-top-2 data-[side=inline-end]:slide-in-from-left-2 data-[side=inline-start]:slide-in-from-right-2 " +
               "data-[side=left]:slide-in-from-right-2 data-[side=right]:slide-in-from-left-2 data-[side=top]:slide-in-from-bottom-2 " +
               "data-open:animate-in data-open:fade-in-0 data-open:zoom-in-95 " +
               "data-closed:animate-out data-closed:overflow-hidden data-closed:fade-out-0 data-closed:zoom-out-95",
               Class)">
    @ChildContent
</MenuPopup>

@code {
    private static readonly IReadOnlyDictionary<string, object> Positioner = new Dictionary<string, object> { ["class"] = "isolate z-50 outline-none" };

    /// <summary>Render your own element or component; spread <c>props.Attributes</c> onto it.</summary>
    [Parameter] public RenderFragment<MenuPopupRenderProps>? Render { get; set; }

    /// <summary>Defaults to the primitive's: below the trigger (beside it for a submenu).</summary>
    [Parameter] public Side? Side { get; set; }
    /// <summary>Defaults to the primitive's: start.</summary>
    [Parameter] public Align? Align { get; set; }
    [Parameter] public int SideOffset { get; set; } = 4;
    [Parameter] public int AlignOffset { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
