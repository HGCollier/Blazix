@using static Blazix.Registry.ClassNames

<legend data-slot="field-legend" data-variant="@(Variant == FieldLegendVariant.Label ? "label" : "legend")" @attributes="AdditionalAttributes"
        class="@Cn("mb-1.5 font-medium data-[variant=label]:text-sm data-[variant=legend]:text-base", Class)">
    @ChildContent
</legend>

@code {
    [Parameter] public FieldLegendVariant Variant { get; set; } = FieldLegendVariant.Legend;

    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
