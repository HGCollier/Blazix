@using Blazix.Primitives
@using static Blazix.Registry.ClassNames

<DropdownMenuContent data-slot="menubar-content" @attributes="AdditionalAttributes" Align="@Align" AlignOffset="@AlignOffset" SideOffset="@SideOffset"
                     Class="@Cn(
                         "min-w-36 rounded-lg bg-popover p-1 text-popover-foreground shadow-md ring-1 ring-foreground/10 duration-100 " +
                         "data-[side=bottom]:slide-in-from-top-2 data-[side=inline-end]:slide-in-from-left-2 " +
                         "data-[side=inline-start]:slide-in-from-right-2 data-[side=left]:slide-in-from-right-2 " +
                         "data-[side=right]:slide-in-from-left-2 data-[side=top]:slide-in-from-bottom-2 data-open:animate-in data-open:fade-in-0 " +
                         "data-open:zoom-in-95",
                         Class)">
    @ChildContent
</DropdownMenuContent>

@code {
    [Parameter] public Align Align { get; set; } = Align.Start;
    [Parameter] public int AlignOffset { get; set; } = -4;
    [Parameter] public int SideOffset { get; set; } = 8;
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
