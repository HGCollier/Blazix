@namespace Blazix.Registry
@using Blazix.Primitives
@using static Blazix.Registry.ClassNames

<ToggleGroupRoot data-slot="toggle-group" @attributes="AdditionalAttributes" Render="@Render"
                 Value="@Value" ValueChanged="@ValueChanged" OnValueChange="@OnValueChange"
                 Multiple="@Multiple" Disabled="@Disabled" Orientation="@Orientation" LoopFocus="@LoopFocus"
                 data-variant="@(Variant is { } variant ? ToggleVariants.Name(variant) : null)"
                 data-size="@(Size is { } size ? ToggleVariants.Name(size) : null)"
                 data-spacing="@Spacing"
                 style="@($"--gap: {Spacing}")"
                 class="@Cn(
                     "group/toggle-group flex w-fit flex-row items-center gap-[--spacing(var(--gap))] rounded-lg " +
                     "data-[size=sm]:rounded-[min(var(--radius-md),10px)] data-vertical:flex-col data-vertical:items-stretch",
                     Class)">
    <CascadingValue Value="@(new Style(Variant, Size, Spacing))">
        @ChildContent
    </CascadingValue>
</ToggleGroupRoot>

@code {
    /// <summary>Render your own element or component; spread <c>props.Attributes</c> onto it.</summary>
    [Parameter] public RenderFragment<ToggleGroupRenderProps>? Render { get; set; }

    /// <summary>The pressed items' values. Supports <c>@bind-Value</c>; set it once for an uncontrolled group.</summary>
    [Parameter] public IReadOnlyList<string>? Value { get; set; }

    [Parameter] public EventCallback<IReadOnlyList<string>?> ValueChanged { get; set; }

    /// <summary>Runs before the value changes; call <c>Cancel()</c> to keep it.</summary>
    [Parameter] public EventCallback<ValueChangeEventArgs<IReadOnlyList<string>>> OnValueChange { get; set; }

    /// <summary>Whether several items can be pressed at once.</summary>
    [Parameter] public bool Multiple { get; set; }

    [Parameter] public bool Disabled { get; set; }
    [Parameter] public Orientation Orientation { get; set; } = Orientation.Horizontal;
    [Parameter] public bool LoopFocus { get; set; } = true;

    /// <summary>The items' variant; when unset each item uses its own.</summary>
    [Parameter] public ToggleVariant? Variant { get; set; }

    /// <summary>The items' size; when unset each item uses its own.</summary>
    [Parameter] public ToggleSize? Size { get; set; }

    /// <summary>The gap between items, in spacing units. 0 joins them into one segmented control.</summary>
    [Parameter] public int Spacing { get; set; } = 2;

    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>What the group tells its items.</summary>
    public sealed record Style(ToggleVariant? Variant, ToggleSize? Size, int Spacing);
}
