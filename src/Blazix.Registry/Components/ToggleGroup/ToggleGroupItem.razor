@namespace Blazix.Registry
@using Blazix.Primitives
@using static Blazix.Registry.ClassNames

<ToggleRoot data-slot="toggle-group-item" @attributes="AdditionalAttributes" Render="@Render" NativeButton="@NativeButton"
            Value="@Value" Disabled="@Disabled"
            data-variant="@ToggleVariants.Name(EffectiveVariant)"
            data-size="@ToggleVariants.Name(EffectiveSize)"
            data-spacing="@Group?.Spacing"
            class="@Cn(
                "shrink-0 group-data-[spacing=0]/toggle-group:rounded-none group-data-[spacing=0]/toggle-group:px-2 focus:z-10 focus-visible:z-10 " +
                "group-data-[spacing=0]/toggle-group:has-data-[icon=inline-end]:pr-1.5 group-data-[spacing=0]/toggle-group:has-data-[icon=inline-start]:pl-1.5 " +
                "group-data-horizontal/toggle-group:data-[spacing=0]:first:rounded-l-lg group-data-vertical/toggle-group:data-[spacing=0]:first:rounded-t-lg " +
                "group-data-horizontal/toggle-group:data-[spacing=0]:last:rounded-r-lg group-data-vertical/toggle-group:data-[spacing=0]:last:rounded-b-lg " +
                "group-data-horizontal/toggle-group:data-[spacing=0]:data-[variant=outline]:border-l-0 group-data-vertical/toggle-group:data-[spacing=0]:data-[variant=outline]:border-t-0 " +
                "group-data-horizontal/toggle-group:data-[spacing=0]:data-[variant=outline]:first:border-l group-data-vertical/toggle-group:data-[spacing=0]:data-[variant=outline]:first:border-t",
                ToggleVariants.Get(EffectiveVariant, EffectiveSize),
                Class)">
    @ChildContent
</ToggleRoot>

@code {
    [CascadingParameter] private ToggleGroup.Style? Group { get; set; }

    /// <summary>Render your own element or component; spread <c>props.Attributes</c> onto it.</summary>
    [Parameter] public RenderFragment<ToggleRenderProps>? Render { get; set; }

    /// <summary>Leave unset: whether Render produced a real &lt;button&gt; is detected. Set it to skip the check.</summary>
    [Parameter] public bool? NativeButton { get; set; }

    /// <summary>Identifies the item in the group's value.</summary>
    [Parameter, EditorRequired] public string Value { get; set; } = "";

    [Parameter] public bool Disabled { get; set; }
    [Parameter] public ToggleVariant Variant { get; set; } = ToggleVariant.Default;
    [Parameter] public ToggleSize Size { get; set; } = ToggleSize.Default;
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private ToggleVariant EffectiveVariant => Group?.Variant ?? Variant;

    private ToggleSize EffectiveSize => Group?.Size ?? Size;
}
