@namespace Blazix.Registry
@using Blazix.Primitives
@using static Blazix.Registry.ClassNames

<Blazix.Primitives.SelectItem data-slot="select-item" @attributes="AdditionalAttributes" Render="@Render" Value="@Value" Label="@Label" Disabled="@Disabled"
                            class="@Cn(
                                "relative flex w-full cursor-default items-center gap-1.5 rounded-md py-1 pr-8 pl-1.5 text-sm outline-hidden select-none " +
                                "focus:bg-accent focus-visible:ring-1 focus-visible:ring-inset focus-visible:ring-ring/50 focus:text-accent-foreground not-data-[variant=destructive]:focus:**:text-accent-foreground " +
                                "data-disabled:pointer-events-none data-disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 " +
                                "[&_svg:not([class*='size-'])]:size-4 *:[span]:last:flex *:[span]:last:items-center *:[span]:last:gap-2",
                                Class)">
    <SelectItemText class="flex flex-1 shrink-0 gap-2 whitespace-nowrap">@ChildContent</SelectItemText>
    <SelectItemIndicator class="pointer-events-none absolute right-2 flex size-4 items-center justify-center">
        <Render>
            <span @attributes="context.Attributes">
                <IconPlaceholder Lucide="check" Tabler="check" Hugeicons="tick-02" Phosphor="check" Remixicon="check-line" FontAwesome="check"
                                 aria-hidden="true" class="pointer-events-none" />
            </span>
        </Render>
    </SelectItemIndicator>
</Blazix.Primitives.SelectItem>

@code {
    /// <summary>Render your own element or component; spread <c>props.Attributes</c> onto it.</summary>
    [Parameter] public RenderFragment<SelectItemRenderProps>? Render { get; set; }

    [Parameter, EditorRequired] public string Value { get; set; } = "";

    /// <summary>The text the trigger shows when this option is selected. Defaults to the select's Items, else the value.</summary>
    [Parameter] public string? Label { get; set; }

    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
