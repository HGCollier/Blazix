@namespace Blazix.Registry
@using Blazix.Primitives
@using static Blazix.Registry.ClassNames

<Blazix.Primitives.SelectTrigger data-slot="select-trigger" data-size="@(Size == SelectTriggerSize.Sm ? "sm" : "default")" @attributes="FieldDescriptions.Merge(Descriptions, AdditionalAttributes)"
                               Render="@Render" NativeButton="@NativeButton"
                               class="@Cn(
                                   "flex w-fit items-center justify-between gap-1.5 rounded-lg border border-input bg-transparent py-2 pr-2 pl-2.5 text-sm " +
                                   "whitespace-nowrap transition-colors outline-none select-none focus-visible:border-ring focus-visible:ring-3 " +
                                   "focus-visible:ring-ring/50 disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:border-destructive " +
                                   "aria-invalid:ring-3 aria-invalid:ring-destructive/20 data-placeholder:text-muted-foreground data-[size=default]:h-8 " +
                                   "data-[size=sm]:h-7 data-[size=sm]:rounded-[min(var(--radius-md),10px)] *:data-[slot=select-value]:line-clamp-1 " +
                                   "*:data-[slot=select-value]:flex *:data-[slot=select-value]:items-center *:data-[slot=select-value]:gap-1.5 " +
                                   "dark:bg-input/15 dark:hover:bg-input/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 aria-invalid:focus-visible:ring-destructive/60 dark:aria-invalid:focus-visible:ring-destructive/60 " +
                                   "[&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4",
                                   Class)">
    @ChildContent
    <SelectIcon class="pointer-events-none size-4 text-muted-foreground">
        <Render>
            <svg @attributes="context.Attributes" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m6 9 6 6 6-6" />
            </svg>
        </Render>
    </SelectIcon>
</Blazix.Primitives.SelectTrigger>

@code {
    /// <summary>Render your own element or component; spread <c>props.Attributes</c> onto it.</summary>
    [Parameter] public RenderFragment<PopupTriggerRenderProps>? Render { get; set; }

    /// <summary>Leave unset: whether Render produced a real &lt;button&gt; is detected. Set it to skip the check.</summary>
    [Parameter] public bool? NativeButton { get; set; }

    [Parameter] public SelectTriggerSize Size { get; set; } = SelectTriggerSize.Default;
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    [CascadingParameter] private FieldDescriptions? Descriptions { get; set; }
}
