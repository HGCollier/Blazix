@using Blazix.Primitives

<div data-slot="button-group" role="group" data-orientation="@OrientationName" @attributes="AdditionalAttributes"
     class="@ButtonGroupVariants.Get(Orientation ?? Blazix.Primitives.Orientation.Horizontal, Class)">
    @ChildContent
</div>

@code {
    /// <summary>Lays the buttons out in a row (default) or a column.</summary>
    [Parameter] public Orientation? Orientation { get; set; }

    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string? OrientationName => Orientation switch
    {
        Blazix.Primitives.Orientation.Vertical => "vertical",
        Blazix.Primitives.Orientation.Horizontal => "horizontal",
        _ => null,
    };
}
