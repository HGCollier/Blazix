@namespace Blazix.Registry
@using Blazix.Primitives
@using static Blazix.Registry.ClassNames

<MenubarRoot data-slot="menubar" @attributes="AdditionalAttributes" Render="@Render"
             Disabled="@Disabled" LoopFocus="@LoopFocus" Modal="@Modal" Orientation="@Orientation"
             class="@Cn("flex h-8 items-center gap-0.5 rounded-lg border p-[3px]", Class)">
    @ChildContent
</MenubarRoot>

@code {
    /// <summary>Render your own element or component; spread <c>props.Attributes</c> onto it.</summary>
    [Parameter] public RenderFragment<MenubarRenderProps>? Render { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Whether the arrow keys wrap from the last menu to the first. Defaults to true.</summary>
    [Parameter] public bool LoopFocus { get; set; } = true;

    /// <summary>Whether an open menu makes the page inert. Defaults to true.</summary>
    [Parameter] public bool Modal { get; set; } = true;

    [Parameter] public Orientation Orientation { get; set; } = Orientation.Horizontal;
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
