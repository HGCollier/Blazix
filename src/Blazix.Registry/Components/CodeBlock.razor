@using static Blazix.Registry.ClassNames

<div data-slot="code-block" data-variant="@(Variant == CodeBlockVariant.Destructive ? "destructive" : "default")" data-size="@(Size == CodeBlockSize.Sm ? "sm" : "default")" @attributes="AdditionalAttributes"
     class="@Cn(
         "group/code-block relative flex w-full min-w-0 flex-col overflow-hidden rounded-lg text-sm " +
         "has-[>[data-slot=code-block-content]:focus-visible]:ring-3 " +
         "has-[>[data-slot=code-block-content]:focus-visible]:ring-ring/50 data-[size=sm]:text-xs",
         Variant == CodeBlockVariant.Destructive
             ? "border border-destructive/30 text-destructive dark:border-destructive/40"
             : "border border-input text-foreground has-[>[data-slot=code-block-content]:focus-visible]:border-ring dark:bg-input/15",
         Class)">
    @ChildContent
</div>

@code {
    [Parameter] public CodeBlockVariant Variant { get; set; } = CodeBlockVariant.Default;
    [Parameter] public CodeBlockSize Size { get; set; } = CodeBlockSize.Default;

    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
