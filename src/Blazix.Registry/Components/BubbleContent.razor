@using Blazix.Primitives
@using static Blazix.Registry.ClassNames

<UseRender DefaultTagName="div" Render="@Render" data-slot="bubble-content" @attributes="AdditionalAttributes"
           class="@Cn(
               "w-fit max-w-full min-w-0 overflow-hidden rounded-xl border border-transparent px-3 py-2 text-sm leading-relaxed " +
               "wrap-break-word group-data-[align=end]/bubble:self-end [button]:text-left [button,a]:transition-colors " +
               "[button,a]:outline-none [button,a]:focus-visible:border-ring [button,a]:focus-visible:ring-3 " +
               "[button,a]:focus-visible:ring-ring/50",
               Class)">
    @ChildContent
</UseRender>

@code {
    /// <summary>Render your own element or component; spread <c>props.Attributes</c> onto it.</summary>
    [Parameter] public RenderFragment<UseRenderProps>? Render { get; set; }

    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
