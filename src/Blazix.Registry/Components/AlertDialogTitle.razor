@using Blazix.Primitives
@using static Blazix.Registry.ClassNames

<Blazix.Primitives.AlertDialogTitle data-slot="alert-dialog-title" @attributes="AdditionalAttributes" Render="@Render"
                                  class="@Cn("text-base font-medium sm:group-data-[size=default]/alert-dialog-content:group-has-data-[slot=alert-dialog-media]/alert-dialog-content:col-start-2", Class)">
    @ChildContent
</Blazix.Primitives.AlertDialogTitle>

@code {
    /// <summary>Render your own element or component; spread <c>props.Attributes</c> onto it.</summary>
    [Parameter] public RenderFragment<PopupRenderProps>? Render { get; set; }

    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
