@namespace Blazix.Registry
@using static Blazix.Registry.ClassNames

<span aria-hidden="true" data-slot="pagination-ellipsis" @attributes="AdditionalAttributes"
      class="@Cn("flex size-8 items-center justify-center [&_svg:not([class*='size-'])]:size-4", Class)">
    <IconPlaceholder Lucide="ellipsis" Tabler="dots" Hugeicons="more-horizontal-circle-01" Phosphor="dots-three" Remixicon="more-line" FontAwesome="ellipsis"
                     aria-hidden="true" />
    <span class="sr-only">More pages</span>
</span>

@code {
    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
