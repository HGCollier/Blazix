@namespace Blazix.Registry
@using static Blazix.Registry.ClassNames

<PaginationLink aria-label="Go to previous page" Size="ButtonSize.Default" Class="@Cn("pl-1.5!", Class)" IsActive="@IsActive" @attributes="AdditionalAttributes">
    <IconPlaceholder Lucide="chevron-left" Tabler="chevron-left" Hugeicons="arrow-left-01" Phosphor="caret-left" Remixicon="arrow-left-s-line" FontAwesome="chevron-left"
                     aria-hidden="true" class="cn-rtl-flip" data-icon="inline-start" />
    <span class="hidden sm:block">@Text</span>
</PaginationLink>

@code {
    [Parameter] public string Text { get; set; } = "Previous";
    [Parameter] public bool IsActive { get; set; }
    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
