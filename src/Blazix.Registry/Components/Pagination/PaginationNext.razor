@namespace Blazix.Registry
@using static Blazix.Registry.ClassNames

<PaginationLink aria-label="Go to next page" Size="ButtonSize.Default" Class="@Cn("pr-1.5!", Class)" IsActive="@IsActive" @attributes="AdditionalAttributes">
    <span class="hidden sm:block">@Text</span>
    <IconPlaceholder Lucide="chevron-right" Tabler="chevron-right" Hugeicons="arrow-right-01" Phosphor="caret-right" Remixicon="arrow-right-s-line" FontAwesome="chevron-right"
                     aria-hidden="true" class="cn-rtl-flip" data-icon="inline-end" />
</PaginationLink>

@code {
    [Parameter] public string Text { get; set; } = "Next";
    [Parameter] public bool IsActive { get; set; }
    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
