@using Blazix.Primitives

<CollapsibleRoot data-slot="collapsible" @attributes="AdditionalAttributes" Render="@Render"
                 Open="@Open" OpenChanged="@OpenChanged" OnOpenChange="@OnOpenChange" Disabled="@Disabled" class="@Class">
    @ChildContent
</CollapsibleRoot>

@code {
    /// <summary>Render your own element or component; spread <c>props.Attributes</c> onto it.</summary>
    [Parameter] public RenderFragment<CollapsibleRenderProps>? Render { get; set; }

    /// <summary>Supports <c>@bind-Open</c>; leave unset to let it manage itself.</summary>
    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>Runs before it opens or closes; call <c>Cancel()</c> to keep it as it is.</summary>
    [Parameter] public EventCallback<OpenChangeEventArgs> OnOpenChange { get; set; }

    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
