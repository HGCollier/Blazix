@namespace Blazix.Registry
@using Blazix.Primitives
@using static Blazix.Registry.ClassNames

<Button data-slot="attachment-action" Type="@Type" Variant="@Variant" Size="@Size" @attributes="AdditionalAttributes" Class="@Cn(Class)">
    @ChildContent
</Button>

@code {
    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Ghost;
    [Parameter] public ButtonSize Size { get; set; } = ButtonSize.IconXs;
    [Parameter] public ButtonType Type { get; set; } = ButtonType.button;
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
