@using static Blazix.Registry.ClassNames

@* The input's script sets data-active and shows the fake caret. *@
<div data-slot="input-otp-slot" data-index="@Index" @attributes="AdditionalAttributes"
     class="@Cn(
         "relative flex size-8 items-center justify-center border-y border-r border-input text-sm transition-all outline-none " +
         "first:rounded-l-lg first:border-l last:rounded-r-lg aria-invalid:border-destructive data-[active=true]:z-10 " +
         "data-[active=true]:border-ring data-[active=true]:ring-3 data-[active=true]:ring-ring/50 " +
         "data-[active=true]:aria-invalid:border-destructive data-[active=true]:aria-invalid:ring-destructive/60 " +
         "dark:bg-input/15 dark:data-[active=true]:aria-invalid:ring-destructive/60",
         Class)">
    @(Value is { } value && Index < value.Length ? value[Index].ToString() : null)
    <div data-input-otp-caret hidden class="pointer-events-none absolute inset-0 flex items-center justify-center">
        <div class="h-4 w-px animate-caret-blink bg-foreground duration-1000"></div>
    </div>
</div>

@code {
    [CascadingParameter(Name = "InputOtpValue")] private string? Value { get; set; }

    /// <summary>Which character of the code this slot shows, from 0.</summary>
    [Parameter, EditorRequired] public int Index { get; set; }

    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
