@using static Blazix.Registry.ClassNames

<Blazix.Primitives.QuestionnairePrevious data-slot="questionnaire-previous" data-size="@QuestionnaireButtons.Name(Size)" data-variant="@QuestionnaireButtons.Name(Variant)"
                                 @attributes="AdditionalAttributes" Render="@Render" Disabled="@Disabled"
                                 class="@ButtonVariants.Get(Variant, Size, Cn("col-start-1 row-start-1 min-h-11 justify-self-start sm:min-h-0", Class))" ChildContent="@ChildContent" />

@code {
    /// <summary>Render your own element or component; spread <c>props.Attributes</c> onto it.</summary>
    [Parameter] public RenderFragment<QuestionnaireNavigationRenderProps>? Render { get; set; }

    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Outline;
    [Parameter] public ButtonSize Size { get; set; } = ButtonSize.Default;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
