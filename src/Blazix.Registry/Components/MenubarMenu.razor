<DropdownMenu Open="@Open" OpenChanged="@OpenChanged" OnOpenChange="@OnOpenChange" Disabled="@Disabled">
    @ChildContent
</DropdownMenu>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Supports <c>@bind-Open</c>; leave unset to let the menubar manage it.</summary>
    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public EventCallback<OpenChangeEventArgs> OnOpenChange { get; set; }
    [Parameter] public bool Disabled { get; set; }
}
