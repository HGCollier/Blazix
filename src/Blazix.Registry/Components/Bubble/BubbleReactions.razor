@namespace Blazix.Registry
@using static Blazix.Registry.ClassNames

<div data-slot="bubble-reactions" data-align="@(Align == BubbleAlign.Start ? "start" : "end")" data-side="@(Side == BubbleReactionsSide.Top ? "top" : "bottom")" @attributes="AdditionalAttributes"
     class="@Cn(
         "absolute z-10 flex w-fit shrink-0 items-center justify-center gap-1 rounded-full bg-muted px-1.5 py-0.5 text-sm ring-3 ring-card has-[button]:p-0",
         Side == BubbleReactionsSide.Top ? "top-0 -translate-y-3/4" : "bottom-0 translate-y-3/4",
         Align == BubbleAlign.Start ? "left-3" : "right-3",
         Class)">
    @ChildContent
</div>

@code {
    [Parameter] public BubbleAlign Align { get; set; } = BubbleAlign.End;
    [Parameter] public BubbleReactionsSide Side { get; set; } = BubbleReactionsSide.Bottom;

    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
