@namespace Blazix.Registry
@using static Blazix.Registry.ClassNames

<div data-slot="input-group-addon" role="group" data-align="@AlignName"
     onclick="if (!event.target.closest('button')) this.parentElement?.querySelector('input')?.focus()" @attributes="AdditionalAttributes"
     class="@Cn(
         "flex h-auto cursor-text items-center justify-center gap-2 py-1.5 text-sm font-medium text-muted-foreground select-none " +
         "group-data-disabled/input-group:opacity-50 [&>kbd]:rounded-[calc(var(--radius)-5px)] " +
         "[&>svg:not([class*='size-'])]:size-4",
         Align switch
         {
             InputGroupAddonAlign.InlineEnd => "order-last pe-2 has-[>button]:me-[-0.3rem] has-[>kbd]:me-[-0.15rem]",
             InputGroupAddonAlign.BlockStart =>
                 "order-first w-full justify-start px-2.5 pt-2 group-has-[>input]/input-group:pt-2 [.border-b]:pb-2",
             InputGroupAddonAlign.BlockEnd =>
                 "order-last w-full justify-start px-2.5 pb-2 group-has-[>input]/input-group:pb-2 [.border-t]:pt-2",
             _ => "order-first ps-2 has-[>button]:ms-[-0.3rem] has-[>kbd]:ms-[-0.15rem]",
         },
         Class)">
    @ChildContent
</div>

@code {
    [Parameter] public InputGroupAddonAlign Align { get; set; } = InputGroupAddonAlign.InlineStart;

    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string AlignName => Align switch
    {
        InputGroupAddonAlign.InlineEnd => "inline-end",
        InputGroupAddonAlign.BlockStart => "block-start",
        InputGroupAddonAlign.BlockEnd => "block-end",
        _ => "inline-start",
    };
}
